---
import LandingLayout from './LandingLayout.astro';
import { createBlogPostingSchema, type JsonLd } from '../data/productFacts';
import { lastModifiedForRoute } from '../utils/page-dates.mjs';

interface Props {
  title: string;
  description: string;
  structuredData?: JsonLd[];
  contents?: { id: string; label: string }[];
  index?: boolean;
  /**
   * Set on every post (not the index): publishes the BlogPosting JSON-LD and the Open Graph
   * article times. The headline defaults to the title; the update date comes from the shared
   * page-dates helper, the same date the sitemap lists.
   */
  article?: { publishedAt: string; headline?: string };
}
const { contents = [], index = false, article, structuredData = [], ...layoutProps } = Astro.props;
const lastModified = article ? lastModifiedForRoute(Astro.url.pathname) : undefined;
const modifiedAt = article && lastModified && lastModified > article.publishedAt ? lastModified : article?.publishedAt;
const articleProps = article
  ? {
      ogType: 'article' as const,
      publishedTime: article.publishedAt,
      modifiedTime: modifiedAt,
      structuredData: [
        ...structuredData,
        createBlogPostingSchema({
          url: new URL(Astro.url.pathname, Astro.site).toString(),
          headline: article.headline ?? layoutProps.title,
          description: layoutProps.description,
          datePublished: article.publishedAt,
          dateModified: modifiedAt ?? article.publishedAt,
        }),
      ],
    }
  : { structuredData };
---

<LandingLayout {...layoutProps} {...articleProps}>
  <div class:list={['blog-page', 'container', index && 'blog-page--index']}>
    <div class="blog-hero"><slot name="hero" /></div>
    <div class="blog-body">
      {contents.length > 3 && (
        <aside class="blog-contents">
          <details>
            <summary>In this article</summary>
            <nav aria-label="Table of contents">
              <ol>{contents.map((item) => <li><a href={`#${item.id}`}>{item.label}</a></li>)}</ol>
            </nav>
          </details>
        </aside>
      )}
      <div class="blog-prose"><slot /></div>
    </div>
  </div>
</LandingLayout>

<style is:global>
  .blog-page { padding-bottom: 3rem; }
  .blog-page .container { width: 100%; margin-inline: 0; }
  .blog-hero, .blog-body { font-size: var(--fs-body); }
  .blog-hero .container, .blog-prose { max-width: 70ch; }
  .blog-page .site-section { padding-block: 1.5rem; }
  .blog-page .site-section--hero { padding-block: 3.5rem 2rem; }
  .blog-page h1 { max-width: 24ch; font-size: var(--fs-headline); line-height: 1.05; letter-spacing: -0.045em; text-wrap: balance; }
  .blog-page h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); line-height: 1.2; text-wrap: balance; }
  .blog-page h3 { font-size: var(--fs-title); line-height: 1.3; }
  .blog-page :is(h2, h3, [id]) { scroll-margin-top: 6.5rem; }
  .blog-prose :is(p, li) { line-height: 1.65; }
  .blog-page .blog-meta { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; margin-top: 1.25rem; font-size: var(--fs-small); line-height: 1.5; color: var(--text-2); }
  .blog-page .blog-deck { margin-top: 1.5rem; font-size: var(--fs-lead); line-height: 1.65; color: var(--text-2); }
  .blog-page .blog-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 1.75rem; }
  .blog-page .blog-actions > a:not(.site-button) { font-size: var(--fs-small); text-decoration: underline; text-underline-offset: 0.2em; }
  .blog-body { display: flex; flex-direction: column; gap: 1rem; }
  .blog-prose { min-width: 0; }
  .blog-prose a { overflow-wrap: anywhere; }
  .blog-contents { font-size: var(--fs-small); color: var(--text-2); }
  .blog-contents details { padding-block: 0.875rem; border-block: 1px solid var(--line); }
  .blog-contents summary { cursor: pointer; font-weight: 600; color: var(--text); }
  .blog-contents ol { display: grid; gap: 0.75rem; margin: 1rem 0 0; padding: 0; list-style: none; }
  .blog-contents a { display: block; line-height: 1.5; color: var(--text-2); transition: color 150ms var(--ease); }
  .blog-contents a:hover { color: var(--text); }
  .blog-page pre { max-width: 100%; overflow-x: auto; white-space: pre; font-size: var(--fs-small); line-height: 1.7; }
  .blog-page pre code { display: block; padding: 0; font-size: inherit; line-height: inherit; white-space: inherit; }
  .blog-page pre.blog-prompt { white-space: pre-wrap; overflow-wrap: anywhere; }
  .blog-page :is(.site-panel, article[data-analytics-label]):has(> pre) { min-width: 0; padding: 0; overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius-control); background: var(--surface); box-shadow: none; }
  .blog-page :is(.site-panel, article[data-analytics-label]):has(> pre) > :not(pre) { margin: 0; padding: 1rem; }
  .blog-page :is(.site-panel, article[data-analytics-label]):has(> pre) > pre { margin: 0; padding: 1rem; border: 0; border-radius: 0; background: var(--surface-2); }
  .blog-page .blog-sections { display: grid; grid-template-columns: 1fr; gap: 2.5rem; }
  .blog-page .blog-snippets { grid-template-columns: 1fr; }
  .blog-page .blog-sections > .site-panel { padding: 0; border: 0; background: transparent; box-shadow: none; }
  .blog-page .blog-prompt-list { display: grid; gap: 1rem; }
  .blog-page .reveal, .reveal-ready .blog-page .reveal { opacity: 1; transform: none; transition: none; }
  .blog-page--index .blog-prose, .blog-page--index .blog-hero .container { max-width: none; }
  .blog-page--index .blog-deck { max-width: 58ch; }
  .blog-posts { display: grid; gap: 1.25rem; margin-top: 1.5rem; }
  .blog-card { display: block; height: 100%; padding: 1.5rem; border: 1px solid var(--border); border-radius: var(--radius-panel); background: var(--surface); transition: border-color 150ms var(--ease), box-shadow 150ms var(--ease); }
  .blog-card:hover { border-color: var(--border-hover); box-shadow: var(--shadow-md); }
  .blog-card h3 { margin-top: 0.75rem; color: var(--text); }
  .blog-card p { margin-top: 0.75rem; font-size: var(--fs-small); color: var(--text-2); }
  .blog-card .blog-meta { margin-top: 1.5rem; }
  .blog-feature { padding: 2rem; margin-block: 0.5rem 2.5rem; border-radius: var(--radius-feature); }
  .blog-feature h2 { max-width: 28ch; margin-top: 0.75rem; }
  .blog-feature p { max-width: 62ch; }
  .blog-feature .blog-read { display: inline-block; margin-top: 1.5rem; font-size: var(--fs-small); font-weight: 600; color: var(--accent); }
  @media (min-width: 40rem) { .blog-posts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 68.75rem) {
    .blog-body:has(.blog-contents) { display: grid; grid-template-columns: minmax(0, 70ch) minmax(11rem, 16rem); justify-content: space-between; gap: 3rem; align-items: start; }
    .blog-contents { grid-column: 2; grid-row: 1; position: sticky; top: 6.5rem; max-height: calc(100vh - 8rem); overflow-y: auto; }
    .blog-prose { grid-column: 1; grid-row: 1; }
    .blog-contents details { border: 0; padding-top: 1.5rem; }
  }
  @media (prefers-reduced-motion: reduce) { .blog-page a { transition: none; } }
</style>

<script>
  const wideScreen = window.matchMedia('(min-width: 1100px)');
  const updateContents = () => {
    document.querySelectorAll<HTMLDetailsElement>('.blog-contents details').forEach(contents => { contents.open = wideScreen.matches; });
  };
  updateContents();
  document.addEventListener('astro:page-load', updateContents);
  wideScreen.addEventListener('change', updateContents);
</script>
