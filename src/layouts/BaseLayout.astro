---
import robotoFont from '@fontsource-variable/roboto/files/roboto-latin-wght-normal.woff2?url';
import '../styles/global.css';
import SearchModal from '../components/SearchModal.astro';
import { organizationSchema, type JsonLd } from '../data/productFacts';
import { markdownTwinPath } from '../utils/markdown-twins.mjs';

interface Props {
  title: string;
  description?: string;
  /** A raster (PNG or JPEG) share image; the default is the 1200x630 brand card. */
  ogImage?: string;
  ogImageAlt?: string;
  /** "article" adds article:published_time and article:modified_time (blog posts). */
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  structuredData?: JsonLd[];
}

// Social networks and chat apps do not render SVG share images.
const defaultSocialCard = {
  path: '/brand/localcloud-social-card.png',
  width: 1200,
  height: 630,
  alt: 'LocalCloud: run major Google Cloud services locally in one Docker container for development, CI and AI agents.',
};

const rawBase = import.meta.env.BASE_URL;
const posthogApiHost = import.meta.env.PUBLIC_POSTHOG_HOST;
const cloudflareAnalyticsToken = import.meta.env.PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN;
const cloudflareAnalyticsEndpoint = import.meta.env.PUBLIC_CLOUDFLARE_ANALYTICS_ENDPOINT;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const {
  title,
  description = 'Run Google Cloud service workflows locally in one Docker container. Before use, review compatibility, privacy, and the proprietary license.',
  ogImage,
  ogImageAlt,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
  structuredData = [],
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage ?? defaultSocialCard.path, Astro.site);
const ogImageAltText = ogImageAlt ?? (ogImage ? title : defaultSocialCard.alt);
// Docs and service pages also publish a Markdown twin (scripts/generate-markdown-twins.mjs).
const markdownTwin = markdownTwinPath(Astro.url.pathname);
// JSON-LD is raw script text: escape "<" so a "</script>" or "<!--" in copy cannot end the block.
const serializeJsonLd = (schema: JsonLd) => JSON.stringify(schema).replace(/</g, '\\u003c');
// Pagefind indexes only pages marked with data-pagefind-body, so the 404 page and
// noindex pages stay out of site search.
const pagefindBody = noindex ? undefined : '';
// Chrome prefetches same-origin pages a visitor is likely to open (hover or pointerdown, the
// "moderate" eagerness). Prefetch only fetches the HTML; it never prerenders, so no page
// script or analytics runs early. The analytics proxy, the installer and raw agent documents
// are never prefetched. finalize-static-csp hashes this block into script-src.
const speculationRules = {
  prefetch: [{
    where: {
      and: [
        { href_matches: '/*' },
        { not: { href_matches: ['/ingest*', '/install.sh', '/*.md', '/*.txt', '/license.txt'] } },
      ],
    },
    eagerness: 'moderate',
  }],
};
// Preserve inline presentation styles using the per-page CSP API.
Astro.csp?.insertDirective("style-src-attr 'unsafe-inline'");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {/* A noindex page (such as the 404 page served at every missing URL) must not claim a canonical URL. */}
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    <link rel="icon" href={`${base}favicon.png`} type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} sizes="180x180" />
    <link rel="alternate" type="text/plain" href={`${base}llms.txt`} title="LocalCloud llms.txt" />
    {markdownTwin && <link rel="alternate" type="text/markdown" href={markdownTwin} title="Markdown version" />}
    <meta name="theme-color" content="#ffffff" />
    <meta name="author" content="LocalCloud Inc." />

    {/* Open Graph */}
    <meta property="og:site_name" content="LocalCloud" />
    <meta property="og:type" content={ogType} />
    {!noindex && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    {!ogImage && <meta property="og:image:width" content={String(defaultSocialCard.width)} />}
    {!ogImage && <meta property="og:image:height" content={String(defaultSocialCard.height)} />}
    <meta property="og:image:alt" content={ogImageAltText} />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && (modifiedTime ?? publishedTime) && <meta property="article:modified_time" content={modifiedTime ?? publishedTime} />}

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImageAltText} />

    {/* One local variable body font covers all headline/body weights. */}
    <link rel="preload" href={robotoFont} as="font" type="font/woff2" crossorigin />

    <title>{title}</title>

    {/* Shared organization identity plus page-specific structured data. */}
    <script type="application/ld+json" set:html={serializeJsonLd(organizationSchema)} />
    {structuredData.map((schema) => (
      <script type="application/ld+json" set:html={serializeJsonLd(schema)} />
    ))}
    <slot name="head" />

    {/* Analytics queues events at once, then loads PostHog and the Cloudflare beacon after the
        load event, a 1.5-second delay and an idle callback. Neither loads when the visitor turned
        analytics off with the footer control or the browser sends Global Privacy Control or Do
        Not Track. The hashed bootstrap authorizes both scripts under strict-dynamic. */}
    <script is:inline define:vars={{ posthogApiHost, cloudflareAnalyticsToken, cloudflareAnalyticsEndpoint }}>
      var privacySignal = navigator.globalPrivacyControl === true ? 'Global Privacy Control'
        : /^(?:1|yes)$/.test(String(navigator.doNotTrack || window.doNotTrack || '')) ? 'Do Not Track' : '';
      var choiceKey = 'lc-analytics';
      var analyticsOn = !privacySignal;
      try { if (localStorage.getItem(choiceKey) === 'off') analyticsOn = false; } catch (e) {}

      !function(t,e){var o,n;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group identify setPersonProperties setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags resetGroups onFeatureFlags addFeatureFlagsHandler onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);

      posthog.init('phc_o9nQDAQjEgsPcamE8pCnhv7ekA8CmA2VQXechLju9LA9', {
        api_host: posthogApiHost,
        ui_host: 'https://us.posthog.com',
        defaults: '2026-01-30', // Pin SDK defaults to prevent upstream behavior changes

        // Page tracking — gives us geo (IP), pages visited, exit pages
        capture_pageview: true,
        capture_pageleave: 'if_capture_pageview',

        // Only the explicit events below and in SearchModal and the feedback components;
        // no automatic click, form or text capture.
        autocapture: false,

        // Error tracking
        capture_exceptions: true,

        // UTM params, referrer persisted across pages
        store_google: true,
        save_referrer: true,

        // Events use PostHog distinct/session identifiers; see /docs/privacy/.
        person_profiles: 'identified_only',

        // Disabled — enable via feature flag when needed
        disable_session_recording: true,
        disable_surveys: true, // Marketing site has no surveys; avoid their extra bundle.
        capture_heatmaps: false,
        capture_dead_clicks: false,
        capture_performance: false,
      });

      var posthogRequested = false;
      var beaconRequested = false;
      function startAnalytics() {
        if (!analyticsOn) return;
        if (!posthogRequested) {
          posthogRequested = true;
          var sdk = document.createElement('script');
          sdk.async = true;
          sdk.src = posthogApiHost.replace('.i.posthog.com', '-assets.i.posthog.com') + '/static/array.js';
          document.head.appendChild(sdk);
        }
        if (!beaconRequested && cloudflareAnalyticsToken) {
          beaconRequested = true;
          var beacon = document.createElement('script');
          beacon.async = true;
          beacon.src = 'https://static.cloudflareinsights.com/beacon.min.js';
          beacon.setAttribute('data-cf-beacon', JSON.stringify({
            token: cloudflareAnalyticsToken,
            send: { to: cloudflareAnalyticsEndpoint },
          }));
          document.head.appendChild(beacon);
        }
      }

      if (analyticsOn) {
        var scheduleAnalytics = function () {
          setTimeout(function () {
            if ('requestIdleCallback' in window) window.requestIdleCallback(startAnalytics, { timeout: 2000 });
            else startAnalytics();
          }, 1500);
        };
        if (document.readyState === 'complete') scheduleAnalytics();
        else window.addEventListener('load', scheduleAnalytics, { once: true });
      } else {
        posthog.opt_out_capturing();
      }

      // The footer analytics control reads and changes the choice here. PostHog also persists
      // its own opt-out once the SDK has loaded.
      window.lcAnalytics = {
        privacySignal: privacySignal,
        isOn: function () { return analyticsOn; },
        setOn: function (on) {
          if (on && privacySignal) return false;
          analyticsOn = on;
          try {
            if (on) localStorage.removeItem(choiceKey);
            else localStorage.setItem(choiceKey, 'off');
          } catch (e) {}
          // Events queued before the SDK loads are never sent across a change of choice.
          var queue = window.posthog;
          if (Array.isArray(queue)) {
            for (var i = queue.length - 1; i >= 0; i--) {
              if (String(queue[i][0]).indexOf('capture') !== -1) queue.splice(i, 1);
            }
          }
          if (on) {
            posthog.opt_in_capturing();
            startAnalytics();
          } else {
            posthog.opt_out_capturing();
          }
          return true;
        },
      };
    </script>
  </head>
  <body data-pagefind-body={pagefindBody}>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <slot />
    <SearchModal />
    <script is:inline type="speculationrules" set:html={JSON.stringify(speculationRules)} />

    <script>
      // Enable reveal animations only when JS and IntersectionObserver are available;
      // without them .reveal content renders visible by default. Content already on screen
      // is marked visible before reveal-ready applies, so it never flashes out and back in.
      if ('IntersectionObserver' in window) {
        const offscreen = [...document.querySelectorAll('.reveal')].filter((el) => {
          const { top, bottom } = el.getBoundingClientRect();
          if (top < window.innerHeight && bottom > 0) {
            el.classList.add('visible');
            return false;
          }
          return true;
        });
        document.documentElement.classList.add('reveal-ready');
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                // Stop observing once visible to prevent re-triggering
                observer.unobserve(entry.target);
              }
            });
          },
          // threshold 0 so elements taller than the viewport (long articles) still reveal
          { threshold: 0, rootMargin: '0px 0px -50px 0px' }
        );
        offscreen.forEach((el) => observer.observe(el));
      }
    </script>

    {/* PostHog custom event tracking */}
    <script is:inline>
      (function() {
        if (typeof window.posthog === 'undefined') return;

        // ─── Code copy: copy buttons dispatch lc:copied only after the clipboard write succeeds ───
        document.addEventListener('lc:copied', function(e) {
          var labelled = e.target.closest && e.target.closest('[data-analytics-label]');
          posthog.capture('code_copied', {
            page_path: window.location.pathname,
            page_title: document.title,
            copy_target: labelled ? labelled.getAttribute('data-analytics-label') : null,
          });
        });

        // ─── Click tracking: labelled calls to action + GitHub clickthrough ───
        document.addEventListener('click', function(e) {
          var cta = e.target.closest('a[data-analytics-label]');
          if (cta) {
            posthog.capture('cta_clicked', {
              page_path: window.location.pathname,
              cta_label: cta.getAttribute('data-analytics-label'),
              href: cta.getAttribute('href'),
            });
          }

          var ghLink = e.target.closest('a[href*="github.com"]');
          if (ghLink) {
            posthog.capture('github_click', {
              page_path: window.location.pathname,
            });
          }
        });

        // ─── Time on page — 2 buckets: casual (30s) vs engaged (120s) ───
        var pageStart = Date.now();
        var timeBuckets = [30, 120];
        var timeFired = new Set();

        var timeInterval = setInterval(function() {
          if (document.hidden) return;
          var elapsed = Math.floor((Date.now() - pageStart) / 1000);
          timeBuckets.forEach(function(bucket) {
            if (elapsed >= bucket && !timeFired.has(bucket)) {
              timeFired.add(bucket);
              posthog.capture('time_on_page', {
                seconds: bucket,
                page_path: window.location.pathname,
                page_title: document.title,
              });
            }
          });
          if (timeFired.size >= timeBuckets.length) clearInterval(timeInterval);
        }, 5000);

        // ─── Landing context (once per session) ───
        posthog.register_once({
          site: 'localcloud-docs',
          landing_page: window.location.pathname,
          landing_referrer: document.referrer || 'direct',
        });

        // ─── Keyboard shortcuts ───
        (function() {
          var base = document.querySelector('[data-base]')?.dataset?.base || '/';
          var searchInput = document.getElementById('search-input');
          var gKeyBuffer = null;

          // Help modal
          var helpModal = document.createElement('div');
          helpModal.className = 'kbd-help';
          helpModal.hidden = true;
          helpModal.setAttribute('role', 'dialog');
          helpModal.setAttribute('aria-label', 'Keyboard shortcuts');
          helpModal.innerHTML = '<div class="kbd-help__backdrop"></div><div class="kbd-help__panel"><h2>Keyboard Shortcuts</h2><table><tbody><tr><td><kbd>/</kbd></td><td>Focus search</td></tr><tr><td><kbd>Cmd+K</kbd></td><td>Open search</td></tr><tr><td><kbd>J</kbd></td><td>Next page</td></tr><tr><td><kbd>K</kbd></td><td>Previous page</td></tr><tr><td><kbd>G</kbd> <kbd>H</kbd></td><td>Go home</td></tr><tr><td><kbd>G</kbd> <kbd>D</kbd></td><td>Go to docs</td></tr><tr><td><kbd>G</kbd> <kbd>S</kbd></td><td>Go to services</td></tr><tr><td><kbd>?</kbd></td><td>Show this help</td></tr><tr><td><kbd>Esc</kbd></td><td>Close modals</td></tr></tbody></table><button type="button" class="kbd-help__close" aria-label="Close">Got it</button></div>';
          document.body.appendChild(helpModal);

          helpModal.querySelector('.kbd-help__backdrop')?.addEventListener('click', function() {
            helpModal.hidden = true;
          });
          helpModal.querySelector('.kbd-help__close')?.addEventListener('click', function() {
            helpModal.hidden = true;
          });

          function closeHelp() { helpModal.hidden = true; }

          document.addEventListener('keydown', function(e) {
            // Don't trigger shortcuts when typing in inputs
            var tag = document.activeElement?.tagName?.toLowerCase();
            var isEditing = tag === 'input' || tag === 'textarea' || tag === 'select' || document.activeElement?.isContentEditable;

            // Escape closes help, including when another control has focus.
            if (e.key === 'Escape') {
              closeHelp();
              return;
            }

            // / to focus search (not in inputs)
            if (e.key === '/' && !isEditing) {
              e.preventDefault();
              if (searchInput) {
                if (typeof window.__lcSearch !== 'undefined') window.__lcSearch.open();
                setTimeout(function() { searchInput.focus(); }, 60);
              }
              return;
            }

            // ? to show help (not in inputs)
            if (e.key === '?' && !isEditing && !e.metaKey && !e.ctrlKey) {
              e.preventDefault();
              helpModal.hidden = !helpModal.hidden;
              return;
            }

            // G + key navigation (vim-style)
            if (e.key === 'g' && !isEditing && !e.metaKey && !e.ctrlKey) {
              if (gKeyBuffer) { clearTimeout(gKeyBuffer); gKeyBuffer = null; }
              gKeyBuffer = setTimeout(function() { gKeyBuffer = null; }, 500);
              return;
            }

            if (gKeyBuffer) {
              clearTimeout(gKeyBuffer);
              gKeyBuffer = null;
              if (e.key === 'h') { window.location.href = base; return; }
              if (e.key === 'd') { window.location.href = base + 'docs/'; return; }
              if (e.key === 's') { window.location.href = base + 'services/'; return; }
              return;
            }

            // J/K for doc pagination (not in inputs)
            if ((e.key === 'j' || e.key === 'k') && !isEditing && !e.metaKey && !e.ctrlKey && !e.altKey) {
              var nextLink = document.querySelector('.docs-pagination__link--next');
              var prevLink = document.querySelector('.docs-pagination__link--previous');
              if (e.key === 'j' && nextLink) { nextLink.click(); return; }
              if (e.key === 'k' && prevLink) { prevLink.click(); return; }
            }
          });

          // FAB dismiss (store preference in localStorage)
          var fab = document.querySelector('[data-feedback-fab]');
          if (fab && localStorage.getItem('lc-fab-dismissed')) {
            fab.style.display = 'none';
          }
          if (fab) {
            var fabTrigger = fab.querySelector('[data-fab-trigger]');
            fab.addEventListener('dblclick', function() {
              fab.style.display = 'none';
              localStorage.setItem('lc-fab-dismissed', '1');
              if (typeof posthog !== 'undefined') {
                posthog.capture('feedback_fab_dismissed', { page_path: window.location.pathname });
              }
            });
          }
        })();
      })();
    </script>
  </body>
</html>
