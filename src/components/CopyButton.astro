---
interface Props {
  text: string;
  class?: string;
  analyticsLabel?: string;
  // Accessible name that says what gets copied, for example "Copy install command".
  label?: string;
}
const { text, class: className = '', analyticsLabel, label = 'Copy to clipboard' } = Astro.props;
---

<button
  class:list={['copy-btn inline-flex min-h-11 min-w-11 items-center justify-center gap-1.5 px-3 py-2 text-xs rounded-[var(--radius-control)] border border-[var(--border)] text-[var(--text-2)] hover:text-[var(--text)] hover:border-[var(--border-hover)] transition-colors cursor-pointer bg-transparent', className]}
  data-copy={text}
  data-analytics-label={analyticsLabel}
  aria-label={label}
  title={label}
  style="font-family: var(--font-mono);"
>
  <span class="copy-btn__icons" aria-hidden="true">
    <svg class="copy-btn__icon copy-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
    <svg class="copy-btn__icon check-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7" /></svg>
  </span>
  <span class="copy-label" aria-live="polite">Copy</span>
</button>

<style>
  .copy-btn:active {
    scale: 0.96;
  }

  .copy-label {
    white-space: nowrap;
  }

  .copy-btn__icons {
    position: relative;
    flex: none;
    width: 0.875rem;
    height: 0.875rem;
  }

  .copy-btn__icon {
    width: 100%;
    height: 100%;
    transition:
      opacity 300ms var(--ease),
      scale 300ms var(--ease),
      filter 300ms var(--ease);
  }

  /* Both icons stay in the DOM and cross-fade; the check overlays the copy glyph. */
  .copy-btn__icon.check-icon {
    position: absolute;
    inset: 0;
    opacity: 0;
    scale: 0.25;
    filter: blur(4px);
  }

  .copy-btn.is-copied .copy-icon {
    opacity: 0;
    scale: 0.25;
    filter: blur(4px);
  }

  .copy-btn.is-copied .check-icon {
    opacity: 1;
    scale: 1;
    filter: blur(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .copy-btn:active {
      scale: 1;
    }

    .copy-btn__icon {
      transition: none;
    }
  }
</style>

<script>
  const resetTimers = new WeakMap<Element, number>();

  function initCopyButtons() { document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    if (btn.dataset.copyReady === 'true') return;
    btn.dataset.copyReady = 'true';

    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy;
      if (!text) return;
      const idleTitle = btn.getAttribute('aria-label') || 'Copy to clipboard';

      const label = btn.querySelector('.copy-label');
      const activeTimer = resetTimers.get(btn);
      if (activeTimer) window.clearTimeout(activeTimer);

      let copied = false;
      try {
        if (!navigator.clipboard?.writeText) throw new Error('Clipboard API unavailable');
        await navigator.clipboard.writeText(text);
        copied = true;
      } catch {
        copied = false;
      }
      // BaseLayout records code_copied (with the closest data-analytics-label) only on success.
      if (copied) btn.dispatchEvent(new CustomEvent('lc:copied', { bubbles: true }));

      btn.classList.toggle('is-copied', copied);
      // Keep the label short: it sits inline in a narrow command box.
      // The long-form guidance goes in the tooltip.
      if (label) label.textContent = copied ? 'Copied!' : 'Copy failed';
      btn.title = copied
        ? 'Copied to clipboard'
        : 'Copy failed — select the command and copy it manually';

      const timer = window.setTimeout(() => {
        btn.classList.remove('is-copied');
        if (label) label.textContent = 'Copy';
        btn.title = idleTitle;
        resetTimers.delete(btn);
      }, copied ? 2000 : 5000);
      resetTimers.set(btn, timer);
    });
  }); }
  initCopyButtons();
  document.addEventListener('astro:page-load', initCopyButtons);
</script>
