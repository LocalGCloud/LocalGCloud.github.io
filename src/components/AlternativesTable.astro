---
import {
  alternatives,
  alternativesReviewedAt,
  alternativesReviewedLabel,
  comparisonRows,
  compactAlternativeIds,
  compactRowIds,
} from '../data/alternatives';

// The homepage summary of how LocalCloud compares with the other local options.
const columns = alternatives.filter((option) => compactAlternativeIds.includes(option.id));
const rows = comparisonRows.filter((row) => compactRowIds.includes(row.id));
const label = 'Local options for Google Cloud development compared';
---

{/* The visible note sits outside the scrolling region so it stays readable on narrow screens. */}
<p class="alternatives-table__note">
  Sources reviewed <time datetime={alternativesReviewedAt}>{alternativesReviewedLabel}</time>.
</p>
<div class="alternatives-table site-panel overflow-x-auto" tabindex="0" role="region" aria-label={label}>
  <table
    class="w-full min-w-[44rem] text-left text-sm"
    data-alternatives-table="compact"
    data-reviewed-at={alternativesReviewedAt}
  >
    <caption class="sr-only">{label}, sources reviewed {alternativesReviewedLabel}</caption>
    <thead class="border-b border-[var(--border)]">
      <tr>
        <td class="p-4"></td>
        {columns.map((option) => (
          <th scope="col" class:list={['p-4 font-semibold text-[var(--text)]', option.id === 'localcloud' && 'alternatives-table__ours']}>{option.shortName}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr class="border-b border-[var(--border)] align-top last:border-b-0">
          <th scope="row" class="p-4 font-semibold text-[var(--text)]">{row.label}</th>
          {columns.map((option) => (
            <td class:list={['p-4 leading-6', option.id === 'localcloud' ? 'alternatives-table__ours text-[var(--text)]' : 'text-[var(--text-2)]']}>
              {option.cells[row.id].text}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .alternatives-table__note {
    margin-bottom: 0.6rem;
    color: var(--text-2);
    font-size: var(--fs-small);
    line-height: 1.6;
  }

  .alternatives-table__ours {
    background: var(--surface-2);
  }
</style>
