---
import { faqEntries } from '../data/faqContent';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqEntries.map((entry) => ({
    '@type': 'Question',
    name: entry.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: [entry.answer, entry.afterCode].filter(Boolean).join(' '),
    },
  })),
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
