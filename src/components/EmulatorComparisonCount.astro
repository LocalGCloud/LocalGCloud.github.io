---
// A category row's number: how many features LocalCloud supports (green ✓) or are treated as unavailable in the competitor (red ✕).
// The glyph is decoration; readers and the Markdown twin get the words.
interface Props { value: number; kind: 'supported' | 'missing'; assumed?: boolean; }
const { value, kind, assumed = false } = Astro.props;
const glyph = value ? (kind === 'supported' ? '✓ ' : '✕ ') : '';
const label = `${value.toLocaleString('en-US')} ${kind === 'supported' ? 'supported' : 'not supported'}${assumed ? ' (includes unassessed)' : ''}`;
---
<span class:list={['comparison-count', value ? `comparison-count--${kind}` : 'comparison-count--zero']}><span aria-hidden="true">{glyph}{value.toLocaleString('en-US')}{assumed && '*'}</span><span class="sr-only">{label}</span></span>
