---
import EmulatorComparisonTable from './EmulatorComparisonTable.astro';
import type { emulatorComparisons } from '../data/emulatorComparisons';
interface Props { comparison: (typeof emulatorComparisons)[number]; embedded?: boolean; preview?: boolean; }
const { comparison, embedded = false, preview = true } = Astro.props;
const base = import.meta.env.BASE_URL;
const Heading = embedded ? 'h2' : 'h1';
---

<header class:list={[embedded ? '' : 'site-section site-section--tight']}>
  <div class:list={[!embedded && 'container']}>
    <div class="comparison-title-row">
      <Heading class="comparison-heading">{embedded ? comparison.engine : `${comparison.engine} vs ${comparison.competitor}`}</Heading>
      <a class="comparison-guide" href={`${base}services/${comparison.slug}/`}>Service guide <span aria-hidden="true">↗</span></a>
    </div>
    <div class="comparison-meta">
      <p><strong>{comparison.total.toLocaleString('en-US')}</strong> features · <strong>{comparison.exclusive}</strong> advantages · <strong>{comparison.broader}</strong> broader behaviors</p>
      <details class="comparison-notes"><summary>Notes</summary><p>{comparison.summary} Compared with <a href={comparison.baselineUrl}>{comparison.baseline}</a>. {comparison.scope} Counts describe documented rows and can overlap.</p></details>
    </div>
  </div>
</header>
<EmulatorComparisonTable {comparison} {embedded} {preview} />
