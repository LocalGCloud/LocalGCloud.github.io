---
import EmulatorComparisonTable from './EmulatorComparisonTable.astro';
import type { emulatorComparisons } from '../data/emulatorComparisons';
interface Props { comparison: (typeof emulatorComparisons)[number]; embedded?: boolean; preview?: boolean; }
const { comparison, embedded = false, preview = true } = Astro.props;
const base = import.meta.env.BASE_URL;
const Heading = embedded ? 'h2' : 'h1';
---

<header class:list={[embedded ? '' : 'site-section site-section--hero']}>
  <div class:list={[!embedded && 'container']}>
    <span class="site-kicker">{comparison.name}</span>
    <Heading class="mt-3 comparison-heading">{comparison.engine} vs {comparison.competitor}</Heading>
    <p class="mt-4 leading-7 text-[var(--text-2)]">{comparison.summary}</p>
    <a class="site-button site-button--secondary mt-5" href={`${base}services/${comparison.slug}/`}>{comparison.name} service guide</a>
    <dl class="comparison-metrics mt-6">
      <div><dt>Compared features</dt><dd>{comparison.total.toLocaleString('en-US')}</dd></div>
      <div><dt>LocalCloud advantages</dt><dd>{comparison.exclusive}</dd></div>
      <div><dt>Broader behaviors</dt><dd>{comparison.broader}</dd></div>
    </dl>
    <details class="mt-5 text-sm leading-6 text-[var(--text-2)]"><summary class="cursor-pointer">Comparison notes</summary><p class="mt-2">Compared with <a href={comparison.baselineUrl}>{comparison.baseline}</a>. {comparison.scope}</p></details>
  </div>
</header>
<EmulatorComparisonTable {comparison} {embedded} {preview} />
