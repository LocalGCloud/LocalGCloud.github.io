---
import EmulatorComparisonTable from './EmulatorComparisonTable.astro';
import type { emulatorComparisons } from '../data/emulatorComparisons';
interface Props { comparison: (typeof emulatorComparisons)[number]; embedded?: boolean; }
const { comparison, embedded = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const Heading = embedded ? 'h2' : 'h1';
---

<header class:list={[embedded ? '' : 'site-section site-section--tight']}>
  <div class:list={[!embedded && 'container']}>
    <div class="comparison-title-row">
      <Heading class="comparison-heading">{embedded || !comparison.hasCompetitor ? comparison.engine : `${comparison.engine} vs ${comparison.competitor}`}</Heading>
      <a class="comparison-guide" href={`${base}services/${comparison.slug}/`}>Service guide <span aria-hidden="true">↗</span></a>
    </div>
    <div class="comparison-meta">
      <p><strong>{comparison.total.toLocaleString('en-US')}</strong> features in total{comparison.hasCompetitor && <> · <strong>{comparison.exclusive.toLocaleString('en-US')}</strong> only available in LocalCloud (not in {comparison.competitor})</>}</p>
    </div>
    {comparison.id === 'firestore' && <p class="comparison-profile-note">Matching profiles share one mark. Extended is opt-in; Compatibility follows Java emulator behavior.</p>}
  </div>
</header>
<EmulatorComparisonTable {comparison} {embedded} />
<div class:list={['comparison-notes', !embedded && 'container']}><p><strong>Comparison notes.</strong> {comparison.summary} {comparison.hasCompetitor ? <>Compared with <a href={comparison.baselineUrl}>{comparison.baseline}</a>.</> : <>Compared with the features of production Google Cloud {comparison.name}.</>} {comparison.scope} Counts describe documented rows and can overlap.</p></div>
