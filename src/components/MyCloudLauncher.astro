---
import appIcon from '../../public/brand/localcloud-app-icon.svg?url';
import { docsContract } from '../data/docs-contract';
import { consoleQuickStart } from '../utils/quickstart.mjs';
import { myCloudURL } from '../scripts/my-cloud.mjs';
import dialogStyles from '../styles/my-cloud.css?url';
import dialogScript from '../scripts/my-cloud.mjs?url';
import copyScript from '../scripts/copy-buttons.mjs?url';
const setupCommand = consoleQuickStart(docsContract);
---

<a href={myCloudURL} target="_blank" rel="noopener noreferrer" class="desktop-shortcut desktop-my-cloud" data-my-cloud data-my-cloud-assets={import.meta.env.DEV ? 'src/scripts/' : undefined} data-my-cloud-script={dialogScript} data-copy-script={copyScript} data-my-cloud-styles={dialogStyles} data-setup-command={setupCommand} data-setup-guide={import.meta.env.BASE_URL + 'docs/#install-the-cli'} aria-haspopup="dialog" aria-controls="my-cloud-dialog" aria-label="My cloud localhost:5380 — check and open your local LocalCloud console">
  <img src={appIcon} width="64" height="64" alt="" loading="lazy" decoding="async" />
  <span>My cloud</span>
  <small>localhost:5380 ↗</small>
</a>
<dialog id="my-cloud-dialog" class="my-cloud-dialog" aria-labelledby="my-cloud-title" aria-describedby="my-cloud-status" data-my-cloud-dialog data-pagefind-ignore></dialog>

<script is:inline data-critical-bootstrap>
  (() => {
    const link = document.querySelector('[data-my-cloud]');
    const dialog = document.querySelector('[data-my-cloud-dialog]');
    let loaded, launching;
    const load = (source) => new Promise((resolve, reject) => {
      const url = new URL(source, location.href);
      const base = document.querySelector('[data-desktop-shell]')?.dataset.base || '/';
      if (url.origin !== location.origin || !url.pathname.startsWith(base + (link.dataset.myCloudAssets || '_astro/'))) return reject();
      const script = document.createElement('script');
      script.type = 'module'; script.src = url.href;
      const finish = (ok) => { clearTimeout(timer); script.remove(); ok ? resolve() : reject(); };
      const timer = setTimeout(finish, 8000);
      script.onload = () => finish(true);
      script.onerror = () => finish();
      document.head.append(script);
    });
    const localPermission = async () => { for (const name of ['loopback-network', 'local-network-access']) try { return (await navigator.permissions.query({ name })).state; } catch {} };
    link?.addEventListener('click', async (event) => {
      if (!dialog?.showModal || event.defaultPrevented || event.button || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      if (launching) return;
      launching = true;
      // Reserve a tab to avoid popup blocking, unless a localhost prompt needs this page in front.
      const permission = await localPermission();
      const tab = dialog.open || permission === 'prompt' || permission === 'denied' ? null : window.open();
      if (tab) tab.opener = null;
      try {
        loaded ||= Promise.all([load(link.dataset.myCloudScript), load(link.dataset.copyScript).catch(() => {})]);
        await loaded;
        dialog.dispatchEvent(new CustomEvent('lc:my-cloud-open', { detail: { tab } }));
      } catch {
        loaded = undefined;
        tab?.close();
        dialog.innerHTML = '<form method="dialog"><h2 id="my-cloud-title">Start LocalCloud</h2><pre id="my-cloud-status"></pre><button>Close</button></form>';
        dialog.querySelector('pre').textContent = link.dataset.setupCommand;
        if (!dialog.open) dialog.showModal();
      } finally { launching = false; }
    });
  })();
</script>
