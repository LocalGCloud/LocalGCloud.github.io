---
import BrandMark from './BrandMark.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
const currentPath = Astro.url.pathname;
const withSlash = (path: string) => (path.endsWith('/') ? path : `${path}/`);

// Services covers the catalog and every page that presents it: the GCP emulator overview,
// compatibility, and the six root emulator landing pages.
const rootEmulatorPages = ['bigquery', 'pubsub', 'spanner', 'bigtable', 'firestore', 'cloud-storage'].map(
  (name) => `${base}${name}-emulator/`,
);
const isServicesPath =
  ['services', 'gcp-emulator', 'compatibility'].some((prefix) => currentPath.startsWith(`${base}${prefix}`)) ||
  rootEmulatorPages.includes(withSlash(currentPath));

// The logo links home, so the navigation has no Home entry.
const navLinks = [
  {
    label: 'Services',
    href: `${base}services/`,
    isActive: isServicesPath,
  },
  {
    label: 'AI Agents',
    href: `${base}local-cloud-for-ai-agents/`,
    isActive:
      currentPath.startsWith(`${base}local-cloud-for-ai-agents`) ||
      currentPath.startsWith(`${base}ai`) ||
      currentPath.startsWith(`${base}agents`) ||
      currentPath.startsWith(`${base}workflows`),
  },
  {
    label: 'Pricing',
    href: `${base}pricing/`,
    isActive: currentPath.startsWith(`${base}pricing`),
  },
  {
    label: 'Docs',
    href: `${base}docs/`,
    isActive: currentPath.startsWith(`${base}docs`) || currentPath.startsWith(`${base}glossary`),
  },
  {
    label: 'Compare',
    href: `${base}compare/`,
    isActive: currentPath.startsWith(`${base}compare`) || currentPath.startsWith(`${base}localstack-for-google-cloud`),
  },
  {
    label: 'Blog',
    href: `${base}blog/`,
    isActive: currentPath.startsWith(`${base}blog`),
  },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <div class="site-header__brand-row">
      <a href={base} class="site-brand">
        <BrandMark size={42} class="site-brand__mark" />
        <span class="site-brand__text">
          <span class="site-brand__word"><span>Local</span><span class="site-brand__word-accent">Cloud</span></span>
          <span class="site-brand__descriptor">Google Cloud in-a-box</span>
        </span>
      </a>
    </div>

    <button id="site-nav-toggle" class="site-nav__toggle" type="button" aria-label="Open navigation" aria-controls="site-nav-mobile" aria-expanded="false">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <path d="M4 7h16"></path>
        <path d="M4 12h16"></path>
        <path d="M4 17h16"></path>
      </svg>
    </button>

    <nav class="site-nav" aria-label="Primary">
      {navLinks.map((link) => (
        <a href={link.href} class:list={['site-nav__link', link.isActive && 'is-active']} aria-current={link.isActive ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
      <button type="button" class="site-nav__search-btn" data-search-trigger aria-label="Search documentation">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <span class="site-nav__search-text">Search</span>
        <kbd class="site-nav__search-kbd">&#8984;K</kbd>
      </button>
      {/* The Docs link opens the docs; Get started goes straight to the install step. */}
      <a href={`${base}docs/#install-the-cli`} class="site-header__cta">Get started</a>
    </nav>
  </div>

  <div id="site-nav-mobile" class="site-nav__mobile" hidden>
    <div class="container site-nav__mobile-links">
      {navLinks.map((link) => (
        <a href={link.href} class:list={[link.isActive && 'is-active']} aria-current={link.isActive ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
      <a href={`${base}docs/#install-the-cli`}>Get started</a>
    </div>
  </div>
</header>

<script>
  const setMenuOpen = (open: boolean) => {
    const toggle = document.getElementById('site-nav-toggle') as HTMLButtonElement | null;
    const mobileMenu = document.getElementById('site-nav-mobile') as HTMLElement | null;
    if (!toggle || !mobileMenu) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    mobileMenu.hidden = !open;
    mobileMenu.classList.toggle('is-open', open);
  };

  document.addEventListener('click', (event) => {
    const toggle = (event.target as Element).closest('#site-nav-toggle');
    if (toggle) setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('keydown', (event) => {
    const toggle = document.getElementById('site-nav-toggle');
    if (event.key !== 'Escape' || toggle?.getAttribute('aria-expanded') !== 'true') return;
    setMenuOpen(false);
    toggle.focus();
  });
</script>
