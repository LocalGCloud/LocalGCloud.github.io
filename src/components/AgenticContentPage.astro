---
import LandingLayout from '../layouts/LandingLayout.astro';
import BlogLayout from '../layouts/BlogLayout.astro';
import { getBlogMetadata, formatBlogDate } from '../data/blogPresentation';
import CopyButton from './CopyButton.astro';
import { agentPromptLibrary } from '../data/agenticFacts';
import { createBreadcrumbSchema, createSoftwareApplicationSchema, productFacts } from '../data/productFacts';
import type { AgenticContentPage } from '../data/agenticContent';

interface Props {
  page: AgenticContentPage;
}

const { page } = Astro.props;
const isBlog = page.kind === 'blog';
const Layout = isBlog ? BlogLayout : LandingLayout;
const blogMetadata = isBlog ? getBlogMetadata(page) : undefined;
const prompts = page.promptIds
  .map((id) => agentPromptLibrary.find((prompt) => prompt.id === id))
  .filter((prompt) => prompt !== undefined);
const snippets = page.snippets ?? [];
const hasCommands = prompts.length > 0 || snippets.length > 0;
// Reading order: lede, the page's answer, then copyable commands and prompts.
const contents = [
  ...page.sections.map((section, index) => ({ id: `blog-section-${index}`, label: section.title })),
  ...(hasCommands ? [{ id: 'commands', label: 'Commands and prompts' }] : []),
  ...(page.table ? [{ id: 'local-compatibility', label: 'Local compatibility' }] : []),
  { id: 'validation', label: 'Before production' },
  ...(page.internalLinks.length ? [{ id: 'next-steps', label: 'Next steps' }] : []),
  ...(page.sources?.length ? [{ id: 'sources', label: 'Sources' }] : []),
];
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const localHref = (href: string) => href.startsWith('http') ? href : `${base}${href.replace(/^\//, '')}`;
const pageUrl = new URL(page.path, productFacts.siteUrl).toString();
const structuredData = [
  createSoftwareApplicationSchema(pageUrl, page.description),
  createBreadcrumbSchema([
    { name: 'Home', url: productFacts.siteUrl },
    { name: page.parentLabel, url: new URL(page.parentPath, productFacts.siteUrl).toString() },
    { name: page.h1, url: pageUrl },
  ]),
];
---

<Layout title={`${page.title} — LocalCloud`} description={page.description} {structuredData} {contents}>
  <Fragment slot="hero">
  <section class="site-section site-section--hero">
    <div class="container">
      <div class="min-w-0 reveal">
        <nav class="mb-5 flex flex-wrap items-center gap-2 text-sm text-[var(--text-2)]" aria-label="Breadcrumb">
          <a href={localHref(page.parentPath)} class="hover:text-[var(--text)]">{page.parentLabel}</a>
          <span>/</span>
          <span class="text-[var(--text)]">{page.h1}</span>
        </nav>
        <span class="site-eyebrow"><span class="site-eyebrow__pulse"></span>{page.eyebrow}</span>
        <h1 class="mt-4 max-w-[12ch]">{page.h1}</h1>
        {blogMetadata && <p class="blog-meta">
          {blogMetadata.date && <span>{blogMetadata.dateLabel} <time datetime={blogMetadata.date}>{formatBlogDate(blogMetadata.date)}</time></span>}
          <span>{blogMetadata.minutes} min read</span><span>{blogMetadata.topic}</span>
        </p>}
        <p class:list={['mt-6 max-w-[46rem] text-lg leading-8 text-[var(--text-2)] sm:text-xl', isBlog && 'blog-deck']}>{page.deck}</p>
        <div class:list={['mt-8 flex flex-wrap gap-3', isBlog && 'blog-actions']}>
          <a href={localHref('/docs/')} class="site-button site-button--primary">Read docs</a>
          <a href={localHref('/compatibility/')} class={isBlog ? undefined : 'site-button site-button--secondary'}>Check compatibility</a>
          <a href={localHref('/docs/sdk-examples/')} class={isBlog ? undefined : 'site-button site-button--secondary'}>SDK examples</a>
        </div>
      </div>
    </div>
  </section>
  </Fragment>

  {page.quickFacts.length > 0 && (
    <section class="site-section site-section--tight">
      <div class="container">
        {isBlog ? <aside class="site-panel site-panel--soft p-5">
          <span class="site-kicker">At a glance</span>
          <ul class="site-list mt-4">{page.quickFacts.map((fact) => <li>{fact}</li>)}</ul>
        </aside> : <div class="grid gap-4 sm:grid-cols-3">
          {page.quickFacts.map((fact) => (
            <article class="site-panel site-panel--soft min-w-0 break-words p-5 reveal">
              <span class="site-kicker">Fact</span>
              <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">{fact}</p>
            </article>
          ))}
        </div>}
      </div>
    </section>
  )}

  {page.sections.length > 0 && (
    <section class="site-section">
      <div class="container">
        <div class:list={['grid gap-4', page.sections.length > 1 && 'lg:grid-cols-2', isBlog && 'blog-sections']}>
          {page.sections.map((section, index) => (
            <article class="site-panel min-w-0 break-words p-6 reveal" id={isBlog ? `blog-section-${index}` : undefined}>
              <span class="site-kicker">{section.kicker}</span>
              <h2 class="mt-3 text-2xl">{section.title}</h2>
              {section.body && <p class="mt-3 leading-7 text-[var(--text-2)]">{section.body}</p>}
              {section.items && (
                <ul class="site-list mt-4">
                  {section.items.map((item) => <li>{item}</li>)}
                </ul>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {hasCommands && (
    <section class="site-section">
      <div class="container">
        <div class="reveal">
          <span class="site-kicker">Copy-ready setup</span>
          <h2 class="mt-3" id={isBlog ? 'commands' : undefined}>Commands and prompts</h2>
        </div>
        {prompts.length > 0 && (
          <div class="mt-8">
            <h3 class="site-kicker">Copy a prompt for your coding agent</h3>
            <div class:list={['mt-4', isBlog ? 'blog-prompt-list' : 'grid gap-4 lg:grid-cols-2']}>
              {prompts.map((prompt) => (
                <article class:list={['site-panel min-w-0', !isBlog && 'p-5 reveal']} data-analytics-label={`agentic-copy-${page.slug}-${prompt.id}`}>
                  <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                      <h4 class="agentic-prompt-title">{prompt.label}</h4>
                      <p class="mt-1 text-sm leading-6 text-[var(--text-2)]">{prompt.useCase}</p>
                    </div>
                    <CopyButton text={prompt.prompt} analyticsLabel={`agentic-copy-${page.slug}-${prompt.id}`} />
                  </div>
                  <pre class:list={[isBlog ? 'blog-prompt' : 'agentic-prompt-pre mt-3 max-h-44 overflow-auto whitespace-pre-wrap [overflow-wrap:anywhere]']}><code>{prompt.prompt}</code></pre>
                </article>
              ))}
            </div>
          </div>
        )}
        {snippets.length > 0 && (
          <div class:list={['mt-8 grid gap-6 lg:grid-cols-2', isBlog && 'blog-snippets']}>
            {snippets.map((snippet) => (
              <article class="site-panel min-w-0 overflow-hidden reveal" data-analytics-label={`agentic-copy-snippet-${page.slug}-${snippet.label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
                <div class="flex items-center justify-between gap-3 px-4 pb-2 pt-3">
                  <span class="site-kicker">{snippet.label}</span>
                  <CopyButton text={snippet.code} analyticsLabel={`agentic-copy-snippet-${page.slug}-${snippet.label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`} />
                </div>
                <pre class:list={['border-0 bg-[var(--surface-2)]', isBlog && snippet.language === 'text' && 'blog-prompt']}><code class="block whitespace-pre-wrap px-4 pb-4">{snippet.code}</code></pre>
              </article>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  {page.table && (
    <section class="site-section">
      <div class="container">
        <div class="reveal">
          <span class="site-kicker">Compatibility</span>
          <h2 class="mt-3" id={isBlog ? 'local-compatibility' : undefined}>Local check versus release validation</h2>
        </div>
        <div class="site-panel mt-8 overflow-x-auto reveal" tabindex="0" role="region" aria-label="Local check versus release validation">
          <table class="min-w-[46rem] w-full text-left text-sm">
            <thead class="border-b border-[var(--border)] text-[var(--text-2)]">
              <tr>{page.table.columns.map((column) => <th scope="col" class="p-4 font-semibold text-[var(--text)]">{column}</th>)}</tr>
            </thead>
            <tbody>
              {page.table.rows.map((row, index) => (
                <tr class:list={[index % 2 === 0 && 'bg-[var(--surface-2)]']}>
                  {row.map((cell) => <td class="p-4 leading-7 text-[var(--text-2)]">{cell}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  <section class="site-section">
    <div class:list={['container grid gap-4', page.internalLinks.length > 0 && 'lg:grid-cols-[0.9fr_1.1fr]', isBlog && 'blog-sections']}>
      <article class="site-panel site-panel--soft min-w-0 break-words p-6 reveal">
        <span class="site-kicker">Production boundary</span>
        <h2 class="mt-3 text-2xl" id={isBlog ? 'validation' : undefined}>Before production</h2>
        <p class="mt-3 leading-7 text-[var(--text-2)]">Use LocalCloud for non-production development, testing, and CI under the <a href={localHref('/docs/licensing/')}>Public Preview License</a>, check <a href={localHref('/compatibility/')}>each service's local boundaries</a>, and validate against real Google Cloud before you deploy.</p>
        {page.limitations.length > 0 && (
          <ul class="site-list mt-4">
            {page.limitations.map((item) => <li>{item}</li>)}
          </ul>
        )}
      </article>
      {page.internalLinks.length > 0 && (
        <article class="site-panel min-w-0 break-words p-6 reveal">
          <span class="site-kicker">Related</span>
          <h2 class="mt-3 text-2xl" id={isBlog ? 'next-steps' : undefined}>Next steps</h2>
          <ul class="site-list mt-4">
            {page.internalLinks.map((link) => (
              <li><a href={localHref(link.href)}>{link.label}</a> — {link.note}</li>
            ))}
          </ul>
        </article>
      )}
    </div>
  </section>

  {page.sources && page.sources.length > 0 && (
    <section class="site-section site-section--tight">
      <div class="container container--narrow">
        <article class="site-panel min-w-0 break-words p-6 reveal">
          <span class="site-kicker">Sources and review</span>
          <h2 class="mt-3 text-2xl" id={isBlog ? 'sources' : undefined}>Claims are tied to current sources</h2>
          <ul class="site-list mt-4">
            {page.sources.map((source) => (
              <li><a href={localHref(source.href)}>{source.label}</a> — {source.note}</li>
            ))}
            {page.reviewedAt && <li>LocalCloud agentic facts reviewed {page.reviewedAt}.</li>}
          </ul>
        </article>
      </div>
    </section>
  )}
</Layout>

<style>
  .agentic-prompt-title {
    font-size: var(--fs-body, 1rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .agentic-prompt-pre {
    margin-top: 0.75rem;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .agentic-prompt-pre > code {
    padding: 0;
    color: var(--text-2);
    font-size: var(--fs-label, 0.75rem);
    line-height: 1.6;
  }
</style>
