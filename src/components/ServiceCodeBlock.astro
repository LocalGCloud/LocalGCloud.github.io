---
import { Code } from 'astro:components';
import CopyButton from './CopyButton.astro';
import { neutralPaperTheme } from '../utils/code-theme.mjs';

interface Props {
  code: string;
  lang?: 'python' | 'javascript' | 'java' | 'bash' | 'text';
  label: string;
  marker?: string;
}
const { code, lang = 'bash', label, marker } = Astro.props;
const transformers = marker ? [{
  code(node: { properties: Record<string, unknown> }) { node.properties[marker] = true; },
}] : [];
---

<div class="code-block" data-code-block>
  <Code {code} {lang} theme={neutralPaperTheme} tabindex="0" role="region" aria-label={label} {transformers} />
  <CopyButton text={code} label={`Copy ${label}`} />
</div>
