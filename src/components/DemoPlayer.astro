---
import { demoVideoPath } from '../data/visitorShortcuts';
import styles from '../styles/demo-player.css?url';

const videoUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/') + demoVideoPath;
---

<dialog class="demo-player" data-demo-player data-styles={styles} data-video-src={videoUrl} aria-labelledby="demo-title" data-pagefind-ignore>
  <header>
    <h2 id="demo-title">LocalCloud demo</h2>
    <form method="dialog">
      <button type="submit" autofocus aria-label="Close demo">×</button>
    </form>
  </header>
  <video controls playsinline preload="none" width="1280" height="720" aria-labelledby="demo-title"></video>
  <p><a href={videoUrl} target="_blank" rel="noopener noreferrer">Open video ↗</a></p>
</dialog>
