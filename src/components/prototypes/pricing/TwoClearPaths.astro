---
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const docsHref = `${base}docs/`;
const licenseHref = `${base}docs/licensing/`;
const contactHref = 'mailto:data.oculus.llc@gmail.com?subject=LocalCloud%20commercial%20licensing%20inquiry';
---

<section class="clear-paths" aria-labelledby="clear-paths-title">
  <div class="clear-paths__shell">
    <header class="clear-paths__hero">
      <span class="clear-paths__kicker">Two paths. One product.</span>
      <h1 id="clear-paths-title">Choose by who<br />you build for.</h1>
      <p>Your LocalCloud capabilities stay the same. Your use determines the license.</p>
    </header>

    <div class="clear-paths__grid">
      <article class="clear-paths__card clear-paths__card--community" aria-labelledby="clear-paths-community">
        <header>
          <span class="clear-paths__number" aria-hidden="true">01</span>
          <div>
            <span class="clear-paths__label">Community</span>
            <h2 id="clear-paths-community">Free</h2>
          </div>
        </header>

        <p class="clear-paths__summary">For people learning, building independently, or working in service of a nonprofit mission.</p>

        <ul>
          <li><span aria-hidden="true">✓</span> Individual developers</li>
          <li><span aria-hidden="true">✓</span> Students and academic work</li>
          <li><span aria-hidden="true">✓</span> Nonprofit organizations</li>
          <li><span aria-hidden="true">✓</span> Complete LocalCloud capabilities</li>
        </ul>

        <div class="clear-paths__actions">
          <a class="clear-paths__button clear-paths__button--primary" href={docsHref}>Get started <span aria-hidden="true">→</span></a>
          <a class="clear-paths__license" href={licenseHref}>Read the license</a>
        </div>
      </article>

      <article class="clear-paths__card clear-paths__card--commercial" aria-labelledby="clear-paths-commercial">
        <header>
          <span class="clear-paths__number" aria-hidden="true">02</span>
          <div>
            <span class="clear-paths__label">Commercial</span>
            <h2 id="clear-paths-commercial">Contact us</h2>
          </div>
        </header>

        <p class="clear-paths__summary">For any for-profit company using LocalCloud to build, test, or support its business.</p>

        <ul>
          <li><span aria-hidden="true">✓</span> For-profit company use</li>
          <li><span aria-hidden="true">✓</span> Internal development workflows</li>
          <li><span aria-hidden="true">✓</span> Commercial product development</li>
          <li><span aria-hidden="true">✓</span> Complete LocalCloud capabilities</li>
        </ul>

        <div class="clear-paths__actions">
          <a class="clear-paths__button clear-paths__button--secondary" href={contactHref}>Contact us <span aria-hidden="true">↗</span></a>
          <a class="clear-paths__license" href={licenseHref}>Read the license</a>
        </div>
      </article>
    </div>

    <div class="clear-paths__shared">
      <span>Same product</span>
      <p>Every LocalCloud capability is included. Your category is determined by who benefits from the work.</p>
      <span>No feature tiers</span>
    </div>

    <p class="clear-paths__notice">
      Proposed policy preview. The <a href={licenseHref}>current governing license</a> controls until it is revised.
    </p>
  </div>
</section>

<style>
  .clear-paths {
    min-height: calc(100vh - 4.5rem);
    padding: clamp(3.5rem, 7vw, 6.5rem) 0 6rem;
  }

  .clear-paths__shell {
    width: min(100% - 2rem, 70rem);
    margin: 0 auto;
  }

  .clear-paths__hero {
    max-width: 48rem;
    margin: 0 auto 3rem;
    text-align: center;
    animation: clear-paths-enter 240ms cubic-bezier(0.2, 0, 0, 1) both;
  }

  .clear-paths__kicker,
  .clear-paths__label {
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .clear-paths__hero h1 {
    margin-top: 0.85rem;
    font-size: clamp(3.4rem, 7vw, 6rem);
    letter-spacing: -0.065em;
    line-height: 0.9;
  }

  .clear-paths__hero p {
    margin-top: 1.25rem;
    color: var(--text-2);
    font-size: 1.05rem;
  }

  .clear-paths__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--surface);
    animation: clear-paths-enter 240ms 70ms cubic-bezier(0.2, 0, 0, 1) both;
  }

  .clear-paths__card {
    display: flex;
    min-width: 0;
    min-height: 34rem;
    flex-direction: column;
    padding: clamp(1.8rem, 4vw, 3.25rem);
    border-top: 0.28rem solid var(--accent);
  }

  .clear-paths__card + .clear-paths__card {
    border-left: 1px solid var(--line);
  }

  .clear-paths__card--commercial {
    border-top-color: var(--text);
    background: var(--surface-2);
  }

  .clear-paths__card header {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1rem;
  }

  .clear-paths__number {
    display: inline-flex;
    width: 2.4rem;
    height: 2.4rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .clear-paths__card h2 {
    margin-top: 0.5rem;
    font-size: clamp(2.8rem, 5vw, 4.6rem);
    line-height: 0.93;
    letter-spacing: -0.055em;
  }

  .clear-paths__summary {
    min-height: 5.5rem;
    margin-top: 2rem;
    color: var(--text-2);
    font-size: 0.99rem;
    line-height: 1.65;
  }

  .clear-paths__card ul {
    display: grid;
    gap: 0;
    margin-top: 1.5rem;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .clear-paths__card li {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: 0.45rem;
    padding: 0.78rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--text-2);
    font-size: 0.9rem;
  }

  .clear-paths__card li span {
    color: var(--success);
    font-weight: 700;
  }

  .clear-paths__actions {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    margin-top: auto;
    padding-top: 2rem;
  }

  .clear-paths__button {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 1rem;
    border: 1px solid var(--accent-strong);
    border-radius: 0.65rem;
    font-size: 0.92rem;
    font-weight: 600;
    transition-property: color, background-color, transform;
    transition-duration: 150ms;
    transition-timing-function: ease-out;
  }

  .clear-paths__button:active {
    transform: scale(0.96);
  }

  .clear-paths__button--primary {
    background: var(--accent-strong);
    color: #fff;
  }

  .clear-paths__button--primary:hover {
    background: var(--accent);
    color: #fff;
  }

  .clear-paths__button--secondary {
    border-color: var(--text);
    background: var(--text);
    color: #fff;
  }

  .clear-paths__button--secondary:hover {
    background: var(--text-2);
    color: #fff;
  }

  .clear-paths__license {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    color: var(--text-2);
    font-size: 0.82rem;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.22rem;
  }

  .clear-paths__shared {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.2rem;
    padding: 1rem 1.2rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    border-left: 1px solid var(--line);
    border-radius: 0 0 1rem 1rem;
    background: rgba(255, 255, 255, 0.7);
    color: var(--text-2);
    font-size: 0.86rem;
  }

  .clear-paths__shared > span {
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .clear-paths__shared > span:last-child {
    color: var(--text-3);
  }

  .clear-paths__notice {
    margin-top: 1rem;
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-align: center;
  }

  .clear-paths__notice a {
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }

  @keyframes clear-paths-enter {
    from { opacity: 0; transform: translateY(0.55rem); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 760px) {
    .clear-paths {
      padding-top: 3rem;
    }

    .clear-paths__hero h1 {
      font-size: clamp(3rem, 15vw, 4.8rem);
    }

    .clear-paths__grid {
      grid-template-columns: 1fr;
    }

    .clear-paths__card + .clear-paths__card {
      border-top: 0.28rem solid var(--text);
      border-left: 0;
    }

    .clear-paths__shared {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }

    .clear-paths__shared > span:last-child {
      display: none;
    }
  }

  @media (max-width: 460px) {
    .clear-paths__actions {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }

    .clear-paths__button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .clear-paths__hero,
    .clear-paths__grid {
      animation: none;
    }

    .clear-paths__button {
      transition: none;
    }
  }
</style>
