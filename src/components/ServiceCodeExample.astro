---
import CopyButton from './CopyButton.astro';
import type { ServiceCodeExample } from '../data/serviceClientExamples';

interface Props { example: ServiceCodeExample; }
const { example } = Astro.props;
---

<article class="min-w-0 space-y-5" data-hello-world>
  <div>
    <h3 class="text-xl font-semibold">{example.title}</h3>
    <p class="mt-2 text-sm leading-6 text-[var(--text-2)]">{example.description}</p>
  </div>
  {example.environment && <div>
    <div class="mb-2 flex items-center justify-between gap-3"><h4 class="font-semibold">Configure {example.label}</h4><CopyButton text={example.environment} label={`Copy ${example.label} environment`} /></div>
    <pre class="overflow-x-auto rounded-xl border border-[var(--line)] bg-[var(--surface-2)] p-4 text-sm leading-7"><code class="border-0 bg-transparent p-0" data-client-environment>{example.environment}</code></pre>
  </div>}
  <div>
    <div class="mb-2 flex items-center justify-between gap-3"><h4 class="font-semibold">{example.filename ? `Save as ${example.filename}` : 'Run in your terminal'}</h4><CopyButton text={example.code} label={`Copy ${example.label} example`} /></div>
    <pre class="overflow-x-auto rounded-xl border border-[var(--line)] bg-[var(--surface-2)] p-4 text-sm leading-7"><code class="border-0 bg-transparent p-0" data-example-code>{example.code}</code></pre>
  </div>
  {example.setup && <details class="text-sm">
    <summary class="cursor-pointer font-semibold">SDK dependencies</summary>
    <div class="mt-3"><div class="mb-2 flex items-center justify-between gap-3"><span>Run in a new example directory</span><CopyButton text={example.setup} label={`Copy ${example.label} dependencies`} /></div>
    <pre class="overflow-x-auto rounded-xl border border-[var(--line)] bg-[var(--surface-2)] p-4 leading-7"><code class="border-0 bg-transparent p-0">{example.setup}</code></pre></div>
  </details>}
  {example.run && <div>
    <div class="mb-2 flex items-center justify-between gap-3"><h4 class="font-semibold">Run the example</h4><CopyButton text={example.run} label={`Copy ${example.label} run command`} /></div>
    <pre class="overflow-x-auto rounded-xl border border-[var(--line)] bg-[var(--surface-2)] p-4 text-sm leading-7"><code class="border-0 bg-transparent p-0">{example.run}</code></pre>
  </div>}
  {example.output && <div><h4 class="mb-2 font-semibold">Expected output</h4><pre class="overflow-x-auto rounded-xl border border-[var(--line)] bg-[var(--surface-2)] p-4 text-sm leading-7"><code class="border-0 bg-transparent p-0">{example.output}</code></pre></div>}
  {example.href && <a class="inline-block text-sm font-medium text-[var(--accent-strong)]" href={example.href}>Full example guide <span aria-hidden="true">→</span></a>}
</article>
