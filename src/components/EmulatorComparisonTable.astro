---
import { groupComparisonRows, groupLabel, resultsText } from '../utils/emulator-comparisons.mjs';
import EmulatorComparisonStatus from './EmulatorComparisonStatus.astro';
import type { emulatorComparisons } from '../data/emulatorComparisons';
interface Props { comparison: (typeof emulatorComparisons)[number]; embedded?: boolean; }
const { comparison, embedded = false } = Astro.props;
const hasCompetitor = comparison.hasCompetitor;
const defaultMode = hasCompetitor ? 'advantages' : 'all';
// Categories come from the document's own sections; each opens to its features on demand. One with nothing only
// LocalCloud has stays in the page, hidden, so "All features" can list it.
const groups = groupComparisonRows(comparison.rows);
const listed = groups.filter(group => defaultMode === 'all' || group.exclusive > 0);
const shown = listed.reduce((sum, group) => sum + (defaultMode === 'all' ? group.total : group.exclusive), 0);
const titleId = embedded ? `feature-table-${comparison.id}` : 'feature-table-title';
const Heading = embedded ? 'h3' : 'h2';
---

<section class:list={['comparison-features', !embedded && 'site-section']} aria-labelledby={titleId}>
  <div class:list={[!embedded && 'container']} data-emulator-comparison data-inventory={comparison.dataUrl} data-default-mode={defaultMode}>
    <Heading id={titleId} class="sr-only">Explore the feature comparison</Heading>
    <div class="comparison-controls" data-comparison-controls hidden data-pagefind-ignore>
      {hasCompetitor ? <fieldset>
        <legend class="sr-only">Show features</legend>
        <div class="comparison-modes">
          <label><input type="radio" name={`comparison-mode-${comparison.id}`} value="advantages" checked />Only in LocalCloud</label>
          <label><input type="radio" name={`comparison-mode-${comparison.id}`} value="all" />All features</label>
        </div>
      </fieldset> : <input type="radio" name={`comparison-mode-${comparison.id}`} value="all" checked hidden />}
      <div class="comparison-search">
        <label><span class="sr-only">Search features</span><input type="search" placeholder="Search features" autocomplete="off" /></label>
      </div>
    </div>
    <div class="comparison-table-meta">
      <p class="comparison-result" role="status" aria-live="polite" data-comparison-status>{resultsText(shown, listed.length, defaultMode)}</p>
      <p>A check mark means the feature works; any limits appear under Note.</p>
    </div>
    <template data-comparison-table>
      <div class="comparison-scroll" tabindex="0" role="region">
        <table class:list={['comparison-table', !hasCompetitor && 'comparison-table--solo']}>
          <thead><tr><th scope="col">Feature</th><th scope="col">{comparison.engine}</th>{hasCompetitor && <th scope="col">{comparison.competitor}</th>}<th scope="col">Details</th></tr></thead>
          <tbody></tbody>
        </table>
      </div>
    </template>
    <template data-comparison-row><tr><th scope="row"><span></span></th><td><span data-comparison-profile hidden>Extended: </span><EmulatorComparisonStatus state="unknown" /><small data-comparison-profile hidden>Compatibility: <EmulatorComparisonStatus state="unknown" /></small></td>{hasCompetitor && <td><EmulatorComparisonStatus state="unknown" /></td>}<td><p></p><p class="comparison-doc" hidden><a target="_blank" rel="noopener noreferrer"><span></span> <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></p><p class="comparison-limit" hidden></p></td></tr></template>
    <div class="comparison-groups" data-comparison-groups>
      {groups.map(group => <details class="comparison-group" data-comparison-group hidden={!listed.includes(group)} data-markdown-skip={listed.includes(group) ? undefined : ''} data-area={group.area} data-total={group.total} data-exclusive={group.exclusive}>
        <summary><span class="comparison-group-name">{group.area}</span> <span class="comparison-group-count">{groupLabel(group, { mode: defaultMode, hasCompetitor })}</span></summary>
        <div class="comparison-group-body" data-comparison-body><noscript><p>Enable JavaScript to list these features, or use the JSON comparison view.</p></noscript></div>
      </details>)}
    </div>
    <aside class="mt-5 text-sm leading-6" data-comparison-agent>
      <h3 class="font-medium">Agent data</h3>
      <p><a href={comparison.dataUrl}>JSON comparison view</a></p>
    </aside>
  </div>
</section>

<script>
  import '../scripts/emulator-comparison.mjs';
</script>

<style is:global>
  html:not([data-audience="agents"]) [data-comparison-agent] { display:none; }
  .comparison-features { margin-top:1rem; }
  .comparison-controls:not([hidden]) { display:flex; flex-wrap:wrap; align-items:center; gap:.5rem .75rem; }
  .comparison-controls fieldset { min-width:0; }
  .comparison-modes { display:flex; flex-wrap:wrap; gap:.375rem; }
  .comparison-modes label { display:flex; align-items:center; gap:.375rem; min-height:2.25rem; padding:.35rem .55rem; border:1px solid var(--line); border-radius:.4rem; cursor:pointer; font-size:.8125rem; white-space:nowrap; }
  .comparison-modes label:has(:checked) { border-color:var(--accent-strong); background:var(--surface-2); }
  .comparison-modes input { accent-color:var(--accent-strong); }
  .comparison-search { flex:1 1 17rem; min-width:0; }
  .comparison-search label { font-size:.8125rem; min-width:0; }
  .comparison-search input { min-width:0; width:100%; min-height:2.25rem; border:1px solid var(--line); border-radius:.4rem; padding:.35rem .55rem; background:var(--surface); color:var(--text); }
  .comparison-table-meta { display:flex; flex-wrap:wrap; justify-content:space-between; gap:.25rem 1rem; margin:.5rem 0; font-size:.75rem; color:var(--text-2); }
  .comparison-table-meta p { margin:0; }
  .comparison-scroll { overflow-x:auto; }
  .comparison-table { width:100%; min-width:46rem; border-collapse:collapse; text-align:left; font-size:.875rem; table-layout:fixed; }
  .comparison-table th,.comparison-table td { padding:.625rem .7rem; border-bottom:1px solid var(--line); vertical-align:top; overflow-wrap:anywhere; }
  .comparison-table th:first-child { width:30%; }
  .comparison-table th:nth-child(2),.comparison-table th:nth-child(3) { width:17%; }
  .comparison-table th:nth-child(2),.comparison-table th:nth-child(3),.comparison-table td:nth-child(2),.comparison-table td:nth-child(3) { text-align:center; }
  .comparison-table small { display:block; color:var(--text-2); font-weight:400; margin-top:.4rem; }
  .comparison-table [hidden] { display:none; }
  .comparison-state { display:inline-block; position:relative; }
  .comparison-state[data-state="available"] > .comparison-mark::before { content:'✓'; color:var(--success-ink); }
  .comparison-state[data-state="unavailable"] > .comparison-mark::before { content:'✕'; color:var(--brand-red); }
  .comparison-mark::before { font-size:1.125rem; font-weight:700; line-height:1; }
  .comparison-state:is([data-state="available"],[data-state="unavailable"]) > .comparison-label { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; border:0; }
  .comparison-table td p { margin:0; line-height:1.55; }
  .comparison-table td p + p { margin-top:.4rem; }
  .comparison-table td .comparison-limit { font-size:.8125rem; color:var(--text-2); }
  .comparison-table td .comparison-doc { font-size:.8125rem; }
  /* The hidden "opens in a new tab" text is absolutely positioned; anchoring it here keeps the scroll region clipping it. */
  .comparison-table td .comparison-doc a { position:relative; text-decoration:underline; text-underline-offset:.18em; }
  .comparison-table--solo { min-width:36rem; }
  .comparison-groups { display:flex; flex-direction:column; gap:.5rem; }
  .comparison-group,.comparison-group-body { min-width:0; }
  .comparison-group { border:1px solid var(--line); border-radius:.55rem; background:var(--surface); }
  .comparison-group > summary { display:flex; flex-wrap:wrap; align-items:baseline; justify-content:space-between; gap:.15rem 1rem; padding:.85rem 1rem; cursor:pointer; list-style:none; }
  .comparison-group > summary::-webkit-details-marker { display:none; }
  .comparison-group > summary::before { content:'▸'; flex:0 0 auto; margin-right:.6rem; color:var(--text-2); transition:transform .15s; }
  .comparison-group[open] > summary::before { transform:rotate(90deg); }
  .comparison-group-name { flex:1 1 14rem; font-weight:600; }
  .comparison-group-count { font-size:.8125rem; color:var(--text-2); }
  .comparison-group[open] > summary { border-bottom:1px solid var(--line); }
  .comparison-group-body { padding:0 .25rem .5rem; }
  .comparison-group-body .comparison-table-empty { padding:1rem; font-size:.875rem; color:var(--text-2); }
  @media(prefers-reduced-motion:reduce) { .comparison-group > summary::before { transition:none; } }
  .comparison-table--solo th:nth-child(3),.comparison-table--solo td:nth-child(3) { width:auto; text-align:left; }

  .comparison-title-row { display:flex; flex-wrap:wrap; align-items:baseline; justify-content:space-between; gap:.25rem 1rem; }
  .comparison-title-row .comparison-heading { font-size:1.25rem; line-height:1.35; letter-spacing:-.02em; }
  .comparison-guide { font-size:.8125rem; white-space:nowrap; }
  .comparison-meta { display:flex; flex-wrap:wrap; align-items:baseline; gap:.25rem 1rem; margin-top:.375rem; font-size:.8125rem; color:var(--text-2); }
  .comparison-meta p { margin:0; }
  .comparison-profile-note,.comparison-notes { font-size:.8125rem; color:var(--text-2); line-height:1.6; }
  .comparison-profile-note { margin-top:.375rem; }
  .comparison-notes { padding-block:1rem; }
  .site-section.comparison-intro { padding-block:1rem; }
  .comparison-workspace { display:grid; grid-template-columns:12.5rem minmax(0,1fr); gap:2rem; align-items:start; }
  .comparison-services { position:sticky; top:1rem; }
  .comparison-service-tabs:not([hidden]) { display:flex; flex-direction:column; gap:.5rem; margin-top:1rem; }
  .comparison-service-tabs button { display:block; padding:1rem; border:1px solid transparent; border-radius:.65rem; color:var(--text); text-align:left; cursor:pointer; }
  .comparison-service-tabs button:hover { background:var(--surface-2); }
  .comparison-service-tabs button[aria-selected="true"] { background:var(--surface-2); border-color:var(--accent-strong); }
  .comparison-service-tabs span { display:block; font-weight:600; }
  .comparison-service-tabs small { display:block; margin-top:.35rem; font-size:.75rem; color:var(--text-2); }
  .comparison-content { min-width:0; }
  @media(max-width:63.999rem) {
    .comparison-intro h1 { font-size:1.75rem; margin-top:.4rem; }
    .comparison-intro p,.comparison-services > .site-micro { display:none; }
    .comparison-workspace { grid-template-columns:minmax(0,1fr); gap:1.5rem; }
    .comparison-services { position:static; min-width:0; }
    .comparison-service-tabs:not([hidden]) { flex-direction:row; overflow-x:auto; margin-top:0; padding-bottom:.5rem; }
    .comparison-service-tabs button { flex:0 0 auto; padding:.5rem .75rem; }
  }
  .comparison-breadcrumb { padding-top:2rem; }
</style>
