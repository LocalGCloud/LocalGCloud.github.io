---
import { relatedLinksFor } from '../data/relatedPages';

// Links a page to the pages it overlaps with (src/data/relatedPages.ts), using each page's
// canonical anchor text. `exclude` drops counterparts the page already links in its content.
interface Props {
  path: string;
  exclude?: (href: string) => boolean;
  // "prose" renders a heading and list inside Markdown docs; "block" a labeled list for landing pages.
  variant?: 'prose' | 'block';
  heading?: string;
}

const { path, exclude = () => false, variant = 'block', heading = 'Related pages' } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const links = relatedLinksFor(path).filter((link) => !exclude(link.href));
---

{links.length > 0 && (variant === 'prose' ? (
  <section aria-labelledby="related-pages">
    <h2 id="related-pages">{heading}</h2>
    <ul>
      {links.map((link) => <li><a href={`${base}${link.href.slice(1)}`}>{link.label}</a>: {link.note}</li>)}
    </ul>
  </section>
) : (
  <div class="related-pages">
    <span class="site-kicker">{heading}</span>
    <ul class="site-list mt-3">
      {links.map((link) => <li><span><a href={`${base}${link.href.slice(1)}`}>{link.label}</a>: {link.note}</span></li>)}
    </ul>
  </div>
))}
