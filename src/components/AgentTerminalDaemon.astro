---
import { agentModeExamples, agentOverview } from '../data/agentModeExamples';
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---
<div class="agent-terminal" aria-label="LocalCloud workflow examples">
  {agentModeExamples.map(example => <section class="agent-terminal__pane" aria-labelledby={`agent-section-${example.id}`}>
    <h2 id={`agent-section-${example.id}`}>{example.title}</h2>
    <p>{example.description}</p>
    {example.setup && <><h3>SDK dependencies</h3><pre tabindex="0" role="region" aria-label="Python dependencies"><code>{example.setup}</code></pre></>}
    <h3>{example.label}</h3>
    <pre tabindex="0" role="region" aria-label={example.label}><code>{example.code}</code></pre>
    {example.run && <><h3>Run the example</h3><pre tabindex="0" role="region" aria-label="Python run command"><code>{example.run}</code></pre></>}
    <p class="agent-terminal__note">Expected result: {example.result}</p>
  </section>)}
  <section>
    <h2>Scope and references</h2>
    <p>{agentOverview.scope}</p>
    <ul>{agentOverview.references.map(item => <li><a href={base + item.href}>{item.title}</a></li>)}</ul>
  </section>
</div>
<style>
 .agent-terminal{font:14px/1.8 var(--font-mono);min-width:0}
 section{margin-top:32px}
 h3{font:500 13px/1.6 var(--font-mono);color:var(--text-2);margin:16px 0 8px}
 h2{margin:0 0 12px;font:600 16px/1.5 var(--font-mono);color:var(--accent)}
 p{margin:0 0 14px;color:var(--text-2)}
 pre{margin:12px 0;font:13px/1.8 var(--font-mono);white-space:pre;overflow:auto;max-width:100%}
 code{font:inherit}
 .agent-terminal__note{font-size:12px;margin-top:12px}
 nav{font-size:12px}
 a{color:var(--accent);text-decoration:underline;text-underline-offset:4px}
</style>
