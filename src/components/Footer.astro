---
import BrandMark from './BrandMark.astro';
import { availableServiceCount } from '../data/services';
import { productFacts } from '../data/productFacts';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---

<footer class="site-footer">
  <div class="container site-footer__intro">
    <div class="site-footer__intro-copy">
      <span class="site-kicker">Google Cloud In-a-Box</span>
      <p>One container runs {availableServiceCount} local services.</p>
    </div>

    <div class="site-footer__chips">
      <span class="site-chip site-chip--neutral">single container</span>
      <span class="site-chip site-chip--neutral">generated SDK endpoints</span>
      <span class="site-chip site-chip--neutral">local console</span>
      <span class="site-chip site-chip--neutral">documented limits</span>
    </div>
  </div>

  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <a href={base} class="site-brand">
        <BrandMark size={44} class="site-brand__mark" />
        <span class="site-brand__text">
          <span class="site-brand__word"><span>Local</span><span class="site-brand__word-accent">Cloud</span></span>
          <span class="site-brand__descriptor">Google Cloud in-a-box</span>
        </span>
      </a>
      <p class="mt-4">
        A local Google Cloud development sandbox with generated SDK targets, operation-level limits, and explicit privacy and license boundaries.
      </p>
    </div>

    <div class="site-footer__group">
      <h2>Product</h2>
      <ul>
        <li><a href={base}>Homepage</a></li>
        <li><a href={`${base}services/`}>Services</a></li>
        <li><a href={`${base}gcp-emulator/`}>GCP Emulator</a></li>
        <li><a href={`${base}pricing/`}>Pricing</a></li>
        <li><a href={`${base}compatibility/`}>Compatibility</a></li>
        <li><a href={`${base}docs/console/`}>Web Console</a></li>
        <li><a href={`${base}docs/what-is-gcp-emulator/`}>What is a GCP Emulator?</a></li>
      </ul>
    </div>

    <div class="site-footer__group">
      <h2>For AI agents</h2>
      <ul>
        <li><a href={`${base}local-cloud-for-ai-agents/`}>Local Cloud for AI Agents</a></li>
        <li><a href={`${base}ai/`}>AI Agent Guide</a></li>
        <li><a href={`${base}ai/agents.md`}>Agent Guide (Markdown)</a></li>
        <li><a href={`${base}llms.txt`}>llms.txt</a></li>
        <li><a href={`${base}agents/`}>Agent Sandboxes</a></li>
        <li><a href={`${base}workflows/`}>Agent Workflows</a></li>
        <li><a href={`${base}compare/`}>Comparisons</a></li>
        <li><a href={`${base}glossary/`}>Glossary</a></li>
        <li><a href={`${base}blog/`}>Blog and Demos</a></li>
        <li><a href={`${base}blog/localcloud-for-ai-agents/`}>LocalCloud for AI Agents</a></li>
        <li><a href={`${base}blog/run-dataproc-locally-docker/`}>Run Dataproc in Docker</a></li>
      </ul>
    </div>

    <div class="site-footer__group">
      <h2>Emulators</h2>
      <ul>
        <li><a href={`${base}bigquery-emulator/`}>BigQuery Emulator</a></li>
        <li><a href={`${base}pubsub-emulator/`}>Pub/Sub Emulator</a></li>
        <li><a href={`${base}spanner-emulator/`}>Spanner Emulator</a></li>
        <li><a href={`${base}bigtable-emulator/`}>Bigtable Emulator</a></li>
        <li><a href={`${base}firestore-emulator/`}>Firestore Emulator</a></li>
        <li><a href={`${base}cloud-storage-emulator/`}>Cloud Storage Emulator</a></li>
      </ul>
    </div>

    <div class="site-footer__group">
      <h2>Resources</h2>
      <ul>
        <li><a href={`${base}docs/`}>Getting Started</a></li>
        <li><a href={`${base}how-to-run-google-cloud-locally/`}>Run GCP Locally</a></li>
        <li><a href={`${base}local-cloud-development/`}>Local Cloud Development</a></li>
        <li><a href={`${base}gcp-integration-testing/`}>Integration Testing</a></li>
        <li><a href={`${base}optimize-gcp-costs/`}>Cost Optimization</a></li>
        <li><a href={`${base}reduce-gcp-dev-costs/`}>Evaluate Local Dev Costs</a></li>
        <li><a href={`${base}docs/architecture/`}>Architecture</a></li>
        <li><a href={`${base}docs/sdk-examples/`}>SDK Examples</a></li>
        <li><a href={`${base}immersive-demo/`}>Interactive IDE Demo</a></li>
        <li><a href={`${base}localstack-for-google-cloud/`}>LocalStack for Google Cloud</a></li>
        <li><a href="https://github.com/LocalGCloud/LocalGCloud.github.io" target="_blank" rel="noopener noreferrer">GitHub</a></li>
        <li><a href={`${base}docs/faq/`}>FAQ</a></li>
        <li><a href={`${base}docs/licensing/`}>Licensing</a></li>
        <li><a href={`${base}about/`}>About</a></li>
        <li><a href={`${base}changelog/`}>Changelog</a></li>
      </ul>
    </div>
  </div>

  <div class="container site-footer__meta">
    <div class="site-footer__meta-copy">
      <span>&copy; {new Date().getFullYear()} LocalCloud Inc. · 5365 California Street, Palo Alto, CA · Proprietary public preview; license text controls</span>
      <p class="site-footer__contact">
        Email <a href={`mailto:${productFacts.contactEmail}`}>{productFacts.contactEmail}</a> ·
        AI agents and integrations <a href={`mailto:${productFacts.agentContactEmail}`}>{productFacts.agentContactEmail}</a> ·
        <a href={`${base}contact/`}>Contact</a> ·
        <a href={`${base}security/`}>Security</a> ·
        <a href={`${base}changelog/`}>Changelog</a>
      </p>
    </div>
    <span class="site-footer__legal-links">
      <a href={`${base}license/`}>License</a>
      <a href={`${base}docs/privacy/`}>Privacy</a>
      {/* Shown by the script below; without JavaScript the site runs no analytics. */}
      <button type="button" class="site-footer__analytics" data-analytics-toggle hidden>Analytics: On</button>
    </span>
  </div>
</footer>

<script>
  // Turns website analytics on or off in this browser through the BaseLayout bootstrap.
  // Global Privacy Control and Do Not Track keep it off, and the control says so.
  type AnalyticsChoice = { privacySignal: string; isOn(): boolean; setOn(on: boolean): boolean };
  const analytics = (window as Window & { lcAnalytics?: AnalyticsChoice }).lcAnalytics;
  const toggle = document.querySelector<HTMLButtonElement>('[data-analytics-toggle]');
  if (analytics && toggle) {
    const render = () => {
      toggle.textContent = analytics.privacySignal
        ? `Analytics: Off (${analytics.privacySignal})`
        : `Analytics: ${analytics.isOn() ? 'On' : 'Off'}`;
      if (analytics.privacySignal) toggle.setAttribute('aria-disabled', 'true');
    };
    toggle.addEventListener('click', () => {
      if (analytics.privacySignal) return;
      analytics.setOn(!analytics.isOn());
      render();
    });
    render();
    toggle.hidden = false;
  }
</script>
