---
import LandingLayout from '../layouts/LandingLayout.astro';
import ServiceIcon from './ServiceIcon.astro';
import { getServiceSignalLabel, isServiceDisabledByDefault, optInStartCommand, services } from '../data/services';
import ServiceTier from './ServiceTier.astro';
import { serviceCompatibilityEditorial } from '../data/serviceEditorial';
import { agentTestingPath, relatedAnchor } from '../data/relatedPages';
import {
  createBreadcrumbSchema,
  createWebPageSchema,
  productFacts,
} from '../data/productFacts';

interface Props { slug: string; title: string; description: string; }
const { slug, title, description } = Astro.props;
const service = services.find((item) => item.slug === slug);
if (!service) throw new Error(`Missing service contract for ${slug}`);
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const isComingSoon = service.catalogState === 'coming-soon';
const isUnsupported = service.status === 'unsupported' || service.status === 'unknown';
const documentedOperations = isComingSoon
  ? []
  : service.operations.filter((operation) => operation.status !== 'unsupported' && operation.status !== 'unknown');
// The same curated boundaries as /compatibility/ and the service guide; the operation
// ledger stays on the service guide and the /docs/ feature references.
const compatibility = serviceCompatibilityEditorial[service.id];
if (!compatibility) throw new Error(`Missing compatibility editorial for ${service.id}`);
const featureReference = ['bigquery', 'spanner', 'bigtable'].includes(service.slug) ? `${base}docs/${service.slug}-emulator-features/` : undefined;
// Labels contain commas, so a mid-sentence list joins them with semicolons and lowercases
// a leading capitalized word ("Native SQL" -> "native SQL"); acronyms and names keep their case.
const properNouns = new Set(['Google', 'Redis', 'Valkey', 'Docker', 'Terraform', 'Spark']);
const midSentence = (label: string) =>
  label.replace(/^([A-Z])([a-z]+)(?=[\s,]|$)/, (word, first, rest) => (properNouns.has(word) ? word : first.toLowerCase() + rest));

// Astro.url.pathname is the emulator landing route (for example /bigquery-emulator/).
const pageUrl = new URL(Astro.url.pathname, productFacts.siteUrl).toString();

// FAQ answers are generated from the service contract so they stay accurate as
// the upstream documentation snapshot changes.
const faqItems = isUnsupported || isComingSoon
  ? [{ q: `Can I use ${service.name} in LocalCloud?`, a: `No. ${service.name} is not available locally, so there is no local endpoint to configure. Use Google Cloud for this service.` }]
  : [
      {
        q: `How do I run ${service.name} locally?`,
        a: `Install the LocalCloud host CLI, start the runtime, and use the generated endpoint values in your application. Configure explicit client endpoint options when the SDK does not read an emulator variable. Validate the exact client and operation against the local endpoint.`,
      },
      {
        q: `Which environment variable points the SDK at the local ${service.name}?`,
        a: `LocalCloud exports ${service.envVar}. Use the generated value: if a default port is already in use, the CLI picks another one. Some SDKs also require explicit client options; exporting an environment variable alone does not establish local routing.`,
      },
      {
        q: `What ${service.name} workflows are documented locally?`,
        a: `${documentedOperations.length} ${service.name} workflows are documented with operation-level status: ${documentedOperations.slice(0, 6).map((operation) => midSentence(operation.label)).join('; ')}${documentedOperations.length > 6 ? '; and more' : ''}. The compatibility matrix lists the status of every operation.`,
      },
      {
        q: `Does the local ${service.name} behave exactly like Google Cloud?`,
        a: `No. LocalCloud implements documented local workflows with published boundaries, and compatibility is narrower than managed Google Cloud. Validate behavior against real ${service.name} before production deployment.`,
      },
      {
        q: `Can an AI coding agent use the local ${service.name}?`,
        a: `Yes. Because no cloud credentials or billing project are required by default, agent-written ${service.name} code can run against localhost without creating real cloud resources or charges.`,
      },
    ];

const pageTitle = isUnsupported || isComingSoon ? `${service.name} — Unsupported in LocalCloud` : title;
const pageDescription = isUnsupported ? service.description : description;
const structuredData = [
  createWebPageSchema({ url: pageUrl, name: pageTitle, description: pageDescription }),
  createBreadcrumbSchema([
    { name: 'Home', url: productFacts.siteUrl },
    { name: 'Services', url: new URL('services/', productFacts.siteUrl).toString() },
    { name: `${service.name} Emulator`, url: pageUrl },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<LandingLayout title={pageTitle} description={pageDescription} {structuredData}>
  <section class="site-section site-section--hero"><div class="container"><div class="max-w-[52rem]">
    <div class="flex items-center gap-4"><span class="flex h-16 w-16 items-center justify-center rounded-2xl bg-[var(--surface)]"><ServiceIcon iconId={service.iconId} name={service.name} size={44} loading="eager" /></span><span class:list={['site-chip', isUnsupported || isComingSoon ? 'site-chip--warn' : 'site-chip--accent']}>{getServiceSignalLabel(service)}</span></div>
    <h1 class="mt-6">{isUnsupported || isComingSoon ? `${service.name} is unsupported in LocalCloud` : `Run ${service.name} workflows locally`}</h1>
    <p class="mt-6 text-lg leading-8 text-[var(--text-2)]">{service.description}</p>
    {!isUnsupported && isServiceDisabledByDefault(service) && (
      <p class="mt-3 text-sm leading-6 text-[var(--accent-strong)]">{service.name} is opt-in to save memory. Add <code>{service.id}</code> to the services you start, for example <code>{optInStartCommand(service)}</code>; <code>--services</code> sets the exact list.</p>
    )}
    <div class="mt-8 flex flex-wrap gap-3"><a class="site-button site-button--primary" href={`${base}services/${service.slug}/`}>View service guide</a><a class="site-button site-button--secondary" href={`${base}compatibility/`}>Compatibility matrix</a><a class="site-button site-button--secondary" href={`${base}gcp-emulator/`}>All local GCP services</a></div>
  </div></div></section>

  {!isComingSoon && (
    <section class="site-section"><div class="container grid gap-4 lg:grid-cols-2">
      <article class="site-panel p-6"><h2>Runtime details</h2><dl class="mt-5 grid grid-cols-2 gap-4 text-sm">
        <div><dt class="font-semibold">Endpoints</dt><dd>{service.endpointLabel}</dd></div>
        <div><dt class="font-semibold">Minimum tier</dt><dd><ServiceTier service={service} /></dd></div>
        <div><dt class="font-semibold">Persistence</dt><dd>{service.persistence.scope}</dd></div>
        <div><dt class="font-semibold">Documented workflows</dt><dd>{documentedOperations.length}</dd></div>
      </dl></article>
      <article class="site-panel p-6"><h2>Documented workflows</h2><ul class="site-list mt-5">{documentedOperations.map((operation) => <li><span><strong>{operation.label}</strong></span></li>)}</ul></article>
      <article class="site-panel site-panel--soft p-6 lg:col-span-2">
        <h2>Service boundaries</h2>
        <ul class="site-list mt-5">
          {compatibility.boundaries.map((item) => <li><span>{item}</span></li>)}
        </ul>
        <p class="mt-5 text-sm leading-7 text-[var(--text-2)]">The <a href={`${base}services/${service.slug}/`}>{relatedAnchor(`/services/${service.slug}/`)}</a> lists every documented workflow{featureReference ? <>, and the <a href={featureReference}>feature reference</a> covers each operation and recovery behavior in detail</> : ''}.</p>
      </article>
    </div></section>
  )}

  <section class="site-section site-section--tight"><div class="container">
    <div class="site-section-heading reveal">
      <span class="site-kicker">FAQ</span>
      <h2>Common questions</h2>
    </div>
    <div class="mt-6 grid gap-4">
      {faqItems.map((faq) => (
        <article class="site-panel p-5 reveal">
          <h3 class="text-lg">{faq.q}</h3>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">{faq.a}</p>
        </article>
      ))}
    </div>
  </div></section>

  <section class="site-section site-section--tight"><div class="container">
    <div class="site-section-heading reveal">
      <span class="site-kicker">Keep reading</span>
      <h2>Related pages</h2>
    </div>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {!isComingSoon && !isUnsupported && (
        <a href={`${base}${agentTestingPath(service.slug).slice(1)}`} class="site-panel p-5 reveal transition-transform hover:-translate-y-0.5">
          <h3 class="text-lg">{relatedAnchor(agentTestingPath(service.slug))}</h3>
          <p class="mt-2 text-sm leading-7 text-[var(--text-2)]">Point an AI coding agent at the local {service.name} endpoint.</p>
        </a>
      )}
      <a href={`${base}local-cloud-for-ai-agents/`} class="site-panel p-5 reveal transition-transform hover:-translate-y-0.5">
        <h3 class="text-lg">Local cloud for AI agents</h3>
        <p class="mt-2 text-sm leading-7 text-[var(--text-2)]">Why an agent needs a cloud API target, not only a code sandbox.</p>
      </a>
      <a href={`${base}gcp-integration-testing/`} class="site-panel p-5 reveal transition-transform hover:-translate-y-0.5">
        <h3 class="text-lg">Integration testing</h3>
        <p class="mt-2 text-sm leading-7 text-[var(--text-2)]">Run local Google Cloud checks with health gates and pinned images.</p>
      </a>
    </div>
  </div></section>

  <section class="site-section site-section--tight"><div class="container"><aside class="callout callout--warning"><div class="callout__body"><p class="callout__title">Local development boundary</p><div class="callout__content"><p>Review the governing proprietary license before use. Validate production behavior separately against real Google Cloud.</p></div></div></aside></div></section>
</LandingLayout>
