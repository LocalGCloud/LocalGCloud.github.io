---
import CodeTabs from './CodeTabs.astro';
import CopyButton from './CopyButton.astro';
import { docsContract } from '../data/docs-contract';
import { productFacts } from '../data/productFacts';

const launchCommand = "localcloud start\nlocalcloud console";
---

<section
  id="manual-quickstart"
  class="installation-methods"
  aria-labelledby="manual-quickstart-title"
>
  <div class="installation-methods__panel reveal">
    <header class="installation-methods__header">
      <span class="installation-methods__kicker">Quick Start</span>
      <h2 id="manual-quickstart-title" class="installation-methods__title">Install, start, connect.</h2>
      <p class="installation-methods__lede">Requires docker.</p>
    </header>

    <ol class="installation-methods__workflow">
      <li class="installation-methods__workflow-step">
        <div class="installation-methods__step-copy">
          <span class="installation-methods__step" aria-hidden="true">1</span>
          <h3>Install the CLI</h3>
          <p>Choose the installation channel for your host.</p>
        </div>

        <div class="installation-methods__step-content">
          <CodeTabs labels={['Install script', 'Homebrew']}>
            <Fragment slot="tab-0">
              <div class="installation-methods__command">
                <pre tabindex="0" aria-label="Install LocalCloud with the install script"><code>{productFacts.installScriptCommand}</code></pre>
                <CopyButton
                  text={productFacts.installScriptCommand}
                  class="installation-methods__copy"
                  analyticsLabel="homepage-install-script"
                />
              </div>
            </Fragment>
            <Fragment slot="tab-1">
              <div class="installation-methods__command">
                <pre tabindex="0" aria-label="Install LocalCloud with Homebrew"><code>{productFacts.homebrewInstallCommand}</code></pre>
                <CopyButton
                  text={productFacts.homebrewInstallCommand}
                  class="installation-methods__copy"
                  analyticsLabel="homepage-homebrew"
                />
              </div>
            </Fragment>
          </CodeTabs>
        </div>
      </li>

      <li class="installation-methods__workflow-step">
        <div class="installation-methods__step-copy">
          <span class="installation-methods__step" aria-hidden="true">2</span>
          <h3>Start LocalCloud and open the console</h3>
          <p>If canonical ports are occupied, the CLI dynamically remaps host ports — use the endpoint values it returns.</p>
        </div>

        <div class="installation-methods__step-content">
          <div class="installation-methods__command">
            <pre tabindex="0" aria-label="Start LocalCloud and open its console"><code>{launchCommand}</code></pre>
            <CopyButton text={launchCommand} class="installation-methods__copy" />
          </div>
        </div>
      </li>
    </ol>

    <p class="installation-methods__meta">
      Reviewed CLI source {docsContract.provenance.cliRevision.slice(0, 12)} ·
      <a href={`${productFacts.cliRepositoryUrl}/releases`}>Checksums and Sigstore bundles</a> ·
      <a href={productFacts.homebrewTapUrl}>Homebrew tap</a> ·
      <a href="/docs/licensing/">License terms</a>
    </p>
  </div>
</section>

<style>
  .installation-methods {
    position: relative;
    z-index: 1;
    scroll-margin-top: 5rem;
    padding: 0 1rem;
  }

  .installation-methods__panel {
    width: min(100%, 64rem);
    margin-inline: auto;
    padding: clamp(1.15rem, 2.4vw, 1.75rem);
    border: 1px solid var(--line);
    border-radius: 1.25rem;
    background:
      radial-gradient(120% 100% at 50% 0%, rgba(232, 240, 254, 0.85), transparent 62%),
      var(--surface);
    box-shadow: var(--shadow-md);
  }

  .installation-methods__header {
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    text-align: center;
  }

  .installation-methods__kicker,
  .installation-methods__step {
    font-family: var(--font-mono);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-strong);
  }

  .installation-methods__kicker {
    font-size: 0.72rem;
  }

  .installation-methods__title {
    margin: 0;
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .installation-methods__lede {
    max-width: 62ch;
    color: var(--text-2);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .installation-methods__workflow {
    display: grid;
    gap: 1rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .installation-methods__workflow-step {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: 0.75rem;
    min-width: 0;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.72);
  }

  .installation-methods__step-copy {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.3rem 0.6rem;
    align-content: start;
    align-items: center;
    min-width: 0;
  }

  .installation-methods__step {
    display: inline-grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-strong);
    font-size: 0.8rem;
    letter-spacing: 0;
  }

  .installation-methods__step-copy h3 {
    color: var(--text);
    font-size: 1.02rem;
    line-height: 1.25;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .installation-methods__step-copy p {
    grid-column: 2;
    color: var(--text-2);
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .installation-methods__step-content {
    display: grid;
    align-content: end;
    min-width: 0;
  }

  .installation-methods :global(.code-tabs) {
    display: grid;
    margin: 0;
    overflow: visible;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .installation-methods :global(.code-tabs__bar) {
    gap: 0.25rem;
    margin-bottom: 0.35rem;
    border-bottom: 0;
    background: transparent;
  }

  .installation-methods :global(.code-tabs__tab) {
    flex: 0 0 auto;
    justify-content: center;
    min-height: 2.25rem;
    padding: 0 0.7rem;
    font-size: 0.8rem;
  }

  .installation-methods :global(.code-tabs__panel) {
    min-width: 0;
  }

  .installation-methods__command {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    margin-top: auto;
    max-width: 100%;
    min-width: 0;
    border: 1px solid rgba(26, 115, 232, 0.16);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--accent-soft) 58%, var(--surface));
  }

  .installation-methods__command pre {
    width: auto;
    max-width: 100%;
    min-width: 0;
    min-height: 2.75rem;
    padding: 0;
    overflow: visible;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  /* Wrap rather than scroll: the panel is narrow, and a clipped command is unusable. */
  .installation-methods__command pre > code {
    box-sizing: border-box;
    display: block;
    width: 100%;
    padding: 0.7rem 0.85rem;
    color: var(--text);
    font-size: 0.84rem;
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: break-word;
  }

  .installation-methods__command ::selection {
    background: rgba(26, 115, 232, 0.2);
    color: var(--text);
  }

  /* Concentric: 0.75rem command-box radius - 0.25rem margin = 0.5rem. */
  .installation-methods__command :global(.installation-methods__copy) {
    position: static;
    align-self: center;
    margin: 0.25rem;
    transform: none;
    border-color: rgba(26, 115, 232, 0.18);
    border-radius: 0.5rem;
    background: var(--surface);
    color: var(--accent-strong);
  }

  .installation-methods__command :global(.installation-methods__copy:hover) {
    border-color: var(--border-hover);
    background: var(--surface);
  }

  .installation-methods__meta {
    margin-top: 1rem;
    color: var(--text-2);
    font-size: 0.76rem;
    line-height: 1.65;
    text-align: center;
    text-wrap: balance;
  }

  .installation-methods__meta a {
    text-decoration: underline;
    text-decoration-color: rgba(21, 87, 176, 0.3);
    text-underline-offset: 0.18em;
  }

  @media (min-width: 860px) {
    .installation-methods__workflow {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 759px) {
    .installation-methods__panel {
      padding: 1rem;
    }

    .installation-methods__step-copy p {
      grid-column: 1 / -1;
    }
  }

  /* Narrow screens: give the command the full box width so URLs don't break mid-token. */
  @media (max-width: 560px) {
    .installation-methods__command {
      grid-template-columns: minmax(0, 1fr);
    }

    .installation-methods__command pre > code {
      padding: 0.7rem 0.7rem 0.3rem;
      font-size: 0.8rem;
    }

    .installation-methods__command :global(.installation-methods__copy) {
      justify-self: end;
      margin: 0 0.25rem 0.25rem;
    }
  }
</style>
