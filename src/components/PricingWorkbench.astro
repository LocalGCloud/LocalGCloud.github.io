---
import { publicPreviewPriceLabel } from '../data/productFacts';
import { pricingFaq } from '../data/pricingFaq';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const docsHref = `${base}docs/`;
const licenseHref = `${base}license/`;
const siteHref = (path: string) => `${base}${path.replace(/^\//, '')}`;

const workflows = [
  {
    number: '01',
    title: 'Local development',
    description: 'Build and debug against local Google Cloud endpoints.',
  },
  {
    number: '02',
    title: 'Testing',
    description: 'Exercise supported workflows without creating real cloud resources.',
  },
  {
    number: '03',
    title: 'Internal CI',
    description: 'Run ongoing automation on Docker-capable team runners.',
  },
  {
    number: '04',
    title: 'Evaluation and pilots',
    description: 'Let your organization validate LocalCloud in internal environments.',
  },
];
---

<section class="preview-workbench" aria-labelledby="preview-workbench-title">
  <div class="preview-workbench__shell">
    <header class="preview-workbench__hero">
      <div>
        <span class="preview-workbench__kicker">Public preview</span>
        <h1 id="preview-workbench-title">
          Free to use<br /><span>during public preview.</span>
        </h1>
      </div>
      <p>
        Individuals, teams, nonprofits, and companies can use LocalCloud for local development,
        testing, CI, evaluation, and internal pilots.
      </p>
    </header>

    <div class="preview-workbench__board">
      <div class="preview-workbench__status">
        <span class="preview-workbench__status-label">
          <span class="preview-workbench__status-light" aria-hidden="true"></span>
          Preview access
        </span>
        <span class="preview-workbench__status-value">Available to everyone</span>
      </div>

      <div class="preview-workbench__offer">
        <article class="preview-workbench__summary" aria-labelledby="preview-plan-title">
          <span class="preview-workbench__label">One plan</span>
          <h2 id="preview-plan-title">Free</h2>
          <p><strong>{publicPreviewPriceLabel}</strong> during public preview. No payment method or license key required.</p>

          <div class="preview-workbench__actions">
            <a class="site-button site-button--primary preview-workbench__button" href={docsHref}>
              Get started <span aria-hidden="true">→</span>
            </a>
            <a class="preview-workbench__text-link" href={licenseHref}>View license</a>
          </div>
        </article>

        <div class="preview-workbench__workflows" aria-label="Included public preview workflows">
          <span class="preview-workbench__label">Included workflows</span>
          <div class="preview-workbench__workflow-grid">
            {workflows.map((workflow) => (
              <article>
                <span aria-hidden="true">{workflow.number}</span>
                <div>
                  <h3>{workflow.title}</h3>
                  <p>{workflow.description}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>

    <section id="faq" class="preview-faq" aria-labelledby="preview-faq-title">
      <span class="preview-workbench__label">Questions</span>
      <h2 id="preview-faq-title">Pro tier and the end of the preview</h2>
      <div class="preview-faq__list">
        {pricingFaq.map((entry) => (
          <article id={entry.id} class="preview-faq__item" aria-labelledby={`${entry.id}-question`}>
            <h3 id={`${entry.id}-question`}>{entry.question}</h3>
            <p>{entry.answer}</p>
            <a class="preview-faq__source" href={siteHref(entry.source.href)}>{entry.source.label}</a>
          </article>
        ))}
      </div>
      <p class="preview-faq__note">These answers summarize the license; the <a href={licenseHref}>full license text</a> controls.</p>
    </section>
  </div>
</section>

<style>
  .preview-workbench {
    min-height: calc(100vh - 4.5rem);
    padding: clamp(3.5rem, 8vw, 7.5rem) 0 6rem;
  }

  /* Same outer width as .container so edges line up with the header. */
  .preview-workbench__shell {
    width: min(100% - 2rem, 78rem);
    margin: 0 auto;
  }

  /* One column: promise, then the supporting line directly beneath it. */
  .preview-workbench__hero {
    display: grid;
    gap: 1.25rem;
    padding-bottom: 2.5rem;
  }

  .preview-workbench__kicker,
  .preview-workbench__label,
  .preview-workbench__status {
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  .preview-workbench__kicker,
  .preview-workbench__label {
    color: var(--accent-strong);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  .preview-workbench__hero h1 {
    max-width: 58rem;
    margin-top: 0.85rem;
    font-size: var(--fs-headline);
    font-weight: 650;
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .preview-workbench__hero > p {
    max-width: 40rem;
    color: var(--text-2);
    font-size: var(--fs-lead);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .preview-workbench__board {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
    background: var(--surface);
    box-shadow: var(--shadow-md);
  }

  .preview-workbench__status {
    display: flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1.15rem;
    border-bottom: 1px solid var(--line);
    background: var(--surface-2);
    color: var(--text-2);
    font-size: var(--fs-label);
    letter-spacing: 0.09em;
  }

  .preview-workbench__status-label {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .preview-workbench__status-light {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 0 0.25rem var(--success-soft);
  }

  .preview-workbench__status-value {
    color: var(--success-ink);
    font-weight: 600;
  }

  .preview-workbench__offer {
    display: grid;
    grid-template-columns: minmax(18rem, 0.8fr) minmax(0, 1.45fr);
  }

  .preview-workbench__summary {
    display: flex;
    flex-direction: column;
    padding: clamp(2rem, 5vw, 4rem);
    border-right: 1px solid var(--line);
  }

  .preview-workbench__summary h2 {
    margin-top: 0.55rem;
    font-size: var(--fs-headline);
    font-weight: 650;
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .preview-workbench__summary > p {
    max-width: 21rem;
    margin-top: 1.6rem;
    color: var(--text-2);
    font-size: var(--fs-body);
    line-height: 1.65;
    text-wrap: balance;
  }

  .preview-workbench__actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: auto;
    padding-top: 2.5rem;
  }

  /* Shared primary button; only the arrow spacing is local. */
  .preview-workbench__button {
    gap: 1.5rem;
  }

  .preview-workbench__text-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--text-2);
    font-size: var(--fs-small);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.25rem;
  }

  .preview-workbench__workflows {
    padding: clamp(2rem, 5vw, 4rem);
  }

  .preview-workbench__workflow-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 1.35rem;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .preview-workbench__workflow-grid article {
    display: grid;
    min-height: 10rem;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 1rem;
    align-content: start;
    padding: 1.35rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .preview-workbench__workflow-grid article > span {
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
  }

  .preview-workbench__workflow-grid h3 {
    font-size: var(--fs-body);
    letter-spacing: -0.02em;
  }

  .preview-workbench__workflow-grid p {
    margin-top: 0.55rem;
    color: var(--text-2);
    font-size: var(--fs-small);
    line-height: 1.58;
    text-wrap: pretty;
  }

  .preview-faq {
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  .preview-faq h2 {
    margin-top: 0.85rem;
    font-size: var(--fs-section);
    font-weight: 650;
    letter-spacing: -0.03em;
  }

  .preview-faq__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 1.5rem;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .preview-faq__item {
    padding: 1.5rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 6rem;
  }

  .preview-faq__item h3 {
    font-size: var(--fs-body);
    letter-spacing: -0.02em;
  }

  .preview-faq__item p {
    margin-top: 0.6rem;
    color: var(--text-2);
    font-size: var(--fs-small);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .preview-faq__source,
  .preview-faq__note a {
    color: var(--text-2);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.25rem;
  }

  .preview-faq__source {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    margin-top: 0.35rem;
    font-size: var(--fs-small);
  }

  .preview-faq__note {
    margin-top: 1.25rem;
    color: var(--text-2);
    font-size: var(--fs-small);
  }

  @media (max-width: 840px) {
    .preview-faq__list {
      grid-template-columns: 1fr;
    }

    .preview-workbench__offer {
      grid-template-columns: 1fr;
    }

    .preview-workbench__summary {
      min-height: auto;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .preview-workbench__actions {
      margin-top: 2.5rem;
    }
  }

  @media (max-width: 560px) {
    .preview-workbench {
      padding-top: 2.5rem;
    }

    .preview-workbench__status {
      align-items: flex-start;
      flex-direction: column;
    }

    .preview-workbench__workflow-grid {
      grid-template-columns: 1fr;
    }

    .preview-workbench__workflow-grid article {
      min-height: auto;
    }

    .preview-workbench__actions {
      align-items: flex-start;
      flex-direction: column;
    }
  }

</style>
