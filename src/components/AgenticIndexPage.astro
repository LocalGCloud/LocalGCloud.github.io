---
import LandingLayout from '../layouts/LandingLayout.astro';
import { createBreadcrumbSchema, productFacts } from '../data/productFacts';
import type { AgenticContentPage, ContentLink } from '../data/agenticContent';

// A hub lists its own section's pages and may add a page that lives at another URL, such
// as /localstack-for-google-cloud/ on /compare/.
type HubEntry = Pick<AgenticContentPage, 'path' | 'eyebrow' | 'h1' | 'description' | 'summary' | 'quickFacts'>;

interface Props {
  title: string;
  description: string;
  h1: string;
  eyebrow: string;
  deck: string;
  pages: HubEntry[];
  // Names what the list holds, for example "Comparisons" or "Terms".
  listHeading: string;
  // Other hubs to send readers to after the list, one link each.
  sectionLinks?: ContentLink[];
}

const { title, description, h1, eyebrow, deck, pages, listHeading, sectionLinks = [] } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const localHref = (href: string) => href.startsWith('http') ? href : `${base}${href.replace(/^\//, '')}`;
const structuredData = [createBreadcrumbSchema([{ name: 'Home', url: productFacts.siteUrl }, { name: h1 }])];
---

<LandingLayout title={title.includes('LocalCloud') ? title : `${title} — LocalCloud`} {description} {structuredData}>
  <section class="site-section site-section--hero">
    <div class="container">
      <div class="max-w-[54rem]">
        <span class="site-eyebrow"><span class="site-eyebrow__pulse"></span>{eyebrow}</span>
        <h1 class="mt-4">{h1}</h1>
        <p class="mt-6 text-lg leading-8 text-[var(--text-2)] sm:text-xl">{deck}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={localHref('/ai/')} class="site-button">AI onboarding</a>
          <a href={localHref('/compatibility/')} class="site-button site-button--secondary">Compatibility</a>
          <a href={localHref('/docs/')} class="site-button site-button--secondary">Docs</a>
        </div>
      </div>
    </div>
  </section>

  {/* Optional hub-specific content between the hero and the page list, such as the /compare/ table. */}
  <slot />

  <section class="site-section">
    <div class="container">
      <div class="reveal">
        <h2>{listHeading}</h2>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {pages.map((page) => (
          <article class="site-panel min-w-0 p-6 reveal [overflow-wrap:anywhere]">
            <span class="site-kicker">{page.eyebrow}</span>
            <h3 class="mt-3 text-xl"><a href={localHref(page.path)}>{page.h1}</a></h3>
            {/* A glossary card shows the term's one-sentence definition. */}
            <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">{page.summary ?? page.description}</p>
            {page.quickFacts.length > 0 && (
              <ul class="site-list mt-4">
                {page.quickFacts.slice(0, 2).map((fact) => <li>{fact}</li>)}
              </ul>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  {sectionLinks.length > 0 && (
    <section class="site-section site-section--tight">
      <div class="container">
        <div class="reveal">
          <h2>Browse by section</h2>
        </div>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
          {sectionLinks.map((link) => (
            <li class="site-panel min-w-0 p-6 reveal">
              <h3 class="text-xl"><a href={localHref(link.href)}>{link.label}</a></h3>
              <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">{link.note}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</LandingLayout>
