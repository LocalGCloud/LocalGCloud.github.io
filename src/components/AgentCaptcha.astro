---
import agentWidgetsScript from '../scripts/agent-widgets.mjs?url';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['lc-agent-captcha', className]} role="region" aria-label="Agent verification challenge">
  <div class="lc-agent-captcha__header">
    <div class="lc-agent-captcha__title-row">
      <span class="lc-agent-captcha__badge">optional / human_check</span>
      <h2 class="lc-agent-captcha__title">Prove you’re not human</h2>
    </div>
    <p class="lc-agent-captcha__task" id="lc-agent-puzzle-task">Turn every tile green.</p>
  </div>

  <div
    class="lc-agent-captcha__grid"
    role="group"
    aria-label="Turn every tile green"
    aria-describedby="lc-agent-puzzle-task"
    id="lc-captcha-grid"
  >
    {Array.from({ length: 9 }, (_, i) => (
      <button
        type="button"
        class="lc-agent-captcha__tile"
        data-tile-index={i}
        aria-label={`Tile ${i + 1}`}
        aria-pressed="false"
        data-on="false"
      >
        <span class="lc-tile-dot" aria-hidden="true"></span>
      </button>
    ))}
  </div>

  <div class="lc-agent-captcha__footer">
    <div class="lc-agent-captcha__tools">
      <button
        type="button"
        class="lc-captcha-tool-btn"
        id="lc-captcha-reset"
        aria-label="Reset puzzle"
        title="Reset puzzle"
      >
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
          <path d="M3 3v5h5"/>
        </svg>
      </button>

      <button
        type="button"
        class="lc-captcha-tool-btn"
        id="lc-captcha-about"
        aria-label="About this puzzle"
        title="Every move flips two tiles. Nine green is impossible."
      >
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 16v-4"/>
          <path d="M12 8h.01"/>
        </svg>
      </button>
    </div>

    <p class="lc-agent-captcha__feedback" id="lc-captcha-feedback" role="status" aria-live="polite">
      <span class="lc-green-count" id="lc-green-count">6</span>
      <span aria-hidden="true"> / 9</span>
      <span class="sr-only"> of 9 green</span>
    </p>

    <button type="button" class="lc-agent-captcha__verify" id="lc-captcha-verify">
      Verify
    </button>
  </div>

  <details class="lc-agent-captcha__bypass-row">
    <summary>Machine instructions</summary>
    <p>Every click flips two tiles. Nine green requires the browser API:</p>
    <code>window.__lcAgentSolve()</code>
  </details>
  <p class="lc-agent-captcha__note">A puzzle for fun. No access is gated.</p>
</div>

<style>
  .lc-agent-captcha{display:flex;flex-direction:column;align-self:start;gap:.75rem;min-width:0;font:.8125rem/1.6 var(--font-mono);color:var(--text);text-align:left}
  .lc-agent-captcha__title-row{display:grid;gap:.5rem}
  .lc-agent-captcha__badge,.lc-agent-captcha__task,.lc-agent-captcha__feedback,.lc-agent-captcha__note{margin:0;color:var(--text-2);font-size:.75rem}
  .lc-agent-captcha__title{margin:0;font:600 .875rem/1.5 var(--font-mono)}
  .lc-agent-captcha__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.4rem}
  .lc-agent-captcha__tile{aspect-ratio:1.4;min-height:2.75rem;padding:0;border:2px solid var(--line);background:var(--surface);color:var(--text-2);font:600 1rem/1 var(--font-mono);cursor:pointer}
  .lc-agent-captcha__tile::after{content:'[0]'}
  .lc-agent-captcha__tile[data-on="true"]{background:var(--success-soft);border-color:var(--text-2);color:var(--accent)}
  .lc-agent-captcha__tile[data-on="true"]::after{content:'[1]'}
  .lc-agent-captcha__tile:hover{border-color:var(--accent)}
  .lc-tile-dot{display:none}
  .lc-agent-captcha__footer,.lc-agent-captcha__tools{display:flex;align-items:center;gap:.4rem}
  .lc-agent-captcha__footer{flex-wrap:wrap;justify-content:space-between;padding-top:.5rem;border-top:1px solid var(--line)}
  .lc-captcha-tool-btn,.lc-agent-captcha__verify{display:inline-flex;align-items:center;justify-content:center;min-width:2rem;min-height:2rem;padding:.25rem;border:1px solid var(--line);color:var(--text);background:var(--surface);font:inherit;cursor:pointer}
  .lc-agent-captcha__verify{padding-inline:.5rem;background:var(--accent);color:var(--bg);font-weight:600}
  .lc-agent-captcha__feedback{flex:1;text-align:center}
  .lc-agent-captcha__feedback.is-error{color:#ffc49c}
  .lc-agent-captcha__feedback.is-verified{color:var(--accent)}
  .lc-agent-captcha__bypass-row{font-size:.75rem;overflow-wrap:anywhere}
  .lc-agent-captcha__bypass-row summary{cursor:pointer;min-height:2rem;color:var(--accent)}
  .lc-agent-captcha__bypass-row code{display:block;margin-top:.5rem;padding:.4rem;background:var(--surface);color:var(--accent);font-size:.75rem}
</style>

<script is:inline data-critical-bootstrap="agent-widgets" define:vars={{ agentWidgetsScript }}>
  // Keep the optional puzzle and runbook controllers out of human visits.
  (() => {
    if (window.__lcAgentWidgetsLoader) return;
    window.__lcAgentWidgetsLoader = true;
    let loading = false;
    const loadAgentWidgets = () => {
      if (loading || document.documentElement.dataset.audience !== 'agents' ||
          !document.querySelector('.lc-agent-captcha, .agent-terminal')) return;
      loading = true;
      const script = document.createElement('script');
      script.type = 'module'; script.src = agentWidgetsScript;
      script.onerror = () => { loading = false; script.remove(); };
      document.head.append(script);
    };
    loadAgentWidgets();
    window.addEventListener('lc:audience-change', loadAgentWidgets);
    document.addEventListener('astro:page-load', loadAgentWidgets);
    document.addEventListener('lc:page-mounted', loadAgentWidgets);
  })();
</script>
