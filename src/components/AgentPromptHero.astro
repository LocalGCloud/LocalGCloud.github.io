---
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---
<section class="lc-agent-start" aria-labelledby="agent-bootstrap-title">
  <h2 id="agent-bootstrap-title">Start with context</h2>
  <p>Read the setup instructions, inspect the repository, configure local endpoints, and verify the first SDK call.</p>
  <a href={base + 'ai/agent-template.md'}>https://local.cloud/ai/agent-template.md</a>
</section>
<style>
 h2{margin:0 0 12px;color:var(--accent);font:600 16px/1.5 var(--font-mono)}
 p{margin:0 0 14px;color:var(--text-2)}
 a{color:var(--accent);text-decoration:underline;text-underline-offset:4px;overflow-wrap:anywhere}
</style>
