---
interface Props {
  size?: number;
  alt?: string;
  class?: string;
}

import brandMark from '../../public/brand/localcloud-mark.svg?url';
const { size = 42, alt = '', class: className = '' } = Astro.props;
const decorative = alt.length === 0;
---

<img
  src={brandMark}
  alt={alt}
  aria-hidden={decorative ? 'true' : undefined}
  class:list={['brand-mark', className]}
  width={size}
  height={size}
/>
