---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HomepageVariationFieldManual from '../components/HomepageVariationFieldManual.astro';
import { localCloudProductSchema } from '../data/productFacts';
---

<BaseLayout title="LocalCloud — Local Google Cloud Emulator in Docker" description="Start a loopback-bound LocalCloud runtime selected by Docker data volume, export actual SDK endpoints, and review evidence-backed compatibility limits for local Google Cloud workflows." structuredData={[localCloudProductSchema]}>
  <link slot="head" rel="preload" as="image" href={`${import.meta.env.BASE_URL}illustrations/hero-laptop-service-grid.svg`} fetchpriority="high" />
  <Header />
  <HomepageVariationFieldManual />
  <Footer />
</BaseLayout>
