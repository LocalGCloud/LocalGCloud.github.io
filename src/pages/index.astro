---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HomepageVariationFieldManual from '../components/HomepageVariationFieldManual.astro';
import { localCloudProductSchema } from '../data/productFacts';
import { homepageFaqSchema } from '../data/homepageFaq';
import { availableServiceCount } from '../data/services';

const title = 'LocalCloud | A Local Cloud for AI Agents';
const description = `A local cloud for AI agents. Run ${availableServiceCount} Google Cloud services in one Docker container for local development and CI.`;
---

<BaseLayout {title} {description} structuredData={[localCloudProductSchema, homepageFaqSchema]}>
  <Header />
  <HomepageVariationFieldManual />
  <Footer />
</BaseLayout>
