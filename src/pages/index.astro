---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HomepageVariationFieldManual from '../components/HomepageVariationFieldManual.astro';
import { localCloudProductSchema } from '../data/productFacts';
---

<BaseLayout title="LocalCloud — Local Google Cloud Emulator in Docker" description="Run BigQuery, Pub/Sub, Spanner, and more Google Cloud services on localhost in one Docker container. The CLI exports SDK endpoints. Free in public preview." structuredData={[localCloudProductSchema]}>
  <link slot="head" rel="preload" as="image" href={`${import.meta.env.BASE_URL}illustrations/hero-laptop-service-grid.svg`} fetchpriority="high" />
  <Header />
  <HomepageVariationFieldManual />
  <Footer />
</BaseLayout>
