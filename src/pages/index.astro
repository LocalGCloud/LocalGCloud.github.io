---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HomepageVariationFieldManual from '../components/HomepageVariationFieldManual.astro';
import { localCloudProductSchema } from '../data/productFacts';
import { homepageFaqSchema } from '../data/homepageFaq';
import { availableServiceCount } from '../data/services';

const title = 'localcloud — cloud for agents';
const description = `Cloud for agents: run ${availableServiceCount} Google Cloud services locally for development, CI and AI coding workflows. Free during the public preview.`;
---

<BaseLayout {title} {description} structuredData={[localCloudProductSchema, homepageFaqSchema]}>
  <Header />
  <HomepageVariationFieldManual />
  <Footer />
</BaseLayout>
