---
import LandingLayout from '../layouts/LandingLayout.astro';
import PricingWorkbench from '../components/PricingWorkbench.astro';
import { createBreadcrumbSchema, localCloudProductSchema, productFacts } from '../data/productFacts';

const pricingUrl = new URL(productFacts.pricingPath, productFacts.siteUrl).toString();

const structuredData = [
  createBreadcrumbSchema([
    { name: 'Home', url: productFacts.siteUrl },
    { name: 'Pricing', url: pricingUrl },
  ]),
  localCloudProductSchema,
];
---

<LandingLayout
  title="LocalCloud Pricing — Free for OSS and Individual Developers"
  description="LocalCloud is free for open-source projects and individual developers beyond the public preview. See development, testing, CI, and release terms."
  {structuredData}
>
  <PricingWorkbench />
</LandingLayout>
