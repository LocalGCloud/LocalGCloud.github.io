---
import LandingLayout from '../layouts/LandingLayout.astro';
import PricingWorkbench from '../components/PricingWorkbench.astro';
import { createBreadcrumbSchema, localCloudProductSchema, productFacts } from '../data/productFacts';

const pricingUrl = new URL(productFacts.pricingPath, productFacts.siteUrl).toString();

const structuredData = [
  createBreadcrumbSchema([
    { name: 'Home', url: productFacts.siteUrl },
    { name: 'Pricing', url: pricingUrl },
  ]),
  localCloudProductSchema,
];
---

<LandingLayout
  title="LocalCloud Pricing — Free During Public Preview"
  description="LocalCloud is free for individuals and organizations during public preview for local development, testing, CI, evaluation, and internal pilots."
  {structuredData}
>
  <PricingWorkbench />
</LandingLayout>
