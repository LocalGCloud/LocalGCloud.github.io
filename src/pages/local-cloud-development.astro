---
import LandingLayout from '../layouts/LandingLayout.astro';
import { docsContract } from '../data/docs-contract';
import { cliQuickStart } from '../utils/quickstart.mjs';
import { availableServiceCount, publishedServiceCount, serviceCatalogGroups } from '../data/services';
import { relatedAnchor } from '../data/relatedPages';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

// A summary of the catalog, not a second copy of it: how many services run locally in
// each category, in the shared catalog order. /services/ lists them.
const serviceGroups = serviceCatalogGroups
  .map((group) => ({
    title: group.title,
    localCount: group.items.filter(
      (service) => service.marketingStatus === 'supported' && service.catalogState === 'available',
    ).length,
  }))
  .filter((group) => group.localCount > 0);

const faqItems = [
  {
    q: 'What is local cloud development?',
    a: 'Local cloud development points supported client workflows at local emulators on localhost instead of production endpoints. Emulator behavior, persistence, IAM, and performance differ from production.',
  },
  {
    q: 'Do I need different tools for each cloud?',
    a: "Yes. Each cloud's SDKs call that provider's APIs, so each cloud needs its own local emulator: LocalStack for AWS and LocalCloud for Google Cloud. The two bind different local ports and set different SDK environment variables, so a team that builds on both clouds can run them side by side.",
  },
  {
    q: 'Can I use LocalCloud in CI/CD?',
    a: 'Yes. The Public Preview License permits non-production internal CI for individuals and organizations, including for-profit companies. Exact runner behavior must still be tested.',
  },
  {
    q: 'Should I test against real Google Cloud before production?',
    a: 'Yes. Local emulation covers documented local workflows and does not reproduce every production behavior. Run final validation against real Google Cloud.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<LandingLayout
  title="Local Google Cloud Development Guide — LocalCloud"
  description="Local Google Cloud development with LocalCloud: run services on your machine, keep data between restarts, and validate in Google Cloud before release."
  {structuredData}
>
  {/* HERO */}
  <section class="site-section site-section--hero">
    <div class="container">
      <div class="max-w-[48rem]">
        <span class="site-eyebrow"><span class="site-eyebrow__pulse"></span>Local-first development</span>
        <h1 class="mt-4">Local cloud development guide</h1>
        <p class="mt-6 text-lg leading-8 text-[var(--text-2)] sm:text-xl">
          Run Google Cloud development workflows on localhost endpoints with LocalCloud, then validate against real Google Cloud before production.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#gcp" class="site-button site-button--primary">Google Cloud setup</a>
          <a href="#best-practices" class="site-button site-button--secondary">Best practices</a>
        </div>
      </div>
    </div>
  </section>

  {/* WHY LOCAL CLOUD */}
  <section class="site-section">
    <div class="container">
      <div class="reveal">
        <h2>Why develop against local cloud services?</h2>
        <p class="mt-4 max-w-[44rem] text-lg leading-8 text-[var(--text-2)]">
          Local emulation provides a controlled inner loop, but does not reproduce production latency, IAM, quotas, or every API behavior. Runtime telemetry and configured features can make outbound requests.
        </p>
      </div>
    </div>
  </section>

  {/* GCP LOCAL DEVELOPMENT */}
  <section class="site-section site-section--tight" id="gcp">
    <div class="container">
      <div class="reveal">
        <h2>Google Cloud local development with LocalCloud</h2>
        <p class="mt-4 max-w-[44rem] text-lg leading-8 text-[var(--text-2)]">
          LocalCloud runs {availableServiceCount} local services in one managed container. Firestore is opt-in. The CLI returns the endpoint settings for the host ports it uses.
        </p>
      </div>

      <div class="mt-8 site-panel p-6 reveal">
        <h3 class="text-lg font-semibold text-[var(--text)]">Quick start</h3>
        <pre class="mt-4 overflow-x-auto text-xs"><code>{cliQuickStart(docsContract).script}</code></pre>
      </div>

      <div class="mt-8 grid gap-6 sm:grid-cols-2 reveal">
        <article class="site-panel min-w-0 p-6">
          <h3 class="text-lg font-semibold text-[var(--text)]">Local services by category</h3>
          <div class="mt-4 space-y-2 text-sm text-[var(--text-2)] leading-7">
            {serviceGroups.map((group) => (
              <div><strong class="text-[var(--text)]">{group.title}:</strong> {group.localCount} {group.localCount === 1 ? 'service' : 'services'}</div>
            ))}
          </div>
          <div class="mt-4">
            <a href={`${base}services/`} class="text-sm text-[var(--accent-strong)] underline">View all {publishedServiceCount} service guides →</a>
          </div>
        </article>

        <article class="site-panel min-w-0 p-6">
          <h3 class="text-lg font-semibold text-[var(--text)]">Key features</h3>
          <div class="mt-4 space-y-2 text-sm text-[var(--text-2)] leading-7">
            <div>• Service-specific gRPC/REST compatibility with documented limits</div>
            <div>• Export local endpoint values with localcloud env</div>
            <div>• Client support varies by service and tested profile</div>
            <div>• Persistence varies by service and backing store</div>
            <div>• Containerized workflows remain subject to the governing license</div>
            <div>• Terraform (hashicorp/google v7) applies the documented resource list locally</div>
            <div>• Native ARM64 support (Apple Silicon)</div>
          </div>
        </article>
      </div>

      <div class="mt-6 reveal">
        <a href={`${base}how-to-run-google-cloud-locally/`} class="site-button site-button--primary">{relatedAnchor('/how-to-run-google-cloud-locally/')}</a>
        <a href={`${base}docs/`} class="ml-3 site-button site-button--secondary">Documentation</a>
      </div>
    </div>
  </section>

  {/* BEST PRACTICES */}
  <section class="site-section" id="best-practices">
    <div class="container">
      <div class="reveal">
        <h2>Best practices for local cloud development</h2>
      </div>
      <div class="mt-8 grid gap-6 reveal">
        <article class="site-panel min-w-0 p-6">
          <h3 class="text-lg font-semibold text-[var(--text)]">1. Environment variable separation</h3>
          <p class="mt-3 text-[var(--text-2)] leading-7">
            Use different environment variables for local vs production. Never accidentally hit production APIs during local development.
          </p>
          <pre class="mt-4 overflow-x-auto rounded-xl bg-[var(--surface-2)] p-3 text-xs"><code># .env.local
BIGQUERY_EMULATOR_HOST=http://localhost:5388
STORAGE_EMULATOR_HOST=http://localhost:5382

# .env.production
# (no emulator variables — uses real GCP)</code></pre>
        </article>

        <article class="site-panel min-w-0 p-6">
          <h3 class="text-lg font-semibold text-[var(--text)]">2. Seed data for testing</h3>
          <p class="mt-3 text-[var(--text-2)] leading-7">
            Pre-populate local services with test data. Can make supported fixtures repeatable. Seed support is service-specific.
          </p>
          <div class="mt-4 space-y-2 text-sm text-[var(--text-2)] leading-7">
            <div>• Create seed scripts that run on container startup</div>
            <div>• Store seed data in version control</div>
            <div>• Use realistic data volumes for performance testing</div>
            <div>• Automate seed data creation in a permitted internal workflow</div>
          </div>
        </article>

        <article class="site-panel min-w-0 p-6">
          <h3 class="text-lg font-semibold text-[var(--text)]">3. Internal automation</h3>
          <p class="mt-3 text-[var(--text-2)] leading-7">
            The Public Preview License permits containerized development and testing for individuals and organizations, including ongoing internal team CI.
          </p>
          <div class="mt-4 space-y-2 text-sm text-[var(--text-2)] leading-7">
            <div>• Use Docker Compose for multi-service setups</div>
            <div>• Wait for emulators to be healthy before running tests</div>
            <div>• Cache Docker images in an authorized internal runner</div>
            <div>• Run parallel test suites with isolated emulator data volumes</div>
          </div>
        </article>

        <article class="site-panel min-w-0 p-6">
          <h3 class="text-lg font-semibold text-[var(--text)]">4. Feature parity awareness</h3>
          <p class="mt-3 text-[var(--text-2)] leading-7">
            Know what's supported and what's not. Emulators have documented gaps — always validate against real cloud services before production.
          </p>
          <div class="mt-4 space-y-2 text-sm text-[var(--text-2)] leading-7">
            <div>• Read emulator coverage documentation</div>
            <div>• Test edge cases against real cloud in staging</div>
            <div>• Monitor for behavior differences</div>
            <div>• Have a staging environment that mirrors production</div>
          </div>
        </article>

        <article class="site-panel min-w-0 p-6">
          <h3 class="text-lg font-semibold text-[var(--text)]">5. Performance testing considerations</h3>
          <p class="mt-3 text-[var(--text-2)] leading-7">
            Local emulators have different performance characteristics than production cloud services. Don't rely on local benchmarks for production capacity planning.
          </p>
          <div class="mt-4 space-y-2 text-sm text-[var(--text-2)] leading-7">
            <div>• Do not infer production latency from local behavior</div>
            <div>• Throughput limits differ significantly</div>
            <div>• Resource contention behaves differently</div>
            <div>• Always load test against real cloud before launch</div>
          </div>
        </article>

        <article class="site-panel min-w-0 p-6">
          <h3 class="text-lg font-semibold text-[var(--text)]">6. Team consistency</h3>
          <p class="mt-3 text-[var(--text-2)] leading-7">
            Pin the reviewed image and configuration so every developer and CI job runs the same setup. The Public Preview License covers team and organization use for non-production development, testing, and internal CI.
          </p>
          <div class="mt-4 space-y-2 text-sm text-[var(--text-2)] leading-7">
            <div>• Pin Docker image versions in docker-compose.yml</div>
            <div>• Document setup in README</div>
            <div>• Provide one-command setup script</div>
            <div>• Include emulator config in version control</div>
          </div>
        </article>
      </div>
    </div>
  </section>

  {/* FAQ */}
  <section class="site-section">
    <div class="container container--narrow">
      <div class="reveal">
        <h2>Frequently asked questions</h2>
      </div>
      <div class="mt-6 grid gap-3 reveal">
        {faqItems.map(item => (
          <details class="site-panel p-5 cursor-pointer">
            <summary class="font-semibold text-[var(--text)] text-base">{item.q}</summary>
            <p class="mt-3 text-[var(--text-2)] leading-7">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* BOTTOM CTA */}
  <section class="site-section">
    <div class="container">
      <div class="site-panel bg-[var(--surface-2)] p-8 reveal">
        <div class="grid gap-6 xl:grid-cols-[1fr_auto] items-center">
          <div>
            <h2>Start with Google Cloud local development</h2>
            <p class="mt-3 text-lg leading-8 text-[var(--text-2)]">
              Use the CLI for bounded local workflows, then review compatibility and the governing proprietary license.
            </p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a href={`${base}how-to-run-google-cloud-locally/`} class="site-button site-button--secondary">{relatedAnchor('/how-to-run-google-cloud-locally/')}</a>
            <a href={`${base}docs/`} class="site-button site-button--primary">Documentation</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</LandingLayout>
