---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BrandMark from '../../../components/BrandMark.astro';
import OpenWorkbench from '../../../components/prototypes/pricing/OpenWorkbench.astro';
import TwoClearPaths from '../../../components/prototypes/pricing/TwoClearPaths.astro';
import LicenseLedger from '../../../components/prototypes/pricing/LicenseLedger.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

const navLinks = [
  { label: 'Home', href: base },
  { label: 'Services', href: `${base}services/` },
  { label: 'AI', href: `${base}ai/` },
  { label: 'Pricing', href: '#main-content', active: true },
  { label: 'GCP Emulator', href: `${base}gcp-emulator/` },
  { label: 'Guides', href: `${base}how-to-run-google-cloud-locally/` },
];
---

<BaseLayout
  title="LocalCloud Pricing Directions"
  description="Local-only visual prototypes for a proposed LocalCloud licensing model."
  noindex
>
  <header class="pricing-proto-header">
    <div class="container pricing-proto-header__inner">
      <a href={base} class="site-brand">
        <BrandMark size={42} class="site-brand__mark" />
        <span class="site-brand__text">
          <span class="site-brand__word"><span>Local</span><span class="site-brand__word-accent">Cloud</span></span>
          <span class="site-brand__descriptor">Google Cloud in-a-box</span>
        </span>
      </a>

      <button
        id="pricing-proto-nav-toggle"
        class="pricing-proto-header__toggle"
        type="button"
        aria-label="Open navigation"
        aria-controls="pricing-proto-nav-mobile"
        aria-expanded="false"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16"></path>
          <path d="M4 12h16"></path>
          <path d="M4 17h16"></path>
        </svg>
      </button>

      <nav class="pricing-proto-header__nav" aria-label="Primary">
        {navLinks.map((link) => (
          <a href={link.href} class:list={['pricing-proto-header__link', link.active && 'is-active']} aria-current={link.active ? 'page' : undefined}>
            {link.label}
          </a>
        ))}
        <a class="pricing-proto-header__link pricing-proto-header__link--minor" href="https://github.com/LocalStack-Google/localcloud-site" target="_blank" rel="noopener noreferrer">GitHub</a>
        <button type="button" class="pricing-proto-header__search" data-search-trigger aria-label="Search documentation">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <span>Search</span>
        </button>
        <a href={`${base}docs/`} class="pricing-proto-header__docs">Docs</a>
      </nav>
    </div>

    <div id="pricing-proto-nav-mobile" class="pricing-proto-header__mobile" hidden>
      <nav class="container pricing-proto-header__mobile-links" aria-label="Mobile primary">
        {navLinks.map((link) => (
          <a href={link.href} class:list={[link.active && 'is-active']} aria-current={link.active ? 'page' : undefined}>
            {link.label}
          </a>
        ))}
        <a href="https://github.com/LocalStack-Google/localcloud-site" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href={`${base}docs/`}>Docs</a>
      </nav>
    </div>
  </header>

  <main id="main-content" class="pricing-proto-main">
    <div id="stage" aria-live="polite"></div>
  </main>

  <footer class="pricing-proto-footer">
    <div class="container pricing-proto-footer__inner">
      <span>LocalCloud pricing exploration · local prototype</span>
      <a href={`${base}docs/licensing/`}>Current governing license</a>
    </div>
  </footer>

  <template id="variant-1"><OpenWorkbench /></template>
  <template id="variant-2"><TwoClearPaths /></template>
  <template id="variant-3"><LicenseLedger /></template>

  <nav class="proto-picker" aria-label="Prototype variants">
    <span class="proto-picker-highlight" aria-hidden="true"></span>
    <button class="proto-picker-item" data-active aria-current="true">Workbench</button>
    <button class="proto-picker-item">Two paths</button>
    <button class="proto-picker-item">Ledger</button>
    <span class="proto-picker-divider" aria-hidden="true"></span>
    <button class="proto-picker-item proto-picker-replay" aria-label="Replay animation (R)">↻</button>
  </nav>

  <script>
    const navToggle = document.getElementById('pricing-proto-nav-toggle') as HTMLButtonElement | null;
    const mobileNav = document.getElementById('pricing-proto-nav-mobile') as HTMLElement | null;

    const setMenuOpen = (open: boolean) => {
      if (!navToggle || !mobileNav) return;
      navToggle.setAttribute('aria-expanded', String(open));
      navToggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
      mobileNav.hidden = !open;
      mobileNav.classList.toggle('is-open', open);
    };

    navToggle?.addEventListener('click', () => {
      setMenuOpen(navToggle.getAttribute('aria-expanded') !== 'true');
    });

    const stage = document.getElementById('stage');
    const picker = document.querySelector('.proto-picker') as HTMLElement | null;
    const highlight = picker?.querySelector('.proto-picker-highlight') as HTMLElement | null;
    const items = [...(picker?.querySelectorAll<HTMLButtonElement>('.proto-picker-item:not(.proto-picker-replay)') ?? [])];
    const replay = picker?.querySelector<HTMLButtonElement>('.proto-picker-replay');
    const templates = ['variant-1', 'variant-2', 'variant-3'].map((id) => document.getElementById(id));
    let current = 0;

    function moveHighlight() {
      const el = items[current];
      if (!el || !highlight) return;
      highlight.style.width = `${el.offsetWidth}px`;
      highlight.style.transform = `translateX(${el.offsetLeft}px)`;
    }

    function mount(i: number) {
      if (!stage) return;
      stage.replaceChildren();
      requestAnimationFrame(() => {
        const template = templates[i];
        if (template instanceof HTMLTemplateElement) {
          stage.append(template.content.cloneNode(true));
        }
      });
    }

    function setActive(i: number) {
      if (i < 0 || i >= items.length) return;
      current = i;
      items.forEach((el, j) => {
        el.toggleAttribute('data-active', j === i);
        if (j === i) el.setAttribute('aria-current', 'true');
        else el.removeAttribute('aria-current');
      });
      moveHighlight();
      const url = new URL(location.href);
      url.searchParams.set('v', String(i + 1));
      history.replaceState(null, '', url);
      mount(i);
    }

    items.forEach((el, i) => el.addEventListener('click', () => setActive(i)));
    replay?.addEventListener('click', () => mount(current));
    window.addEventListener('resize', moveHighlight);

    document.addEventListener('keydown', (event) => {
      const target = event.target as HTMLElement | null;
      if (target && (/^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName) || target.isContentEditable)) return;
      if (event.metaKey || event.ctrlKey || event.altKey) return;

      if (event.key === 'Escape' && navToggle?.getAttribute('aria-expanded') === 'true') {
        setMenuOpen(false);
        navToggle.focus();
        return;
      }

      const num = Number.parseInt(event.key, 10);
      if (num >= 1 && num <= items.length) setActive(num - 1);
      else if (event.key === 'ArrowRight') setActive((current + 1) % items.length);
      else if (event.key === 'ArrowLeft') setActive((current - 1 + items.length) % items.length);
      else if (event.key === 'r' || event.key === 'R') mount(current);
    });

    const requested = Number.parseInt(new URLSearchParams(location.search).get('v') ?? '', 10);
    setActive(requested >= 1 && requested <= items.length ? requested - 1 : 0);
    requestAnimationFrame(() => requestAnimationFrame(() => picker?.setAttribute('data-ready', '')));
  </script>
</BaseLayout>

<style>
  .pricing-proto-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.9);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
  }

  .pricing-proto-header__inner {
    display: flex;
    min-height: 4.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .pricing-proto-header__nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .pricing-proto-header__link {
    display: inline-flex;
    min-height: 2.7rem;
    align-items: center;
    justify-content: center;
    padding: 0 0.72rem;
    border-radius: 999px;
    color: var(--text-2);
    font-size: 0.9rem;
  }

  .pricing-proto-header__link:hover,
  .pricing-proto-header__link.is-active {
    background: var(--surface);
    color: var(--text);
  }

  .pricing-proto-header__link--minor {
    color: var(--text-3);
  }

  .pricing-proto-header__search,
  .pricing-proto-header__toggle {
    display: inline-flex;
    min-height: 2.7rem;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    color: var(--text-2);
    font: inherit;
    font-size: 0.86rem;
    cursor: pointer;
  }

  .pricing-proto-header__toggle {
    display: none;
    width: 2.8rem;
    min-height: 2.8rem;
    padding: 0;
    color: var(--text);
  }

  .pricing-proto-header__docs {
    display: inline-flex;
    min-height: 2.85rem;
    align-items: center;
    justify-content: center;
    padding: 0 1rem;
    border-radius: 999px;
    background: var(--accent-strong);
    color: #fff;
    font-size: 0.92rem;
    font-weight: 600;
  }

  .pricing-proto-header__docs:hover {
    background: var(--accent);
    color: #fff;
  }

  .pricing-proto-header__mobile {
    display: none;
    padding-bottom: 1rem;
  }

  .pricing-proto-header__mobile.is-open {
    display: block;
  }

  .pricing-proto-header__mobile-links {
    display: grid;
    gap: 0.45rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .pricing-proto-header__mobile-links a {
    display: flex;
    min-height: 3rem;
    align-items: center;
    padding: 0 1rem;
    border: 1px solid var(--line);
    border-radius: 0.8rem;
    background: var(--surface);
    color: var(--text);
  }

  .pricing-proto-header__mobile-links a.is-active {
    border-color: rgba(26, 115, 232, 0.18);
    background: var(--accent-soft);
  }

  .pricing-proto-main {
    min-height: calc(100vh - 8rem);
    padding-bottom: 3.5rem;
  }

  .pricing-proto-footer {
    border-top: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.82);
  }

  .pricing-proto-footer__inner {
    display: flex;
    min-height: 6rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .pricing-proto-footer__inner a {
    text-decoration: underline;
    text-underline-offset: 0.22rem;
  }

  .proto-picker {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2147483647;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    border-radius: 999px;
    background: rgba(10, 10, 10, 0.82);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    backdrop-filter: blur(12px) saturate(1.4);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08) inset,
      0 8px 24px rgba(0, 0, 0, 0.24),
      0 2px 6px rgba(0, 0, 0, 0.12);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 13px;
    line-height: 1;
    -webkit-font-smoothing: antialiased;
    user-select: none;
    -webkit-user-select: none;
  }

  .proto-picker-highlight {
    position: absolute;
    top: 4px;
    left: 0;
    height: 28px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    will-change: transform;
  }

  .proto-picker[data-ready] .proto-picker-highlight {
    transition:
      transform 250ms cubic-bezier(0.23, 1, 0.32, 1),
      width 250ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .proto-picker-item {
    position: relative;
    display: flex;
    align-items: center;
    height: 28px;
    padding: 0 12px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: rgba(255, 255, 255, 0.55);
    font: inherit;
    cursor: pointer;
    transition: color 150ms ease-out;
  }

  .proto-picker-item:hover {
    color: rgba(255, 255, 255, 0.85);
  }

  .proto-picker-item:active {
    transform: scale(0.97);
  }

  .proto-picker-item:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.4);
    outline-offset: 2px;
  }

  .proto-picker-item[data-active] {
    color: #fff;
  }

  .proto-picker-divider {
    width: 1px;
    height: 16px;
    margin: 0 4px;
    background: rgba(255, 255, 255, 0.12);
  }

  .proto-picker-replay {
    padding: 0 10px;
    font-size: 14px;
  }

  .proto-picker[data-position="top"] {
    bottom: auto;
    top: 24px;
  }

  @media (prefers-reduced-motion: reduce) {
    .proto-picker[data-ready] .proto-picker-highlight { transition: none; }
  }

  @media (max-width: 1020px) {
    .pricing-proto-header__nav {
      display: none;
    }

    .pricing-proto-header__toggle {
      display: inline-flex;
    }
  }

  @media (max-width: 560px) {
    .pricing-proto-main {
      padding-bottom: 5rem;
    }

    .pricing-proto-footer__inner {
      min-height: 8rem;
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
    }
  }
</style>
