---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { blogDemoPages } from '../../data/agenticContent';
import { authoredBlogMetadata, getBlogMetadata, formatBlogDate } from '../../data/blogPresentation';
import { createBreadcrumbSchema, productFacts } from '../../data/productFacts';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const localHref = (path: string) => `${base}${path.replace(/^\//, '')}`;
const posts = blogDemoPages.map((page) => ({
  slug: page.slug, path: page.path, title: page.h1, description: page.description,
  ...getBlogMetadata(page),
}));
const openSource = authoredBlogMetadata['localcloud-for-open-source'];
posts.push({
  slug: 'localcloud-for-open-source', path: '/blog/localcloud-for-open-source/',
  title: 'Bring No-Cost Cloud Integration Testing Into Your Repository: Low Setup, Easy Contributions',
  description: 'Run Google Cloud tests locally with zero cloud-resource costs and an easier contribution workflow. Free for open-source development and CI under the Free for open-source projects policy.',
  topic: openSource.topic, minutes: openSource.minutes, date: openSource.publishedAt, dateLabel: 'Published',
});
const featured = posts.find((post) => post.slug === 'run-dataproc-locally-docker') ?? posts[0];
const remaining = posts.filter((post) => post.slug !== featured.slug);
const structuredData = [createBreadcrumbSchema([
  { name: 'Home', url: productFacts.siteUrl },
  { name: 'Blog', url: new URL('blog/', productFacts.siteUrl).toString() },
])];
---

<BlogLayout
  title="LocalCloud Blog: Guides and Demos"
  description="Practical guides for local Google Cloud development: Dataproc and Spark in Docker, no-cost integration testing for open-source projects, and more."
  {structuredData}
  index
>
  <Fragment slot="hero">
    <section class="site-section site-section--hero">
      <div class="container">
        <span class="site-eyebrow">LocalCloud Blog</span>
        <h1 class="mt-4">LocalCloud blog and demos</h1>
        <p class="blog-deck">Practical guides for building and testing Google Cloud workflows locally, from data pipelines to open-source CI.</p>
      </div>
    </section>
  </Fragment>

  <section class="site-section" aria-label="Featured article">
    <a class="blog-card blog-feature" href={localHref(featured.path)}>
      <span class="site-kicker">Featured guide · {featured.topic}</span>
      <h2>{featured.title}</h2>
      <p>{featured.description}</p>
      <div class="blog-meta">
        {featured.date && <span>{featured.dateLabel} <time datetime={featured.date}>{formatBlogDate(featured.date)}</time></span>}
        <span>{featured.minutes} min read</span>
      </div>
      <span class="blog-read">Read the guide <span aria-hidden="true">→</span></span>
    </a>
    <h2 class="mb-6" id="articles">More from the blog</h2>
    <div class="blog-posts">
      {remaining.map((post) => <article>
        <a class="blog-card" href={localHref(post.path)}>
          <span class="site-kicker">{post.topic}</span>
          <h3>{post.title}</h3>
          <p>{post.description}</p>
          <div class="blog-meta">
            {post.date && <span>{post.dateLabel} <time datetime={post.date}>{formatBlogDate(post.date)}</time></span>}
            <span>{post.minutes} min read</span>
          </div>
        </a>
      </article>)}
    </div>
  </section>
</BlogLayout>
