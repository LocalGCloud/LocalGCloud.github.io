---
import BlogLayout from '../../layouts/BlogLayout.astro';
import CopyButton from '../../components/CopyButton.astro';
import { authoredBlogMetadata, formatBlogDate } from '../../data/blogPresentation';
import { createBreadcrumbSchema, productFacts } from '../../data/productFacts';

const title = 'Zero-Secret GCP Integration Tests in GitHub Actions';
const description = 'Eliminate cloud billing and service-account secrets from PR checks. Spin up an ephemeral LocalCloud environment inside GitHub Actions in seconds.';
const pageUrl = new URL('blog/zero-secret-gcp-ci-github-actions/', productFacts.siteUrl).toString();
const metadata = authoredBlogMetadata['zero-secret-gcp-ci-github-actions'];
const contents = [
  { id: 'problem', label: 'Why cloud-backed PR checks hurt teams' },
  { id: 'solution', label: 'Ephemeral per-PR environments in CI' },
  { id: 'workflow', label: 'Add setup-localcloud to an existing job' },
  { id: 'try-it', label: 'Copy-ready GitHub Actions workflow' },
  { id: 'staging', label: 'Keep staging checks for final validation' },
];
const ghWorkflow = `name: pr-local-cloud-integration-tests
on:
  pull_request:
  push:
    branches: [main]
permissions:
  contents: read
jobs:
  integration:
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v7.0.1
      - uses: actions/setup-python@v7.0.0
        with:
          python-version: '3.12'
      - name: Install existing dependencies
        run: python -m pip install -r requirements.txt
      - name: Start LocalCloud
        uses: agent-local-cloud/setup-localcloud@3f8bd6df58cfd3cf4cd29c46f3449c7e6465f64a
        with:
          image: agentcloud/localcloud:ci
          console: 'false'
          services: gcs,pubsub,bigquery
          project-id: localcloud-ci
      - name: Run existing integration tests
        run: python -m pytest tests/integration/`;
const structuredData = [
  createBreadcrumbSchema([
    { name: 'Home', url: productFacts.siteUrl },
    { name: 'Blog', url: new URL('blog/', productFacts.siteUrl).toString() },
    { name: title, url: pageUrl },
  ]),
];
---

<BlogLayout {title} {description} {structuredData} {contents} article={{ publishedAt: metadata.publishedAt, headline: title }}>
  <Fragment slot="hero">
    <article class="site-section site-section--hero">
      <div class="container container--narrow">
        <nav class="mb-5 text-sm text-[var(--text-2)]" aria-label="Breadcrumb"><a href="/blog/">Blog</a></nav>
        <span class="site-eyebrow">CI/CD &amp; DevOps</span>
        <h1 class="mt-5">{title}</h1>
        <p class="blog-meta"><span>Published <time datetime={metadata.publishedAt}>{formatBlogDate(metadata.publishedAt)}</time></span><span>{metadata.minutes} min read</span><span>{metadata.topic}</span></p>
        <p class="blog-deck">Storing GCP credentials in CI secrets expands your security blast radius, while running integration suites against shared staging projects drives up cloud spend and flaky PR collisions.</p>
        <div class="blog-actions">
          <a class="site-button site-button--primary" href="/docs/github-actions/">GitHub Actions guide</a>
          <a href="/gcp-integration-testing/">GCP integration testing in CI</a>
        </div>
      </div>
    </article>
  </Fragment>

  <section class="site-section">
    <div class="container container--narrow space-y-10">
      <section>
        <h2 id="problem">Why cloud-backed PR checks hurt teams</h2>
        <p class="mt-4">Every pull request that hits a real Google Cloud project pays three taxes: credential management (service account keys or OIDC workload identity), network round-trip latency, and per-run cloud charges for BigQuery scans, Pub/Sub messages, and storage ops.</p>
        <p class="mt-4">When two developers push commits at the same time, tests targeting the same staging bucket or database collide and fail randomly.</p>
      </section>

      <section>
        <h2 id="solution">Ephemeral per-PR environments in CI</h2>
        <p class="mt-4">The <code>agent-local-cloud/setup-localcloud</code> Action starts LocalCloud directly on the GitHub Actions Ubuntu runner, waits for readiness on your chosen services, creates a local project, exports SDK endpoint variables to subsequent steps, and tears down the container cleanly when the job ends.</p>
        <ul class="site-list mt-5">
          <li><strong>Zero GCP secrets on PRs:</strong> Fork PRs and internal branches can run cloud integration suites without cloud IAM keys.</li>
          <li><strong>Total isolation:</strong> Every runner gets its own fresh Docker container and clean project state.</li>
          <li><strong>Zero cloud charges:</strong> Repeated integration test runs incur $0 in Google Cloud billing.</li>
        </ul>
      </section>

      <section>
        <h2 id="workflow">Add setup-localcloud to an existing job</h2>
        <p class="mt-4">Keep your existing test suite, dependency lockfiles, and client initialization. Simply enable the specific services your tests exercise (<code>services: gcs,pubsub,bigquery</code>) and let the Action inject the local endpoint environment variables.</p>
      </section>

      <section>
        <h2 id="try-it">Copy-ready GitHub Actions workflow</h2>
        <p class="mt-4">Adapt this workflow in <code>.github/workflows/localcloud.yml</code> to match your repository’s language setup and test command. See <a href="/docs/github-actions/">GitHub Actions docs</a> for GitLab/Docker service-container variants and <a href="/docs/">Getting Started</a> for local laptop runs.</p>
        <div class="site-panel mt-5">
          <div class="flex items-center justify-between gap-4">
            <span class="site-kicker">.github/workflows/localcloud.yml</span>
            <CopyButton text={ghWorkflow} analyticsLabel="copy-blog-ci-workflow" />
          </div>
          <pre><code>{ghWorkflow}</code></pre>
        </div>
      </section>

      <section>
        <h2 id="staging">Keep staging checks for final validation</h2>
        <p class="mt-4">Run LocalCloud on every pull request for instant, zero-secret verification, and keep a separate staging deployment check on main or release tags to verify production IAM policies and live GCP behavior.</p>
      </section>
    </div>
  </section>
</BlogLayout>
