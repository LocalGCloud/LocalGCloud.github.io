---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import {
  agenticEndpoints,
  agenticFacts,
  agenticServiceMetadata,
  agentPromptLibrary,
  agentSafeValidationChecklist,
} from '../../data/agenticFacts';
import { agentsMdTemplate } from '../../data/agenticMarkdown';
import { createBreadcrumbSchema, createSoftwareApplicationSchema, productFacts } from '../../data/productFacts';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const agentSkillsUrl = `${productFacts.githubUrl}/tree/main/agent-skills`;

const workflowCards = [
  {
    step: '01',
    title: 'Start the sandbox',
    body: 'Pull the canonical Docker image, start or reuse the localcloud container, and wait for the localhost health endpoint.',
    command: `${agenticFacts.dockerPullCommand}\n${agenticFacts.dockerRunCommand}`,
  },
  {
    step: '02',
    title: 'Point SDKs at localhost',
    body: 'Export LocalCloud environment variables before running SDK, CLI, Terraform, or test commands.',
    command: agenticFacts.envExportCommand,
  },
  {
    step: '03',
    title: 'Run the narrow check',
    body: 'Create the smallest dataset, topic, bucket, secret, queue, or table that proves the project path works locally.',
    command: `curl -fsS ${agenticFacts.healthEndpoint}`,
  },
  {
    step: '04',
    title: 'Keep production separate',
    body: 'Do not treat emulator success as production proof. Unset emulator variables and validate against real GCP before release.',
    command: 'unset STORAGE_EMULATOR_HOST PUBSUB_EMULATOR_HOST FIRESTORE_EMULATOR_HOST BIGQUERY_EMULATOR_HOST',
  },
];

const supportedCount = agenticServiceMetadata.filter((service) => service.status === 'supported').length;
const partialCount = agenticServiceMetadata.filter((service) => service.status === 'partial').length;
const plannedCount = agenticServiceMetadata.filter((service) => service.status === 'planned').length;

const structuredData = [
  createSoftwareApplicationSchema(
    `${productFacts.siteUrl}ai/`,
    'Agent-facing LocalCloud guide for running Google Cloud SDKs against localhost safely.',
  ),
  createBreadcrumbSchema([
    { name: 'Home', url: productFacts.siteUrl },
    { name: 'AI agent guide', url: `${productFacts.siteUrl}ai/` },
  ]),
];
---

<BaseLayout
  title="LocalCloud for AI Agents — Local GCP Sandbox and AGENTS.md Template"
  description="Give AI coding agents a safe LocalCloud target: one Docker container, 20+ local GCP services, standard SDKs pointed at localhost, no GCP credentials or billing by default, and production validation boundaries."
  structuredData={structuredData}
>
  <Header />

  <main id="main-content" class="site-page ai-page">
    <section class="site-section site-section--hero">
      <div class="container grid gap-8 xl:grid-cols-[1fr,0.78fr] xl:items-start">
        <div class="reveal">
          <span class="site-eyebrow">
            <span class="site-eyebrow__pulse"></span>
            Agent-safe local GCP
          </span>
          <h1 class="mt-5">Give coding agents a local Google Cloud target.</h1>
          <p class="mt-5 max-w-[48rem] text-lg leading-8 text-[var(--text-2)] sm:text-xl">
            {agenticFacts.positioning} Agents can run SDKs, Terraform, seed data, and integration checks against localhost instead of reaching for production Google Cloud.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a class="site-button site-button--primary" href={`${base}ai/agents.md`}>Open raw agent guide</a>
            <a class="site-button site-button--secondary" href={`${base}ai/AGENTS.md`}>Download AGENTS.md template</a>
            <a class="site-button site-button--secondary" href={agentSkillsUrl}>Browse Agent Skills</a>
            <a class="site-button site-button--secondary" href={`${base}compatibility/`}>Review compatibility</a>
          </div>
        </div>

        <aside class="site-panel p-5 reveal" aria-label="Canonical LocalCloud facts">
          <span class="site-kicker">Canonical facts</span>
          <dl class="mt-4 grid gap-3 text-sm">
            <div class="flex items-start justify-between gap-4 border-b border-[var(--line)] pb-3">
              <dt class="text-[var(--text-3)]">Docker image</dt>
              <dd class="font-mono text-[var(--text)]">{agenticFacts.dockerImage}</dd>
            </div>
            <div class="flex items-start justify-between gap-4 border-b border-[var(--line)] pb-3">
              <dt class="text-[var(--text-3)]">Services</dt>
              <dd class="font-mono text-[var(--text)]">{productFacts.serviceCountLabel}</dd>
            </div>
            <div class="flex items-start justify-between gap-4 border-b border-[var(--line)] pb-3">
              <dt class="text-[var(--text-3)]">Credentials</dt>
              <dd class="text-right text-[var(--text)]">No GCP account, credentials, or billing by default</dd>
            </div>
            <div class="flex items-start justify-between gap-4">
              <dt class="text-[var(--text-3)]">Production boundary</dt>
              <dd class="text-right text-[var(--text)]">Validate against real GCP before production</dd>
            </div>
          </dl>
        </aside>
      </div>
    </section>

    <section class="site-section site-section--tight">
      <div class="container">
        <div class="site-section-heading reveal">
          <span class="site-kicker">Human explanation</span>
          <h2>Why agents need this page</h2>
          <p>
            AI agents often discover code paths that expect Google Cloud. This page gives them a safe default: start LocalCloud, route SDKs to localhost, prove behavior locally, and stop rather than silently using real cloud credentials.
          </p>
        </div>
        <div class="grid gap-4 md:grid-cols-3 stagger">
          <article class="site-panel p-5 reveal">
            <span class="site-chip site-chip--accent">Local first</span>
            <h3 class="mt-4">Same SDKs, localhost endpoints</h3>
            <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Agents should keep project code pointed at standard Google Cloud SDKs while exporting emulator host variables for local runs.</p>
          </article>
          <article class="site-panel p-5 reveal">
            <span class="site-chip site-chip--success">No secrets</span>
            <h3 class="mt-4">No GCP account by default</h3>
            <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Default development and CI checks should not ask for service-account keys, billing projects, or production credentials.</p>
          </article>
          <article class="site-panel p-5 reveal">
            <span class="site-chip site-chip--warn">Boundary</span>
            <h3 class="mt-4">Not production replacement</h3>
            <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">LocalCloud helps verify local behavior. Release readiness still requires testing against real Google Cloud after emulator variables are removed.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="site-section site-section--tight">
      <div class="container">
        <div class="site-section-heading reveal">
          <span class="site-kicker">Copy prompts</span>
          <h2>Prompt an agent with a safe LocalCloud task</h2>
          <p>These prompts come from the shared LocalCloud agent facts file and preserve the no-credentials, localhost-first boundary.</p>
        </div>
        <div class="grid gap-4 lg:grid-cols-2 stagger">
          {agentPromptLibrary.map((item) => (
            <article class="site-panel min-w-0 p-5 reveal">
              <div class="mb-4">
                <span class="site-kicker">{item.useCase}</span>
                <h3 class="mt-2.5">{item.label}</h3>
              </div>
              
              <!-- Terminal-style prompt display -->
              <div class="relative rounded-xl border border-[var(--line)] bg-[var(--surface-2)] overflow-hidden">
                <!-- Terminal chrome -->
                <div class="flex items-center justify-between border-b border-[var(--line)] bg-[var(--surface-3)] px-4 py-2.5">
                  <div class="flex items-center gap-2.5">
                    <div class="flex gap-1.5">
                      <span class="h-2.5 w-2.5 rounded-full bg-[var(--text-3)] opacity-30"></span>
                      <span class="h-2.5 w-2.5 rounded-full bg-[var(--text-3)] opacity-30"></span>
                      <span class="h-2.5 w-2.5 rounded-full bg-[var(--text-3)] opacity-30"></span>
                    </div>
                    <span class="font-mono text-xs uppercase tracking-wider text-[var(--text-3)]">Prompt</span>
                  </div>
                  <button 
                    type="button" 
                    class="inline-flex items-center gap-1.5 rounded-md border border-[var(--line)] bg-[var(--surface)] px-2.5 py-1.5 font-mono text-xs text-[var(--text-2)] transition-all hover:border-[var(--border-hover)] hover:text-[var(--text)]" 
                    data-copy-text={item.prompt}
                  >
                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                    </svg>
                    Copy
                  </button>
                </div>
                <!-- Prompt text -->
                <div class="p-4">
                  <p class="agent-prompt-text font-mono text-sm leading-relaxed text-[var(--text)]">{item.prompt}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="site-section site-section--tight">
      <div class="container">
        <div class="site-section-heading reveal">
          <span class="site-kicker">Workflow</span>
          <h2>Agent execution loop</h2>
          <p>Keep the loop small: local runtime, localhost environment, narrow service proof, explicit production validation later.</p>
        </div>
        <div class="grid gap-4 lg:grid-cols-4 stagger">
          {workflowCards.map((card) => (
            <article class="site-panel min-w-0 p-5 reveal">
              <div class="font-mono text-sm text-[var(--accent-strong)]">{card.step}</div>
              <h3 class="mt-3">{card.title}</h3>
              <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">{card.body}</p>
              <pre class="mt-4 max-w-full overflow-x-auto text-xs"><code>{card.command}</code></pre>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="site-section site-section--tight">
      <div class="container">
        <div class="site-section-heading reveal">
          <span class="site-kicker">Service matrix</span>
          <h2>{productFacts.serviceCountLabel} service surfaces, clearly bounded</h2>
          <p>Service metadata is generated from the shared catalog. Use service pages and compatibility docs for capability-specific claims.</p>
        </div>
        <div class="mb-5 flex flex-wrap gap-3 reveal">
          <span class="site-chip site-chip--success">{supportedCount} supported locally</span>
          <span class="site-chip site-chip--warn">{partialCount} partial coverage</span>
          <span class="site-chip site-chip--accent">{plannedCount} planned</span>
        </div>
        <div class="ai-service-matrix site-panel reveal">
          <table class="border-collapse text-left text-sm">
            <thead>
              <tr class="border-b border-[var(--line)] text-[var(--text-3)]">
                <th class="p-4 font-mono text-xs uppercase tracking-[0.12em]">Service</th>
                <th class="p-4 font-mono text-xs uppercase tracking-[0.12em]">Status</th>
                <th class="p-4 font-mono text-xs uppercase tracking-[0.12em]">Endpoint</th>
                <th class="p-4 font-mono text-xs uppercase tracking-[0.12em]">Boundary</th>
              </tr>
            </thead>
            <tbody>
              {agenticServiceMetadata.map((service) => (
                <tr class="border-b border-[var(--line)] last:border-0">
                  <td class="p-4 align-top">
                    <a class="font-semibold text-[var(--text)]" href={`${base}services/${service.slug}/`}>{service.name}</a>
                    <div class="mt-1 font-mono text-xs text-[var(--text-3)]">{service.implementation}</div>
                  </td>
                  <td class="p-4 align-top">
                    <span class:list={['site-chip', service.status === 'supported' ? 'site-chip--success' : service.status === 'planned' ? 'site-chip--accent' : 'site-chip--warn']}>
                      {service.status}
                    </span>
                  </td>
                  <td class="p-4 align-top font-mono text-xs text-[var(--text-2)]">{service.envVar}</td>
                  <td class="p-4 align-top text-[var(--text-2)]">{service.caveat}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="site-section site-section--tight">
      <div class="container grid gap-5 lg:grid-cols-[0.82fr,1fr]">
        <div class="site-section-heading reveal">
          <span class="site-kicker">Safety boundaries</span>
          <h2>What agents must not do</h2>
          <p>LocalCloud removes cloud dependencies from local development; it does not remove the responsibility to validate production behavior with real Google Cloud.</p>
          <div class="mt-5 flex flex-wrap gap-3">
            <a class="site-button site-button--secondary" href={`${base}compatibility/`}>Compatibility</a>
            <a class="site-button site-button--secondary" href={`${base}docs/sdk-examples/`}>SDK examples</a>
            <a class="site-button site-button--secondary" href={`${base}docs/terraform/`}>Terraform</a>
            <a class="site-button site-button--secondary" href={`${base}docs/seed-data/`}>Seed data</a>
          </div>
        </div>
        <div class="grid gap-3 reveal">
          {agentSafeValidationChecklist.map((item) => (
            <div class="site-panel site-panel--soft p-4 text-sm leading-7 text-[var(--text-2)]">{item}</div>
          ))}
        </div>
      </div>
    </section>

    <section class="site-section site-section--tight">
      <div class="container grid gap-5 lg:grid-cols-4">
        <article class="site-panel p-6 reveal">
          <span class="site-kicker">Raw guide</span>
          <h2 class="mt-3">/ai/agents.md</h2>
          <p class="mt-4 text-[var(--text-2)]">A hosted Markdown execution guide for agents. It includes startup commands, endpoints, service matrix, copy prompts, and safety rules.</p>
          <a class="site-button site-button--primary mt-5" href={`${base}ai/agents.md`}>Open Markdown guide</a>
        </article>
        <article class="site-panel p-6 reveal">
          <span class="site-kicker">Repo-local policy</span>
          <h2 class="mt-3">AGENTS.md template</h2>
          <p class="mt-4 text-[var(--text-2)]">AGENTS.md belongs inside a repository and tells coding agents how to behave in that codebase. Copy this template into a repo when you want LocalCloud to be the default safe GCP target.</p>
          <div class="mt-5 flex flex-wrap gap-3">
            <a class="site-button site-button--primary" href={`${base}ai/AGENTS.md`} download="AGENTS.md">Download template</a>
            <button type="button" class="site-button site-button--secondary" data-copy-text={agentsMdTemplate}>Copy template</button>
          </div>
        </article>
        <article class="site-panel p-6 reveal">
          <span class="site-kicker">Markdown policy</span>
          <h2 class="mt-3">Raw resource index</h2>
          <p class="mt-4 text-[var(--text-2)]">HTML pages stay canonical for humans; raw Markdown routes give agents compact service, compatibility, and docs context sourced from shared LocalCloud metadata.</p>
          <a class="site-button site-button--primary mt-5" href={`${base}ai/resources.md`}>Open Markdown index</a>
        </article>
        <article class="site-panel p-6 reveal">
          <span class="site-kicker">Portable skills</span>
          <h2 class="mt-3">agent-skills/</h2>
          <p class="mt-4 text-[var(--text-2)]">Reusable LocalCloud Agent Skills cover BigQuery, Pub/Sub, Terraform, CI sidecars, seed data, and SDK tests. Copy them into <code>.agents/skills/</code> for project-local use.</p>
          <a class="site-button site-button--primary mt-5" href={agentSkillsUrl}>Open skills repository</a>
        </article>
      </div>
    </section>

    <section class="site-section site-section--tight">
      <div class="container">
        <div class="site-section-heading reveal">
          <span class="site-kicker">Agent endpoints</span>
          <h2>URLs agents can rely on</h2>
          <p>Use these localhost endpoints after LocalCloud is running, and use the public docs for service-specific context.</p>
        </div>
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4 stagger">
          {agenticEndpoints.map((endpoint) => (
            <article class="site-panel p-5 reveal">
              <h3>{endpoint.label}</h3>
              <code class="mt-3 block break-all">{endpoint.url}</code>
              <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">{endpoint.purpose}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <script>
    document.querySelectorAll('[data-copy-text]').forEach((button) => {
      button.addEventListener('click', async () => {
        const text = button.getAttribute('data-copy-text') || '';
        try {
          await navigator.clipboard.writeText(text);
          const original = button.textContent;
          button.textContent = 'Copied';
          window.setTimeout(() => {
            button.textContent = original;
          }, 1400);
        } catch {
          button.textContent = 'Copy failed';
        }
      });
    });
  </script>

  <Footer />
</BaseLayout>
