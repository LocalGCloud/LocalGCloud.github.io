---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CopyButton from '../../components/CopyButton.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import { getServiceCategoryLabel, getServiceImplementationLabel, getServiceImplementationNote, services } from '../../data/services';
import type { Service } from '../../data/services';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
const categoryLabel = getServiceCategoryLabel(service);
---

<BaseLayout title={`${service.name} Local Emulator — LocalCloud`} description={`Run ${service.name} locally with LocalCloud. ${service.description} Part of a single Docker container with 20+ GCP emulators.`}>
  <!-- JSON-LD BreadcrumbList -->
  <script type="application/ld+json" set:html={`{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Services",
        "item": "https://local.cloud/services/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "${service.name}"
      }
    ]
  }`} />
  <!-- JSON-LD SoftwareApplication -->
  <script type="application/ld+json" set:html={`{
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "LocalCloud ${service.name} Emulator",
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "Linux (Docker)",
    "description": "${service.description}",
    "url": "https://local.cloud/services/${service.slug}/",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  }`} />
  <Header />

  <main id="main-content" class="site-page">
    <section class="site-section site-section--hero">
      <div class="container grid gap-8 xl:grid-cols-[1fr,0.85fr]">
        <div class="reveal">
          <nav class="mb-5 flex items-center gap-2 text-sm text-[var(--text-3)]">
            <a href={`${base}services/`} class="hover:text-[var(--text)]">Services</a>
            <span>/</span>
            <span class="text-[var(--text)]">{service.name}</span>
          </nav>

          <div class="flex items-start gap-5">
            <span class="flex h-24 w-24 shrink-0 items-center justify-center rounded-[1.8rem] border border-[var(--line)] bg-white shadow-[var(--shadow-md)]">
              <ServiceIcon iconId={service.iconId} name={service.name} size={64} />
            </span>
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-3">
                <span class="site-chip site-chip--accent">{categoryLabel}</span>
                {!service.enabled && <span class="site-chip site-chip--warn">Opt-in</span>}
              </div>
              <h1 class="mt-4 max-w-[12ch]">{service.name}</h1>
            </div>
          </div>

          <p class="mt-6 max-w-[40rem] text-lg leading-8 text-[var(--text-2)] sm:text-xl">
            {service.description}
          </p>

          <div class="mt-8 grid gap-4 sm:grid-cols-3">
            <article class="site-panel site-panel--soft p-5">
              <div class="text-3xl font-semibold tracking-[-0.08em] text-[var(--text)]">{service.supported.length}</div>
              <div class="mt-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-[var(--accent-strong)]">Supported</div>
              <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Capabilities you can exercise locally today.</p>
            </article>
            <article class="site-panel site-panel--soft p-5">
              <div class="text-3xl font-semibold tracking-[-0.08em] text-[var(--text)]">{service.notSupported.length}</div>
              <div class="mt-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-[var(--accent-strong)]">Gaps</div>
              <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Known gaps and behaviors that are not there yet.</p>
            </article>
            <article class="site-panel site-panel--soft p-5">
              <div class="text-2xl font-semibold tracking-[-0.05em] text-[var(--text)]">{service.port}</div>
              <div class="mt-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-[var(--accent-strong)]">Port / Protocol</div>
              <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">{service.protocol}</p>
            </article>
          </div>
        </div>

        <aside class="site-panel p-5 reveal sm:p-6">
          <div class="flex items-center justify-between gap-3">
            <span class="site-kicker">Connection</span>
            <CopyButton text={service.envVar} />
          </div>

          <div class="mt-4 rounded-[1.25rem] border border-[var(--line)] bg-[var(--surface-2)] p-4">
            <p class="site-micro">Environment Variable</p>
            <code class="mt-3 block break-all border-0 bg-transparent p-0 text-[0.92rem] leading-7 text-[var(--accent-strong)]">
              {service.envVar}
            </code>
          </div>

          <div class="mt-4 rounded-[1.25rem] border border-[var(--line)] bg-[var(--surface-2)] p-4">
            <p class="site-micro">Service Snapshot</p>
            <ul class="site-list mt-4">
              <li>Category: {categoryLabel}.</li>
              <li>Implementation: {getServiceImplementationLabel(service)}. {getServiceImplementationNote(service)}</li>
              <li>{service.enabled ? 'Available in the default container boot.' : 'Requires opt-in runtime access because it depends on Docker-backed behavior.'}</li>
            </ul>
          </div>
        </aside>
      </div>
    </section>

    <section class="site-section">
      <div class="container">
        <div class="grid gap-4 lg:grid-cols-2">
          <section class="site-panel p-6 reveal">
            <div class="flex items-center justify-between gap-3">
              <h2 class="text-2xl font-semibold tracking-tight">Supported Today</h2>
              <span class="site-chip site-chip--success">{service.supported.length} items</span>
            </div>
            <ul class="site-list site-list--success mt-5">
              {service.supported.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>

          <section class="site-panel site-panel--soft p-6 reveal">
            <div class="flex items-center justify-between gap-3">
              <h2 class="text-2xl font-semibold tracking-tight">Not Yet Supported</h2>
              <span class="site-chip site-chip--accent">{service.notSupported.length} items</span>
            </div>
            <ul class="site-list mt-5">
              {service.notSupported.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        </div>
      </div>
    </section>

    <section class="site-section">
      <div class="container">
        <div class="site-panel p-6 reveal">
          <h2 class="text-2xl font-semibold tracking-tight mb-4">Learn More</h2>
          <ul class="site-list">
            <li><a href={`${base}docs/`}>Getting Started Guide</a> — set up LocalCloud in under a minute</li>
            <li><a href={`${base}docs/sdk-examples/`}>SDK Examples</a> — copy-paste code for Python, Node.js, Go, Java</li>
            <li><a href={`${base}docs/configuration/`}>Configuration</a> — environment variables and ports</li>
            {service.slug === 'bigquery' && (
              <>
                <li><a href={`${base}docs/bigquery-emulator-features/`}>BigQuery Emulator Features</a> — detailed feature support and test coverage</li>
                <li><a href={`${base}docs/bigquery-feature-comparison/`}>BigQuery Feature Comparison</a> — Production vs Go Emulator vs LocalCloud</li>
                <li><a href={`${base}docs/bigquery-coverage-gaps/`}>BigQuery Coverage Gap Analysis</a> — deep-dive into emulator limitations</li>
              </>
            )}
            {service.slug === 'spanner' && (
              <li><a href={`${base}docs/spanner-emulator-features/`}>Spanner Emulator Features</a> — extended emulator with PGAdapter support</li>
            )}
            {service.slug === 'bigtable' && (
              <li><a href={`${base}docs/bigtable-emulator-features/`}>Bigtable Emulator Features</a> — change streams, materialized views, persistence</li>
            )}
          </ul>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
