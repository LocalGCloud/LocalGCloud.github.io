---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CopyButton from '../../components/CopyButton.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import { getServiceCategoryLabel, getServiceImplementationLabel, isServiceDisabledByDefault, optInStartCommand, publishedServiceCount, services } from '../../data/services';
import { serviceTestingPages } from '../../data/agenticContent';
import { serviceCompatibilityEditorial } from '../../data/serviceEditorial';
import { getServiceCodeExamples, officialSampleLinks, serviceGuides, terraformExampleServiceIds } from '../../data/serviceGuides';
import sdkExamplesSource from '../docs/sdk-examples.mdx?raw';
import type { ServiceExampleLink } from '../../data/serviceGuides';
import type { Service } from '../../data/services';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props { service: Service; }
const { service } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const categoryLabel = getServiceCategoryLabel(service);
const isPlanned = service.catalogState === 'coming-soon' || service.marketingStatus === 'unsupported';
const isAuxiliary = service.category === 'auxiliary';
const compatibility = serviceCompatibilityEditorial[service.id];
const guide = serviceGuides[service.id];
if (!compatibility || !guide) throw new Error(`Missing service guide for ${service.id}`);
const codeExamples = isPlanned ? [] : getServiceCodeExamples(service.id, sdkExamplesSource);
const environmentSetup = `localcloud start --local-only${isServiceDisabledByDefault(service) ? ` --services ${service.id}` : ''}\n# Export GOOGLE_CLOUD_PROJECT and ${service.envVar.split('=')[0]}\neval "$(localcloud env)"`;
const agentTestingPage = isPlanned ? undefined : serviceTestingPages.find((page) => page.slug === service.slug);
const emulatorLandingSlugs: Record<string, string> = {
  bigquery: 'bigquery-emulator',
  bigtable: 'bigtable-emulator',
  spanner: 'spanner-emulator',
  pubsub: 'pubsub-emulator',
  firestore: 'firestore-emulator',
  'cloud-storage': 'cloud-storage-emulator',
};
const emulatorLanding = isPlanned ? undefined : emulatorLandingSlugs[service.slug];
const exampleLinks: ServiceExampleLink[] = isPlanned ? [] : [...(guide.examples ?? [])];
if (agentTestingPage) exampleLinks.push({
  title: `${service.name} with an AI agent`, href: agentTestingPage.path, label: 'Agent guide',
  description: 'Endpoint routing, a representative local check, and copyable agent prompts.',
});
if (terraformExampleServiceIds.includes(service.id) && !isPlanned) exampleLinks.push({
  title: 'Provision resources with Terraform', href: '/docs/terraform/#supported-terraform-resources', label: 'Terraform · HCL',
  description: 'Documented resources, provider configuration, and local routing setup.',
});
if (!isPlanned) exampleLinks.push({
  title: 'Build an integration test loop', href: '/workflows/integration-tests/', label: 'Integration',
  description: 'Start the runtime, verify readiness, exercise your SDK, and clean up test state.',
});
if (officialSampleLinks[service.id] && !isPlanned) exampleLinks.push({
  title: 'Official SDK code samples', href: officialSampleLinks[service.id], label: 'Google Cloud', external: true,
  description: 'Browse language-specific samples. Adapt endpoints and use the local workflows listed above.',
});
const pageTitle = isPlanned
  ? `${service.name} — Unsupported in LocalCloud`
  : isAuxiliary
  ? `${service.name} Integration API — LocalCloud`
  : `${service.name} Local Emulator — LocalCloud`;
const pageDescription = isPlanned
  ? `${service.name} doesn't run in LocalCloud yet; local support is planned. Use Google Cloud for ${service.name} and read the official documentation.`
  : `Learn what ${service.name} does, connect it to LocalCloud, and explore documented workflows, boundaries, code examples, and integrations.`;
const exampleHref = (href: string) => href.startsWith('/') ? `${base}${href.slice(1)}` : href;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: `LocalCloud ${service.name} service guide`,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Linux (Docker)',
    description: pageDescription,
    url: `https://local.cloud/services/${service.slug}/`,
  })} />
  <Header />
  <main id="main-content" class="site-page">
    <section class="site-section site-section--hero">
      <div class="container service-hero-grid">
        <div class="service-hero-intro reveal">
          <nav aria-label="Breadcrumb" class="mb-5 flex items-center gap-2 text-sm text-[var(--text-2)]"><a href={`${base}services/`}>Services</a><span aria-hidden="true">/</span><span>{service.name}</span></nav>
          <div class="service-title-row" data-service-heading>
            <span class="service-hero-icon" data-service-hero-icon><ServiceIcon iconId={service.iconId} name={service.name} size={144} /></span>
            <div class="min-w-0">
              <h1>{service.name}</h1>
              {isPlanned && <span class="site-chip site-chip--warn mt-3" data-unsupported-chip>Unsupported</span>}
            </div>
          </div>
          <p class="mt-5 max-w-[42rem] text-lg leading-8 text-[var(--text-2)] sm:text-xl">{guide.intro}</p>
          {!isPlanned && <section class="mt-5" aria-labelledby="typical-uses-title" data-service-typical-uses>
            <h2 id="typical-uses-title" class="site-micro">Typical uses</h2>
            <p class="mt-3 max-w-[42rem] leading-7 text-[var(--text-2)]" data-service-when-to-use>{guide.whenToUse}</p>
            <p class="site-micro mt-4">Examples</p>
            <ul class="mt-3 flex flex-wrap gap-2" aria-label="Typical use examples">
              {guide.typicalUses.map((use) => <li class="site-chip">{use}</li>)}
            </ul>
          </section>}
          <div class="mt-5" data-service-category><span class="site-chip site-chip--accent">{categoryLabel}</span></div>
          {!isPlanned && isServiceDisabledByDefault(service) && (
            <p class="mt-4 text-sm leading-6 text-[var(--accent-strong)]">{service.name} is opt-in to save memory. Add <code>{service.id}</code> to the services you start, for example <code>{optInStartCommand(service)}</code>; <code>--services</code> sets the exact list.</p>
          )}
          {!isPlanned && <nav aria-label="On this page" class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium text-[var(--accent-strong)]">
            <a href="#workflows">Workflows &amp; boundaries</a>
            <a href="#usage">Example usage</a>
            {exampleLinks.length > 0 && <a href="#examples">Code &amp; integrations</a>}
          </nav>}
        </div>

        {isPlanned ? (
          <aside class="site-panel service-hero-connection p-6 reveal">
            <span class="site-kicker">Local availability</span>
            <h2 class="mt-4 text-2xl font-semibold tracking-tight">Not available locally</h2>
            <p class="mt-4 leading-7 text-[var(--text-2)]">{service.description}</p>
            <ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-6 text-[var(--text-2)]" data-service-boundaries>
              {compatibility.boundaries.map((boundary) => <li>{boundary}</li>)}
            </ul>
            <a class="mt-5 inline-block font-medium text-[var(--accent-strong)]" href={guide.reference}>Read the official {service.name} documentation <span aria-hidden="true">↗</span></a>
          </aside>
        ) : (
          <aside class="site-panel service-hero-connection p-5 reveal sm:p-6">
            <div class="flex flex-wrap items-center justify-between gap-3"><span class="site-kicker">{isAuxiliary ? 'Auxiliary API connection' : 'Connection'}</span><CopyButton text={service.envVar} /></div>
            <div class="mt-4 rounded-[1.25rem] border border-[var(--line)] bg-[var(--surface-2)] p-4"><p class="site-micro">Environment variable</p><code class="mt-3 block break-all border-0 bg-transparent p-0 text-sm leading-7 text-[var(--accent-strong)]">{service.envVar}</code></div>
            <div class="mt-4 rounded-[1.25rem] border border-[var(--line)] bg-[var(--surface-2)] p-4">
              <p class="site-micro">Runtime details</p>
              <dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-3 text-sm leading-6">
                <div><dt class="font-semibold">Endpoints</dt><dd>{service.endpointLabel}</dd></div>
                <div><dt class="font-semibold">Minimum tier</dt><dd>{service.minTier}</dd></div>
                <div><dt class="font-semibold">Persistence</dt><dd>{service.persistence.scope}</dd></div>
                <div><dt class="font-semibold">Implementation</dt><dd>{getServiceImplementationLabel(service)}</dd></div>
              </dl>
            </div>
            <p class="mt-4 text-sm leading-6 text-[var(--text-2)]">Use <code>localcloud env</code> for the current endpoints; the CLI can remap occupied host ports.</p>
          </aside>
        )}
      </div>
    </section>

    {!isPlanned && <section id="workflows" class="site-section site-section--tight scroll-mt-24">
      <div class="container grid gap-4 lg:grid-cols-2">
        <section class="site-panel min-w-0 p-6 reveal" aria-labelledby="workflows-title">
          <h2 id="workflows-title" class="text-2xl font-semibold tracking-tight">Documented workflows</h2>
          <ul class="mt-5 list-disc space-y-3 pl-5 leading-7 text-[var(--text-2)]" data-service-capabilities>
            {compatibility.capabilities.map((capability) => <li>{capability.summary}</li>)}
          </ul>
        </section>
        <section class="site-panel site-panel--soft min-w-0 p-6 reveal" aria-labelledby="boundaries-title">
          <h2 id="boundaries-title" class="text-2xl font-semibold tracking-tight">Service boundaries</h2>
          <ul class="mt-5 list-disc space-y-3 pl-5 leading-7 text-[var(--text-2)]" data-service-boundaries>
            {compatibility.boundaries.map((boundary) => <li>{boundary}</li>)}
          </ul>
        </section>
      </div>
    </section>}

    {!isPlanned && <section id="usage" class="site-section site-section--tight scroll-mt-24" aria-labelledby="usage-title">
      <div class="container">
        <div class="site-panel min-w-0 p-5 reveal sm:p-6">
          <span class="site-kicker">{codeExamples.length ? 'Hello world' : 'Local workflow'}</span>
          <h2 id="usage-title" class="mt-3 text-2xl font-semibold tracking-tight">Example usage</h2>
          <div class="mt-5">
            <p class="mb-3 text-sm leading-6 text-[var(--text-2)]">Start LocalCloud, wait for readiness, and export its environment in the same shell. Generated endpoints account for remapped ports.</p>
            <div class="rounded-xl border border-[var(--line)] bg-[var(--surface-2)]">
              <div class="flex items-center justify-between gap-3 border-b border-[var(--line)] px-4 py-3"><span class="site-micro">1. Environment · shell</span><CopyButton text={environmentSetup} /></div>
              <pre class="overflow-x-auto p-4 text-sm leading-7"><code class="border-0 bg-transparent p-0" data-example-environment>{environmentSetup}</code></pre>
            </div>
          </div>
          {codeExamples.length > 0 ? (
            <div class:list={['mt-5 grid min-w-0 gap-5', codeExamples.length > 1 && 'xl:grid-cols-2']}>
              {codeExamples.map((example) => (
                <article class="min-w-0 rounded-xl border border-[var(--line)]" data-hello-world>
                  <div class="p-4"><span class="site-chip site-chip--accent">{example.label}</span><h3 class="mt-3 text-lg font-semibold">{example.title}</h3></div>
                  <div class="border-y border-[var(--line)] bg-[var(--surface-2)]">
                    <div class="flex items-center justify-between gap-3 px-4 pt-3"><span class="site-micro">2. Install SDK · shell</span><CopyButton text={example.setup} /></div>
                    <pre class="overflow-x-auto p-4 text-sm leading-7"><code class="border-0 bg-transparent p-0">{example.setup}</code></pre>
                  </div>
                  <div class="flex items-center justify-between gap-3 border-b border-[var(--line)] px-4 py-3"><span class="site-micro">3. Save as {example.filename}</span><CopyButton text={example.code} /></div>
                  <pre class="overflow-x-auto p-4 text-sm leading-7"><code class="border-0 bg-transparent p-0" data-example-code>{example.code}</code></pre>
                  <div class="flex flex-wrap items-center justify-between gap-3 border-t border-[var(--line)] bg-[var(--surface-2)] px-4 py-3"><div class="min-w-0"><span class="site-micro">4. Run</span><code class="ml-3 break-all">{example.run}</code></div><CopyButton text={example.run} /></div>
                  <a class="m-4 inline-block text-sm font-medium text-[var(--accent-strong)]" href={exampleHref(example.href)}>Full example guide <span aria-hidden="true">→</span></a>
                </article>
              ))}
            </div>
          ) : (
            <div class="mt-5">
              <p class="font-semibold">{guide.example.title}</p>
              <ol class="mt-5 space-y-4">
                {guide.example.steps.map((step, index) => (
                  <li class="flex items-start gap-3 text-[var(--text-2)]"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[var(--accent-soft)] text-xs font-semibold text-[var(--accent-strong)]" aria-hidden="true">{index + 1}</span><span class="leading-7">{step}</span></li>
                ))}
              </ol>
            </div>
          )}
        </div>
      </div>
    </section>}

    {exampleLinks.length > 0 && (
      <section id="examples" class="site-section scroll-mt-24">
        <div class="container">
          <div class="mb-6"><span class="site-kicker">Try it in your project</span><h2 class="mt-3">Code examples &amp; integrations</h2><p class="mt-4 max-w-[48rem] leading-7 text-[var(--text-2)]">Start with the local guides. Official Google Cloud samples may need endpoint changes and can cover features outside the workflows listed here.</p></div>
          <div class:list={['grid gap-4 md:grid-cols-2', exampleLinks.length === 3 || exampleLinks.length >= 5 ? 'xl:grid-cols-3' : 'xl:grid-cols-2']}>
            {exampleLinks.map((example) => (
              <a href={exampleHref(example.href)} class="service-example-card site-panel group flex min-w-0 flex-col p-6" data-service-example>
                <div class="flex items-center justify-between gap-3"><span class:list={['site-chip', !example.external && 'site-chip--accent']}>{example.label}</span><span aria-hidden="true" class="text-xl text-[var(--accent-strong)]">{example.external ? '↗' : '→'}</span></div>
                <h3 class="mt-5 text-lg font-semibold leading-7">{example.title}</h3>
                <p class="mt-3 text-sm leading-6 text-[var(--text-2)]">{example.description}</p>
                <span class="mt-5 text-sm font-medium text-[var(--accent-strong)]">{example.external ? 'Browse official samples' : 'Open guide'} <span aria-hidden="true">→</span></span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="site-section site-section--tight">
      <div class="container"><div class="site-panel p-6 reveal"><h2 class="mb-4 text-2xl font-semibold tracking-tight">Related guides</h2><ul class="site-list">
        {emulatorLanding && <li><span><a href={`${base}${emulatorLanding}/`}>{service.name} emulator overview</a>: setup and FAQ.</span></li>}
        <li><span><a href={`${base}compatibility/`}>Compatibility</a>: compare all {publishedServiceCount} service guides.</span></li>
        {!isPlanned && <li><span><a href={`${base}docs/configuration/`}>Configuration</a>: service selection and runtime settings.</span></li>}
        {['bigquery', 'spanner', 'bigtable'].includes(service.slug) && <li><span><a href={`${base}docs/${service.slug}-emulator-features/`}>{service.name} feature reference</a>: detailed operation and recovery notes.</span></li>}
        <li><span><a href={guide.reference}>Official {service.name} documentation <span aria-hidden="true">↗</span></a>: service concepts and cloud usage.</span></li>
      </ul></div></div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .service-title-row { display: flex; align-items: center; gap: clamp(1rem, 2.5vw, 1.5rem); }
  .service-title-row h1 { font-size: clamp(2rem, 4vw, 3.75rem); line-height: 1.06; letter-spacing: -0.035em; overflow-wrap: anywhere; }
  .service-hero-icon { flex: 0 0 clamp(6rem, 12vw, 9rem); }
  .service-hero-icon :global(img) { display: block; width: 100%; height: auto; }
  [data-service-typical-uses] .site-chip { max-width: 100%; white-space: normal; }
  .service-example-card { transition: border-color 160ms ease, box-shadow 160ms ease; }
  .service-example-card:hover { border-color: var(--accent-strong); box-shadow: var(--shadow-md); }
  .service-example-card:focus-visible { outline: 2px solid var(--accent-strong); outline-offset: 4px; }
  @media (prefers-reduced-motion: reduce) { .service-example-card { transition: none; } }
</style>
