---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import { serviceCategoryMeta, serviceCategoryOrder, services } from '../../data/services';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

const categoryGroups = serviceCategoryOrder
  .map((category) => ({
    id: category,
    title: serviceCategoryMeta[category].label,
    description: serviceCategoryMeta[category].description,
    items: services.filter((service) => service.category === category),
  }))
  .filter((group) => group.items.length > 0);

const optIn = services.filter((service) => !service.enabled);

const catalogStats = [
  {
    value: `${categoryGroups.length}`,
    label: 'Product Categories',
    note: 'Grouped the way Google Cloud teams already scan the platform.',
  },
  {
    value: '< 1 min',
    label: 'Default Boot Path',
    note: 'Pull the image, start the container, export the env block, and begin testing locally.',
  },
  {
    value: `${optIn.length}`,
    label: 'Opt-in Runtime Services',
    note: 'Compute-oriented surfaces stay clearly marked when Docker-backed behavior is required.',
  },
];
---

<BaseLayout title="Services — LocalCloud" description="Major Google Cloud services organized by product category for local development.">
  <Header />

  <main id="main-content" class="site-page">
    <!-- Service filter bar -->
    <section class="site-section site-section--tight" style="padding-bottom: 0;">
      <div class="container">
        <div class="service-filter" data-service-filter>
          <div class="service-filter__search">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="flex: 0 0 auto; color: var(--text-3);">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
            <input
              type="search"
              class="service-filter__input"
              placeholder="Filter services…"
              autocomplete="off"
              data-filter-input
            />
          </div>
          <div class="service-filter__toggles">
            <button type="button" class="service-filter__toggle is-active" data-filter-status="all">All</button>
            <button type="button" class="service-filter__toggle" data-filter-status="enabled">Default-on</button>
            <button type="button" class="service-filter__toggle" data-filter-status="optin">Opt-in</button>
          </div>
        </div>
      </div>
    </section>

    {categoryGroups.map((group) => (
      <section class="site-section site-section--tight">
        <div class="container">
          <div class="site-section-heading reveal">
            <span class="site-kicker">{group.title}</span>
            <h3>{group.title} services for local development.</h3>
            <p>{group.description}</p>
          </div>

          <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3 stagger">
            {group.items.map((service) => (
              <a
                href={`${base}services/${service.slug}/`}
                data-service-name={service.name.toLowerCase()}
                data-service-desc={service.description.toLowerCase()}
                data-service-enabled={String(service.enabled)}
                data-service-category={group.id}
                class:list={[
                  'site-panel reveal p-5 transition-transform hover:-translate-y-0.5',
                  !service.enabled && 'site-panel--soft',
                ]}
              >
                <div class="flex items-start justify-between gap-3">
                  <div class="flex min-w-0 items-start gap-3">
                    <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[var(--surface-2)]">
                      <ServiceIcon iconId={service.iconId} name={service.name} size={30} />
                    </span>
                    <div class="min-w-0">
                      <h3 class="text-xl">{service.name}</h3>
                      <div class="mt-2 font-mono text-[0.72rem] uppercase tracking-[0.12em] text-[var(--text-3)]">
                        {service.protocol} · {service.port}
                      </div>
                    </div>
                  </div>
                  <span class:list={['site-chip', service.enabled ? 'site-chip--success' : 'site-chip--warn']}>
                    {service.enabled ? 'Default-on' : 'Opt-in'}
                  </span>
                </div>

                <p class="mt-4 text-sm leading-7 text-[var(--text-2)]">{service.description}</p>

                <div class="mt-5 flex items-center justify-between gap-3 text-sm text-[var(--text-3)]">
                  <span>{service.supported.length} supported capabilities</span>
                  <span class="text-[var(--text)]">Details</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    ))}

    <section class="site-section site-section--hero">
      <div class="container grid gap-8 xl:grid-cols-[1fr,0.9fr]">
        <div class="reveal">
          <span class="site-eyebrow">
            <span class="site-eyebrow__pulse"></span>
            Service Catalog
          </span>
          <p class="mt-6 max-w-[44rem] text-lg leading-8 text-[var(--text-2)] sm:text-xl">
            LocalCloud provides health & usage for each service via in-built console app.
          </p>

          <div class="mt-8 grid gap-4 sm:grid-cols-3">
            {catalogStats.map((stat) => (
                <article class="site-panel site-panel--soft p-5">
                  <div class="text-4xl font-semibold tracking-[-0.08em] text-[var(--text)]">{stat.value}</div>
                  <div class="mt-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-[var(--accent-strong)]">{stat.label}</div>
                  <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">{stat.note}</p>
                </article>
              ))}
          </div>
        </div>
      </div>
    </section>

  </main>

  <script>
    (function() {
      var filterInput = document.querySelector('[data-filter-input]');
      var filterToggles = document.querySelectorAll('[data-filter-status]');
      var currentStatus = 'all';

      function updateFilter() {
        var query = (filterInput?.value || '').toLowerCase().trim();
        var sections = document.querySelectorAll('[data-service-section]');

        sections.forEach(function(section) {
          var cards = section.querySelectorAll('[data-service-name]');
          var visibleCount = 0;

          cards.forEach(function(card) {
            var name = card.dataset.serviceName || '';
            var desc = card.dataset.serviceDesc || '';
            var enabled = card.dataset.serviceEnabled === 'true';

            var matchesSearch = !query || name.includes(query) || desc.includes(query);
            var matchesStatus = currentStatus === 'all' ||
              (currentStatus === 'enabled' && enabled) ||
              (currentStatus === 'optin' && !enabled);

            if (matchesSearch && matchesStatus) {
              card.style.display = '';
              visibleCount++;
            } else {
              card.style.display = 'none';
            }
          });

          section.style.display = visibleCount > 0 ? '' : 'none';
        });
      }

      filterInput?.addEventListener('input', updateFilter);

      filterToggles.forEach(function(btn) {
        btn.addEventListener('click', function() {
          filterToggles.forEach(function(b) { b.classList.remove('is-active'); });
          btn.classList.add('is-active');
          currentStatus = btn.dataset.filterStatus || 'all';
          updateFilter();
        });
      });
    })();
  </script>

  <Footer />
</BaseLayout>
