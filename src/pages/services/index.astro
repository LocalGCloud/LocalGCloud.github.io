---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import { availableServiceCount, comingSoonServiceCount, getServiceSignalLabel, publishedServiceCount, serviceCategoryMeta, serviceCategoryOrder, services } from '../../data/services';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

const categoryGroups = serviceCategoryOrder
  .map((category) => ({
    id: category,
    title: serviceCategoryMeta[category].label,
    description: serviceCategoryMeta[category].description,
    items: services.filter((service) => service.category === category),
  }))
  .filter((group) => group.items.length > 0);

---

<BaseLayout title={`LocalCloud Services — ${publishedServiceCount} Service Guides`} description={`Browse ${availableServiceCount} available LocalCloud services and ${comingSoonServiceCount} upcoming addition by category, endpoint, tier, and documented workflows.`}>
  <Header />
  <main id="main-content" class="site-page">
    <section class="site-section site-section--hero" style="padding-bottom: 0;">
      <div class="container">
        <div class="max-w-[52rem] reveal">
          <span class="site-eyebrow"><span class="site-eyebrow__pulse"></span>{availableServiceCount} available services</span>
          <h1 class="mt-4">LocalCloud service catalog</h1>
          <p class="mt-4 text-lg leading-8 text-[var(--text-2)]">
            Find connection details and documented local workflows for every available service. Roadmap additions are clearly marked as coming soon.
          </p>
        </div>
      </div>
    </section>

    <section class="site-section site-section--tight" style="padding-bottom: 0;">
      <div class="container">
        <div class="service-filter" data-service-filter>
          <div class="service-filter__search">
            <label class="sr-only" for="service-search">Search services</label>
            <input id="service-search" type="search" class="service-filter__input" placeholder={`Search ${publishedServiceCount} service guides…`} autocomplete="off" data-filter-input />
          </div>
        </div>
      </div>
    </section>

    {categoryGroups.map((group) => (
      <section class="site-section site-section--tight" data-service-section>
        <div class="container">
          <div class="site-section-heading reveal">
            <span class="site-kicker">{group.title}</span>
            <h2>{group.title} services</h2>
            <p>{group.description}</p>
          </div>
          <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3 stagger">
            {group.items.map((service) => (
              <a href={`${base}services/${service.slug}/`}
                data-service-name={service.name.toLowerCase()}
                data-service-desc={service.description.toLowerCase()}
                class="site-panel reveal p-5 transition-transform hover:-translate-y-0.5">
                <div class="flex items-start justify-between gap-3">
                  <div class="flex min-w-0 items-start gap-3">
                    <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[var(--surface-2)]">
                      <ServiceIcon iconId={service.iconId} name={service.name} size={30} />
                    </span>
                    <div class="min-w-0">
                      <h3 class="text-xl">{service.name}</h3>
                      <div class="mt-2 font-mono text-[0.72rem] uppercase tracking-[0.12em] text-[var(--text-3)]">
                        {service.catalogState === 'coming-soon' ? 'Planned addition' : service.endpointLabel}
                      </div>
                    </div>
                  </div>
                  <span class="site-chip site-chip--accent">{getServiceSignalLabel(service)}</span>
                </div>
                <p class="mt-4 text-sm leading-7 text-[var(--text-2)]">{service.description}</p>
                <div class="mt-5 text-sm font-medium text-[var(--text)]">View service guide</div>
              </a>
            ))}
          </div>
        </div>
      </section>
    ))}

    <section class="site-section">
      <div class="container">
        <aside class="callout callout--warning" role="note">
          <div class="callout__body">
            <p class="callout__title">Technical availability is not a license grant</p>
            <div class="callout__content"><p>The governing proprietary license controls permitted use. Review it before personal, employer, organization, commercial, internal-tool, or CI use. Validate production behavior separately against real Google Cloud.</p></div>
          </div>
        </aside>
      </div>
    </section>
  </main>

  <script>
    (function() {
      var input = document.querySelector('[data-filter-input]');
      function update() {
        var query = (input?.value || '').toLowerCase().trim();
        document.querySelectorAll('[data-service-section]').forEach(function(section) {
          var visible = 0;
          section.querySelectorAll('[data-service-name]').forEach(function(card) {
            var searchMatch = !query || (card.dataset.serviceName || '').includes(query) || (card.dataset.serviceDesc || '').includes(query);
            card.style.display = searchMatch ? '' : 'none';
            if (searchMatch) visible++;
          });
          section.style.display = visible ? '' : 'none';
        });
      }
      input?.addEventListener('input', update);
    })();
  </script>
  <Footer />
</BaseLayout>
