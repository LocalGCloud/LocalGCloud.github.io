---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import ServiceFilterBootstrap from '../../components/ServiceFilterBootstrap.astro';
import { availableServiceCount, comingSoonServiceCount, getServiceSignalLabel, publishedServiceCount, serviceCatalogGroups } from '../../data/services';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

// The canonical catalog, in the shared catalog order.
const categoryGroups = serviceCatalogGroups;

---

<BaseLayout title={`LocalCloud Services — ${publishedServiceCount} Service Guides`} description={`Browse guides for ${publishedServiceCount} Google Cloud services in LocalCloud: ${availableServiceCount} run locally with setup steps, workflows, and code examples; ${publishedServiceCount - availableServiceCount} are unsupported.`}>
  <Header />
  <main id="main-content" class="site-page service-catalog-page" data-service-catalog>
    <section class="site-section site-section--hero" style="padding-bottom: 0;">
      <div class="container">
        <div class="max-w-[52rem]">
          <p class="desktop-catalog-breadcrumb" data-desktop-copy data-pagefind-ignore><a href={base}>Home</a> / Services</p>
          <span class="site-eyebrow" data-classic-copy><span class="site-eyebrow__pulse"></span>{availableServiceCount} local services</span>
          <h1 class="mt-4"><span data-classic-copy>LocalCloud service catalog</span></h1>
          <template data-desktop-headline data-desktop-copy data-pagefind-ignore><span data-desktop-copy data-pagefind-ignore>Service catalog</span></template>
          <p class="mt-4 text-lg leading-8 text-[var(--text-2)]">
            <span data-classic-copy>Find connection details, workflows, and limits for every local service. Services that don't run locally are marked Unsupported.</span>
            <span data-desktop-copy data-pagefind-ignore>Find a local service, explore its workflows and connect your tools.<br />{availableServiceCount} local services</span>
          </p>
        </div>
      </div>
    </section>

    <section class="site-section site-section--tight" style="padding-bottom: 0;">
      <div class="container">
        <div class="service-filter" data-service-filter>
          <div class="service-filter__search">
            <label class="sr-only" for="service-search">Search services</label>
            <input id="service-search" type="search" class="service-filter__input" placeholder={`Search ${publishedServiceCount} service guides…`} autocomplete="off" data-filter-input />
          </div>
          <a class="desktop-catalog-compatibility" href={base + 'compatibility/'} data-desktop-copy data-pagefind-ignore>Compatibility</a>
        </div>
        <nav class="desktop-catalog-categories" aria-label="Service categories" data-desktop-copy data-pagefind-ignore>{categoryGroups.map((group) => <a href={'#catalog-' + group.category}>{group.title}</a>)}</nav>
        <p class="catalog-empty" data-service-empty hidden data-desktop-copy data-pagefind-ignore>No matching services. Try another service name.</p>
      </div>
    </section>

    {categoryGroups.map((group) => (
      <section class="site-section site-section--tight" id={'catalog-' + group.category} data-service-section>
        <div class="container">
          <div class="site-section-heading reveal">
            <span class="site-kicker" data-classic-copy>{group.title}</span>
            <h2><span data-classic-copy>{group.category === 'auxiliary' ? 'Auxiliary integration APIs' : `${group.title} services`}</span><span data-desktop-copy data-pagefind-ignore>{group.title}</span></h2>
            <p>{group.description}</p>
          </div>
          <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3 stagger">
            {group.items.map((service) => (
              <a href={`${base}services/${service.slug}/`}
                data-service-name={service.name.toLowerCase()}
                data-service-desc={service.description.toLowerCase()}
                class="site-panel reveal min-w-0 p-5 transition-transform hover:-translate-y-0.5">
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <div class="flex min-w-0 items-start gap-3">
                    <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[var(--surface-2)]">
                      <ServiceIcon iconId={service.iconId} name={service.name} size={30} />
                    </span>
                    <div class="min-w-0">
                      <h3 class="text-xl">{service.name}</h3>
                      <div class="mt-2 font-mono text-xs uppercase tracking-[0.12em] text-[var(--text-2)]">
                        {service.catalogState === 'coming-soon' ? 'No local endpoint' : service.endpointLabel}
                      </div>
                    </div>
                  </div>
                  <span class:list={['site-chip', getServiceSignalLabel(service) === 'Unsupported' ? 'site-chip--warn' : 'site-chip--accent']}>{getServiceSignalLabel(service)}</span>
                </div>
                <p class="mt-4 text-sm leading-7 text-[var(--text-2)]" title={service.description}>{service.description}</p>
                <div class="mt-5 text-sm font-semibold text-[var(--text)]">{service.category === 'auxiliary' ? 'View integration guide' : 'View service guide'}</div>
              </a>
            ))}
          </div>
        </div>
      </section>
    ))}

    <section class="site-section">
      <div class="container">
        <aside class="callout callout--warning" role="note">
          <div class="callout__body">
            <p class="callout__title">Technical availability is not a license grant</p>
            <div class="callout__content"><p>The governing proprietary license controls permitted use. Review it before personal, employer, organization, commercial, internal-tool, or CI use. Validate production behavior separately against real Google Cloud.</p></div>
          </div>
        </aside>
      </div>
    </section>
  </main>

  <ServiceFilterBootstrap />
  <Footer />
</BaseLayout>
