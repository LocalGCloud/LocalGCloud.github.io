---
import LandingLayout from '../layouts/LandingLayout.astro';
import CopyButton from '../components/CopyButton.astro';
import Callout from '../components/Callout.astro';
import ServiceIcon from '../components/ServiceIcon.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

const dockerCmd = `docker pull jaysen2apache/localcloud

docker volume create localcloud-data

docker run -d \\
  -p 24080:24080 -p 24081:24081 \\
  -p 8085-8087:24082-8087 \\
  -p 24085:24085 -p 24086:24086 \\
  -p 24087:24087 -p 24088:24088 \\
  -p 6379:24089 \\
  -m 4g --name localcloud \\
  -v localcloud-data:/var/lib/localcloud \\
  jaysen2apache/localcloud

# Export BigQuery environment variable
export BIGQUERY_EMULATOR_HOST=http://localhost:24087

# Your first local BigQuery query
bq query --nouse_legacy_sql \\
  "SELECT name, SUM(number) as total
   FROM bigquery-public-data.usa_names.usa_1910_2013
   GROUP BY name
   ORDER BY total DESC
   LIMIT 10"`;

const pythonCode = `from google.cloud import bigquery
import os

# Point SDK at local emulator
os.environ["BIGQUERY_EMULATOR_HOST"] = "http://localhost:24087"

client = bigquery.Client(project="local-project")

query = \"\"\"
    SELECT name, SUM(number) as total
    FROM bigquery-public-data.usa_names.usa_1910_2013
    GROUP BY name
    ORDER BY total DESC
    LIMIT 10
\"\"\"
results = client.query(query).result()
for row in results:
    print(f\"{row.name}: {row.total}\")`;

const goCode = `ctx := context.Background()
client, _ := bigquery.NewClient(ctx, "local-project")

q := client.Query(
    "SELECT name, SUM(number) as total " +
    "FROM usa_names.usa_1910_2013 " +
    "GROUP BY name ORDER BY total DESC LIMIT 10")

it, _ := q.Read(ctx)
for {
    var row []bigquery.Value
    err := it.Next(&row)
    if err == iterator.Done { break }
    fmt.Printf(\"%v: %v\\n\", row[0], row[1])
}`;

const ciYaml = `jobs:
  bigquery-tests:
    runs-on: ubuntu-latest
    services:
      localcloud:
        image: jaysen2apache/localcloud
        ports:
          - 24087:24087
        options: --memory 4g

    steps:
      - uses: actions/checkout@v4

      - name: Wait for LocalCloud
        run: |
          for i in $(seq 1 30); do
            curl -sf http://localhost:24080/_localcloud/health && break
            sleep 2
          done

      - name: Run BigQuery tests
        env:
          BIGQUERY_EMULATOR_HOST: http://localhost:24087
        run: pytest tests/bigquery/`;

const keyStats = [
  { value: '~96%', label: 'SQL coverage', note: 'DQL, DDL, DML, scripting, and procedures across 936 collected tests.' },
  { value: '200+', label: 'Mapped functions', note: 'GoogleSQL built-in functions mapped to DuckDB, SQL rewrites, and Python UDFs.' },
  { value: '936', label: 'Collected tests', note: 'Across 25 test modules, 932 passing. Test-evidence-based coverage.' },
  { value: 'REST + gRPC', label: 'Dual API support', note: 'Both the REST API and simplified gRPC Storage API for SDK compatibility.' },
];

const features = [
  { category: 'SQL & Querying', supported: true, items: [
    'SELECT, JOIN, CTE, window functions',
    'GROUP BY, ROLLUP, CUBE, GROUPING SETS',
    'Pipe syntax, PIVOT, UNPIVOT, TABLESAMPLE',
    'QUALIFY, correlated subqueries',
    'Wildcard tables, _TABLE_SUFFIX'
  ]},
  { category: 'DDL & DML', supported: true, items: [
    'CREATE TABLE, IF NOT EXISTS, OR REPLACE',
    'INSERT, UPDATE, DELETE, MERGE',
    'Views, materialized views, external tables',
    'CREATE SNAPSHOT TABLE, CLONE TABLE',
    'TRUNCATE TABLE, column DEFAULT'
  ]},
  { category: 'Scripting & Procedures', supported: true, items: [
    'DECLARE, SET, EXECUTE IMMEDIATE',
    'IF/ELSE, LOOP, WHILE, FOR...IN',
    'Stored procedures with IN/OUT/INOUT parameters',
    'BEGIN...EXCEPTION error handling',
    'Multi-statement transactions'
  ]},
  { category: 'Functions & Operators', supported: true, items: [
    '200+ GoogleSQL built-in functions',
    'String, date/time, math, aggregate, window',
    'ARRAY, STRUCT, JSON, NET functions',
    'SAFE-prefixed functions, UDF support',
    'Geography (partial — 12 ST_* functions)'
  ]},
  { category: 'APIs & Connectivity', supported: true, items: [
    'REST API (jobs.query, jobs.insert, tabledata.list)',
    'Simplified gRPC Storage API (ReadRows)',
    'Python, Go, Java, Node.js SDK compatibility',
    'INFORMATION_SCHEMA views',
    'Terraform google_bigquery_* resources'
  ]},
];

const limitsItems = [
  { text: 'BigQuery ML (BQML) — CREATE MODEL, ML.PREDICT, and related ML functions are not supported. Use scikit-learn, XGBoost, or TensorFlow locally instead.' },
  { text: 'Encryption & security policy enforcement — CMEK, customer-managed encryption keys, column-level security, and data masking policies are emulated as no-ops (does not block local tests).' },
  { text: 'Full geography parity — GEOGRAPHY type works for 12 ST_* functions. Advanced GIS operations, S2 cell functions, and full BigQuery Geography functions are not yet mapped.' },
  { text: 'BigQuery Omni — cross-cloud queries against AWS and Azure datasets are not supported in local emulation.' },
  { text: 'Reservation API, capacity commitments, slot management — billing and capacity features are not available in local emulation.' },
  { text: 'Streaming insert (tabledata.insertAll) is available at gRPC level; the REST endpoint returns success but is not validated end-to-end.' },
];

const faqItems = [
  {
    q: 'How complete is the BigQuery SQL coverage?',
    a: '~96% SQL coverage across DQL, DDL, DML, scripting, and stored procedures — validated by 936 collected tests across 25 test modules. The emulator covers the features teams reach for daily: SELECT with joins/CTEs/window functions, CREATE TABLE, INSERT/UPDATE/DELETE/MERGE, scripting, and 200+ built-in functions.',
  },
  {
    q: 'Does the BigQuery emulator support the Storage Read API?',
    a: 'Yes — a simplified gRPC Storage Read API (ReadRows) is available for high-throughput data access. This covers the most common SDK read paths used by Python and Java BigQuery clients.',
  },
  {
    q: 'Can I run BigQuery integration tests in CI/CD?',
    a: 'Yes. Add LocalCloud as a service container in GitHub Actions, GitLab CI, or Jenkins, set BIGQUERY_EMULATOR_HOST, and your integration tests run against the local BigQuery emulator at zero cloud query cost per pipeline execution.',
  },
  {
    q: 'What happens when my query uses an unsupported feature?',
    a: 'The emulator returns a clear error message identifying the unsupported function or syntax. This lets you catch gaps during local development rather than discovering them in production. Most queries that use standard SQL, DDL, and scripting features run without modification.',
  },
];
---

<LandingLayout
  title="BigQuery Emulator — Run BigQuery Locally in Docker"
  description="Test BigQuery SQL, DDL, DML, and scripting locally with ~96% SQL coverage and 936 collected tests. DuckDB-backed BigQuery emulator for local development and CI/CD — zero cloud query costs."
>
  <script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
    {
      "@type": "Question",
      "name": "How complete is the BigQuery SQL coverage?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "~96% SQL coverage across DQL, DDL, DML, scripting, and stored procedures — validated by 936 collected tests across 25 test modules. The emulator covers the features teams reach for daily."
      }
    },
    {
      "@type": "Question",
      "name": "Does the BigQuery emulator support the Storage Read API?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes — a simplified gRPC Storage Read API (ReadRows) is available for high-throughput data access. This covers the most common SDK read paths used by Python and Java BigQuery clients."
      }
    }
  ]
}
  </script>

  <!-- HERO -->
  <section class="site-section site-section--hero">
    <div class="container">
      <div class="max-w-[48rem] reveal">
        <span class="site-eyebrow">
          <span class="site-eyebrow__pulse"></span>
          BigQuery Emulator
        </span>
        <h1 class="mt-4">Run BigQuery SQL locally — no cloud costs</h1>
        <p class="mt-6 text-lg leading-8 text-[var(--text-2)] sm:text-xl">
          A DuckDB-backed BigQuery emulator with ~96% SQL coverage, 936 collected tests, and 200+ mapped functions. Test queries, pipelines, and ETL locally before they hit production.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`${base}docs/`} class="site-button site-button--primary">Get started</a>
          <a href={`${base}docs/bigquery-feature-comparison/`} class="site-button site-button--secondary">Feature comparison</a>
          <a href={`${base}docs/bigquery-coverage-gaps/`} class="site-button site-button--secondary">Coverage gaps</a>
        </div>
      </div>

      <div class="mt-12 grid gap-4 sm:grid-cols-4 reveal">
        {keyStats.map(stat => (
          <article class="site-panel site-panel--soft p-5">
            <div class="text-3xl font-semibold tracking-[-0.08em] text-[var(--text)]">{stat.value}</div>
            <div class="mt-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-[var(--accent-strong)]">{stat.label}</div>
            <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">{stat.note}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- THE GAP -->
  <section class="site-section site-section--tight">
    <div class="container">
      <div class="reveal">
        <span class="site-eyebrow"><span class="site-eyebrow__pulse"></span>The Gap</span>
        <h2 class="mt-4">Why you need a BigQuery emulator</h2>
        <p class="mt-4 max-w-[44rem] text-lg leading-8 text-[var(--text-2)]">Google does not provide an official BigQuery emulator. Teams either pay for real BigQuery queries during development — accumulating significant cloud costs on every test run — or skip local testing entirely, discovering schema and query issues only after deploying to production.</p>
        <div class="mt-8 grid gap-4 sm:grid-cols-3">
          <article class="site-panel site-panel--soft p-5">
            <div class="text-3xl font-semibold tracking-[-0.08em] text-[var(--text)]">$5-50</div>
            <div class="mt-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-[var(--accent-strong)]">Per CI run</div>
            <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Every integration test that touches BigQuery costs money. Over 200+ pipeline runs per day, that adds up fast.</p>
          </article>
          <article class="site-panel site-panel--soft p-5">
            <div class="text-3xl font-semibold tracking-[-0.08em] text-[var(--text)]">No emulator</div>
            <div class="mt-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-[var(--accent-strong)]">From Google</div>
            <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Google provides emulators for Pub/Sub, Firestore, and Spanner. BigQuery is the largest gap in Google's local development story.</p>
          </article>
          <article class="site-panel site-panel--soft p-5">
            <div class="text-3xl font-semibold tracking-[-0.08em] text-[var(--text)]">&lt;1 ms</div>
            <div class="mt-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-[var(--accent-strong)]">Local latency</div>
            <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">BigQuery queries return in sub-milliseconds locally instead of 2-5 seconds over the network. Your inner loop stays fast.</p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="site-section">
    <div class="container">
      <div class="reveal">
        <h2>How the BigQuery emulator works</h2>
        <p class="mt-4 max-w-[44rem] text-lg leading-8 text-[var(--text-2)]">
          LocalCloud's BigQuery emulator is built on DuckDB — a high-performance, embedded analytical database. It translates GoogleSQL syntax and wire protocols into DuckDB's engine, providing sub-millisecond query latency and SQL coverage that covers the vast majority of development and testing workloads.
        </p>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-3 reveal">
        <article class="site-panel p-5">
          <span class="site-kicker">GoogleSQL → DuckDB</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">
            GoogleSQL queries are parsed, transformed, and executed on DuckDB's engine. 200+ BigQuery built-in functions are mapped to DuckDB equivalents, SQL rewrites, and Python UDFs.
          </p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">REST + gRPC APIs</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">
            Both the BigQuery REST API (jobs.query, jobs.insert) and a simplified gRPC Storage API are available — so your Python, Go, and Java SDKs connect without code changes.
          </p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">936 collected tests</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">
            Coverage is test-evidence-based: 936 collected tests across 25 test modules validate query parsing, type coercion, function mapping, and API behavior — with 932 passing.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- FEATURE GRID -->
  <section class="site-section">
    <div class="container">
      <div class="reveal">
        <h2>What's covered</h2>
      </div>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 xl:grid-cols-3 reveal">
        {features.map(feature => (
          <div class="site-panel p-5">
            <h3 class="text-lg font-semibold text-[var(--text)]">{feature.category}</h3>
            <ul class="site-list mt-3">
              {feature.items.map(item => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CODE EXAMPLES -->
  <section class="site-section">
    <div class="container">
      <div class="reveal">
        <h2>Same SDKs, same code</h2>
        <p class="mt-4 max-w-[44rem] text-lg leading-8 text-[var(--text-2)]">
          Your existing BigQuery SDK code runs unchanged against the local emulator. Just set one environment variable.
        </p>
      </div>
      <div class="mt-6 grid gap-6 lg:grid-cols-2 reveal">
        <div class="site-panel overflow-hidden">
          <div class="px-4 pt-3 pb-2"><span class="site-kicker">Python</span></div>
          <pre class="border-0 rounded-none bg-transparent"><code class="block px-4 pb-4 text-[0.78rem] leading-[1.7]">{pythonCode}</code></pre>
        </div>
        <div class="site-panel overflow-hidden">
          <div class="px-4 pt-3 pb-2"><span class="site-kicker">Go</span></div>
          <pre class="border-0 rounded-none bg-transparent"><code class="block px-4 pb-4 text-[0.78rem] leading-[1.7]">{goCode}</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- CI/CD INTEGRATION -->
  <section class="site-section">
    <div class="container">
      <div class="reveal">
        <span class="site-eyebrow"><span class="site-eyebrow__pulse"></span>CI / CD</span>
        <h2 class="mt-4">Run BigQuery tests in your CI pipeline</h2>
        <p class="mt-4 max-w-[44rem] text-lg leading-8 text-[var(--text-2)]">Add LocalCloud as a service container. Integration tests run against local BigQuery at zero query cost.</p>
        <div class="mt-6">
          <a href={`${base}gcp-integration-testing/`} class="site-button site-button--primary">See integration guide</a>
        </div>
      </div>
    </div>
  </section>

  <!-- LIMITS -->
  <section class="site-section">
    <div class="container">
      <div class="reveal">
        <h2>What's not covered</h2>
        <p class="mt-4 max-w-[44rem] text-lg leading-8 text-[var(--text-2)]">
          The BigQuery emulator targets local development and CI testing — not production workloads. These features are intentionally out of scope.
        </p>
      </div>
      <div class="mt-6 grid gap-3 reveal">
        {limitsItems.map(item => (
          <div class="site-panel site-panel--soft p-4">
            <p class="text-sm leading-7 text-[var(--text-2)]">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="site-section">
    <div class="container container--narrow">
      <div class="reveal">
        <h2>Frequently asked questions</h2>
      </div>
      <div class="mt-6 grid gap-3 reveal">
        {faqItems.map(item => (
          <details class="site-panel p-5 cursor-pointer">
            <summary class="font-semibold text-[var(--text)] text-[1.05rem]">{item.q}</summary>
            <p class="mt-3 text-[var(--text-2)] leading-7">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- BOTTOM CTA -->
  <section class="site-section">
    <div class="container">
      <div class="site-panel p-8 reveal" style="background: linear-gradient(135deg, rgba(31, 39, 50, 0.96), rgba(34, 42, 53, 0.98));">
        <div class="grid gap-6 xl:grid-cols-[1fr,auto] items-center">
          <div>
            <h2 style="color: #e8eaed;">Start testing BigQuery locally</h2>
            <p class="mt-3 text-lg leading-8" style="color: rgba(246, 239, 228, 0.74);">
              Run BigQuery locally with DuckDB-backed emulation. All standard SQL, scripting, external tables, and Storage API — no cloud bills during development.
            </p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a href={`${base}docs/`} class="site-button site-button--secondary">Read the docs</a>
            <a href={`${base}services/bigquery/`} class="site-button site-button--primary">BigQuery service details</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</LandingLayout>
