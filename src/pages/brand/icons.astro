---
import LandingLayout from '../../layouts/LandingLayout.astro';
import FeatureIcon from '../../components/FeatureIcon.astro';
import StatusIcon from '../../components/StatusIcon.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

const brandIcons = [
  {
    name: 'App Icon (Squircle)',
    file: 'brand/localcloud-app-icon.svg',
    size: 96,
    desc: 'Desktop launcher, Docker Desktop extension, and macOS dock icon with container core and status LEDs.',
  },
  {
    name: 'App Icon (3D Render)',
    file: 'brand/localcloud-app-icon-3d.jpg',
    size: 96,
    desc: 'High-res 3D glassmorphic rendered asset for social share cards, hero sections, and marketing.',
  },
  {
    name: 'Vector App Mark',
    file: 'brand/localcloud-icon.svg',
    size: 64,
    desc: 'Scalable vector mark optimized for small-canvas visibility, favicon, and app headers.',
  },
  {
    name: 'CLI / Terminal Icon',
    file: 'brand/localcloud-cli-icon.svg',
    size: 64,
    desc: 'Developer console and terminal tooling icon for localcloud CLI commands.',
  },
  {
    name: 'System Tray / Menu Bar',
    file: 'brand/localcloud-tray-icon.svg',
    size: 32,
    desc: 'Monochrome template icon for the macOS menu bar and Windows/Linux system tray.',
  },
  {
    name: 'Dark Canvas Mark',
    file: 'brand/localcloud-mark-dark.svg',
    size: 64,
    desc: 'Slate and dark terminal surface brand mark with neon edge accents.',
  },
  {
    name: 'Light Canvas Mark',
    file: 'brand/localcloud-mark-light.svg',
    size: 64,
    desc: 'High-contrast light background mark for documentation and papers.',
  },
  {
    name: 'Root Favicon',
    file: 'favicon.svg',
    size: 32,
    desc: 'Browser tab and bookmark icon with high-contrast Google status points.',
  },
];

const featureIcons = [
  { id: 'local-runtime', title: 'Local Runtime', desc: 'Single Docker container execution core' },
  { id: 'zero-cloud-bill', title: 'Zero Cloud Bill', desc: 'No cloud billing or unexpected usage costs' },
  { id: 'instant-iteration', title: 'Instant Iteration', desc: 'Sub-second inner feedback loop' },
  { id: 'real-sdks', title: 'Real Google Cloud SDKs', desc: 'Zero code modifications or proxy forks' },
  { id: 'mock-free', title: 'Mock-Free Fidelity', desc: 'Verified emulation instead of brittle stubs' },
  { id: 'web-console', title: 'Web Console', desc: 'Visual state inspection and management UI' },
  { id: 'offline-first', title: 'Offline First', desc: 'Complete airplane mode & air-gapped development' },
  { id: 'port-matrix', title: 'Port Matrix', desc: '20+ services routed across predictable ports' },
  { id: 'state-snapshot', title: 'State Snapshots', desc: 'Disk persistence and emulator state seeding' },
  { id: 'ci-pipeline', title: 'CI Pipeline', desc: 'Headless automation for GitHub Actions and CI' },
];

const statusIcons = [
  { id: 'running', title: 'Healthy / Running', color: '#188038', desc: 'Active container with healthy gRPC/REST healthcheck' },
  { id: 'starting', title: 'Starting / Booting', color: '#1a73e8', desc: 'Container initializing services and mapping ports' },
  { id: 'stopped', title: 'Stopped / Idle', color: '#7d8faa', desc: 'Container stopped or paused by developer' },
  { id: 'degraded', title: 'Degraded / Warning', color: '#b86e18', desc: 'One or more background sub-emulators slow or restarting' },
  { id: 'error', title: 'Error / Failed', color: '#ea4335', desc: 'Port collision, OOM, or initialization error' },
] as const;
---

<LandingLayout
  title="LocalCloud Brand & Project Icons | LocalCloud"
  description="Explore the official icon suite for LocalCloud: app icons, CLI badges, feature symbols, and runtime status indicators."
>
  <div class="container py-12">
    <!-- Header -->
    <div class="max-w-3xl mb-12">
      <div class="flex items-center gap-2 mb-3">
        <span class="site-chip site-chip--accent font-mono text-xs uppercase">Brand Assets</span>
        <span class="text-xs text-[var(--text-2)] font-mono">v1.0 • Monoline 1.8px • Vector SVG</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-semibold tracking-tight text-[var(--text)] mb-4">
        LocalCloud Brand & Project Icons
      </h1>
      <p class="text-base sm:text-lg text-[var(--text-2)] leading-relaxed">
        The official visual iconography for LocalCloud: designed for developer tooling clarity,
        scalable from 16px favicons to 512px app store launchers, matching the Google Cloud developer workbench aesthetic.
      </p>
    </div>

    <!-- Background Switcher Control -->
    <div class="flex flex-wrap items-center gap-3 mb-8 p-3 rounded-xl border border-[var(--line)] bg-[var(--surface-2)] text-xs font-mono">
      <span class="text-[var(--text)] font-semibold">Preview Canvas:</span>
      <button class="bg-white border border-slate-200 px-3 py-1.5 rounded-xl text-slate-800 hover:border-[var(--accent)] transition" onclick="document.querySelectorAll('.icon-preview-box').forEach(el => el.style.backgroundColor='#ffffff')">Light (#FFF)</button>
      <button class="bg-slate-100 border border-slate-300 px-3 py-1.5 rounded-xl text-slate-800 hover:border-[var(--accent)] transition" onclick="document.querySelectorAll('.icon-preview-box').forEach(el => el.style.backgroundColor='#f4f7fb')">Studio (#F4F7FB)</button>
      <button class="bg-slate-800 border border-slate-700 px-3 py-1.5 rounded-xl text-white hover:border-[var(--brand-sky)] transition" onclick="document.querySelectorAll('.icon-preview-box').forEach(el => el.style.backgroundColor='#12233d')">Navy (#12233D)</button>
      <button class="bg-slate-950 border border-slate-800 px-3 py-1.5 rounded-xl text-white hover:border-[var(--brand-sky)] transition" onclick="document.querySelectorAll('.icon-preview-box').forEach(el => el.style.backgroundColor='#0f172a')">Terminal (#0F172A)</button>
    </div>

    <!-- SECTION 1: Brand & App Icons -->
    <section class="mb-16">
      <div class="border-b border-[var(--line)] pb-4 mb-8">
        <h2 class="text-xl sm:text-2xl font-semibold text-[var(--text)]">1. Company & Brand Identity Icons</h2>
        <p class="text-sm text-[var(--text-2)] mt-1">Application launchers, menu bar monitors, CLI tooling badges, and favicons.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {brandIcons.map((icon) => (
          <div class="rounded-2xl border border-[var(--line)] bg-[var(--surface)] p-5 flex flex-col justify-between hover:border-[var(--border-hover)] transition">
            <div>
              <div class="icon-preview-box h-32 rounded-xl flex items-center justify-center border border-[var(--line)] bg-white transition-colors duration-200 mb-4 p-3">
                <img
                  src={`${base}${icon.file}`}
                  alt={icon.name}
                  class="max-h-full object-contain drop-shadow-sm"
                  style={`width: ${icon.size}px; height: ${icon.size}px;`}
                />
              </div>
              <h3 class="font-semibold text-[var(--text)] text-sm mb-1">{icon.name}</h3>
              <p class="text-xs text-[var(--text-2)] leading-relaxed mb-3">{icon.desc}</p>
            </div>
            <div class="pt-3 border-t border-[var(--line)] flex items-center justify-between gap-3 text-xs font-mono text-[var(--text-2)]">
              <span class="min-w-0 truncate">{icon.file}</span>
              <a
                href={`${base}${icon.file}`}
                download
                class="shrink-0 font-semibold text-xs text-[var(--accent-strong)] hover:underline"
              >
                SVG ↗
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- SECTION 2: Product & Feature Icons -->
    <section class="mb-16">
      <div class="border-b border-[var(--line)] pb-4 mb-8">
        <h2 class="text-xl sm:text-2xl font-semibold text-[var(--text)]">2. Product Feature & Capability Icons</h2>
        <p class="text-sm text-[var(--text-2)] mt-1">Precision 24×24 monoline vector icons matching the Developer Workbench visual style.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
        {featureIcons.map((item) => (
          <div class="rounded-2xl border border-[var(--line)] bg-[var(--surface)] p-4 flex flex-col justify-between hover:border-[var(--border-hover)] transition">
            <div>
              <div class="icon-preview-box h-20 rounded-xl flex items-center justify-center border border-[var(--line)] bg-white text-slate-800 mb-3 transition-colors">
                <FeatureIcon name={item.id} size={36} />
              </div>
              <h3 class="font-semibold text-xs text-[var(--text)] mb-1">{item.title}</h3>
              <p class="text-xs text-[var(--text-2)] leading-snug">{item.desc}</p>
            </div>
            <div class="mt-3 pt-2 border-t border-[var(--line)] flex flex-wrap items-center justify-between gap-x-3 gap-y-1 text-xs font-mono text-[var(--text-2)]">
              <span>{item.id}.svg</span>
              <a href={`${base}icons/features/${item.id}.svg`} download class="font-semibold text-[var(--accent-strong)] hover:underline">Get SVG</a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- SECTION 3: Status & Health Icons -->
    <section class="mb-16">
      <div class="border-b border-[var(--line)] pb-4 mb-8">
        <h2 class="text-xl sm:text-2xl font-semibold text-[var(--text)]">3. Runtime Status & Health Indicators</h2>
        <p class="text-sm text-[var(--text-2)] mt-1">Status lights and healthcheck indicators for dashboard rows, logs, and CLI output.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
        {statusIcons.map((s) => (
          <div class="rounded-2xl border border-[var(--line)] bg-[var(--surface)] p-4 flex flex-col justify-between hover:border-[var(--border-hover)] transition">
            <div>
              <div class="icon-preview-box h-20 rounded-xl flex items-center justify-center border border-[var(--line)] bg-white mb-3 transition-colors">
                <StatusIcon status={s.id} size={32} />
              </div>
              <div class="flex items-center gap-1.5 mb-1">
                <span class="w-2 h-2 rounded-full" style={`background-color: ${s.color};`}></span>
                <h3 class="font-semibold text-xs text-[var(--text)]">{s.title}</h3>
              </div>
              <p class="text-xs text-[var(--text-2)] leading-snug">{s.desc}</p>
            </div>
            <div class="mt-3 pt-2 border-t border-[var(--line)] flex flex-wrap items-center justify-between gap-x-3 gap-y-1 text-xs font-mono text-[var(--text-2)]">
              <span>status-{s.id}.svg</span>
              <a href={`${base}icons/status/status-${s.id}.svg`} download class="font-semibold text-[var(--accent-strong)] hover:underline">Get SVG</a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- SECTION 4: Component Usage Guide -->
    <section class="rounded-2xl border border-[var(--line)] bg-[var(--surface-2)] p-6 sm:p-8">
      <h3 class="text-lg font-semibold text-[var(--text)] mb-2">Usage in Code</h3>
      <p class="text-sm text-[var(--text-2)] mb-6">
        Easily include these icons in any Astro layout, MDX documentation page, or frontend component.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="brand-terminal min-w-0 rounded-xl p-4">
          <div class="brand-terminal__label mb-2 font-mono font-semibold text-xs uppercase tracking-wider">// Feature Icon Component</div>
          <pre><code>{`import FeatureIcon from '../components/FeatureIcon.astro';

<FeatureIcon name="local-runtime" size={24} />
<FeatureIcon name="zero-cloud-bill" size={24} />
<FeatureIcon name="instant-iteration" size={24} />`}</code></pre>
        </div>

        <div class="brand-terminal min-w-0 rounded-xl p-4">
          <div class="brand-terminal__label mb-2 font-mono font-semibold text-xs uppercase tracking-wider">// Status Indicator Component</div>
          <pre><code>{`import StatusIcon from '../components/StatusIcon.astro';

<StatusIcon status="running" size={18} />
<StatusIcon status="starting" size={18} />
<StatusIcon status="error" size={18} />`}</code></pre>
        </div>
      </div>
    </section>
  </div>
</LandingLayout>

<style>
  .brand-terminal {
    --terminal-bg: #191f29;
    --terminal-ink: #e8eaed;
    --terminal-muted: rgba(232, 234, 237, 0.72);
    background: var(--terminal-bg);
  }

  .brand-terminal__label {
    color: var(--terminal-muted);
  }

  .brand-terminal pre {
    border-color: transparent;
    background: transparent;
  }

  .brand-terminal pre code {
    padding: 0;
    color: var(--terminal-ink);
  }
</style>
