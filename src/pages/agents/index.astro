---
import AgenticIndexPage from '../../components/AgenticIndexPage.astro';
import { agentSandboxPages } from '../../data/agenticContent';
---

<AgenticIndexPage
  title="Agent Sandboxes for Local Google Cloud"
  description="Agent sandboxes for Claude Code, Codex CLI, Cursor, and Gemini CLI: give each coding agent a local Google Cloud target with no cloud credentials."
  h1="Agent sandboxes for local Google Cloud"
  eyebrow="AI agents"
  deck="Pick the guide for your job: setting up your coding agent, testing one service locally, automating a workflow, comparing options, looking up a term, or following a demo."
  pages={agentSandboxPages}
  listHeading="Agent setup guides"
  sectionLinks={[
    { label: 'Service guides', href: '/services/', note: 'Each service that runs locally links its agent testing page with prompts and a local check.' },
    { label: 'Workflows', href: '/workflows/', note: 'GitHub Actions, Terraform, integration tests and team automation.' },
    { label: 'Comparisons', href: '/compare/', note: "LocalCloud next to LocalStack, Google's emulators and hosted agent sandboxes." },
    { label: 'Glossary', href: '/glossary/', note: 'Plain definitions of agent and local cloud terms.' },
    { label: 'Blog', href: '/blog/', note: 'Demo posts and announcements.' },
  ]}
/>
