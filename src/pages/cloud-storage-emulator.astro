---
import LandingLayout from '../layouts/LandingLayout.astro';
import ServiceIcon from '../components/ServiceIcon.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

const pythonCode = `import os
from google.cloud import storage

os.environ["STORAGE_EMULATOR_HOST"] = "http://localhost:24081"

client = storage.Client(project="local-project")
bucket = client.create_bucket("my-test-bucket")

blob = bucket.blob("data/sample.txt")
blob.upload_from_string("Hello, LocalCloud!")

# List objects
for blob in client.list_blobs("my-test-bucket"):
    print(f"{blob.name}: {blob.size} bytes")`;

const nodeCode = `process.env.STORAGE_EMULATOR_HOST = 'http://localhost:24081';

const { Storage } = require('@google-cloud/storage');
const storage = new Storage({ projectId: 'local-project' });

const [bucket] = await storage.createBucket('my-test-bucket');
await bucket.file('data/sample.txt').save('Hello, LocalCloud!');

// List objects
const [files] = await bucket.getFiles();
files.forEach(file => {
  console.log(file.name + ': ' + file.metadata.size + ' bytes');
});`;

const faqItems = [
  {
    q: 'How does LocalCloud emulate Cloud Storage?',
    a: 'LocalCloud integrates fake-gcs-server, a community-maintained Cloud Storage emulator, on port 24081. It provides bucket CRUD, object upload/download/list/delete/copy, object metadata, and multipart uploads — all using the standard Google Cloud Storage SDK.',
  },
  {
    q: 'Can I upload large files to the local Cloud Storage emulator?',
    a: 'Yes. The emulator supports multipart uploads for large files. Since storage is local to your machine, upload and download speeds are limited only by your disk I/O — no network latency, no egress charges.',
  },
  {
    q: 'Does LocalCloud persist Cloud Storage data between restarts?',
    a: 'Yes. Mount a Docker volume to /var/lib/localcloud and all buckets, objects, and metadata persist across container restarts. Your test data survives docker stop and docker rm.',
  },
];
---

<LandingLayout
  title="Cloud Storage Emulator — Local Google Cloud Storage in Docker"
  description="Run Google Cloud Storage locally with LocalCloud's bundled emulator. Test bucket CRUD, object uploads, and multipart transfers with zero egress costs — all in one Docker container alongside 20+ GCP services."
>
  <script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
    {
      "@type": "Question",
      "name": "How does LocalCloud emulate Cloud Storage?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "LocalCloud integrates fake-gcs-server, a community-maintained Cloud Storage emulator, on port 24081. It provides bucket CRUD, object upload/download/list/delete/copy, object metadata, and multipart uploads."
      }
    },
    {
      "@type": "Question",
      "name": "Can I upload large files to the local Cloud Storage emulator?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. The emulator supports multipart uploads for large files. Since storage is local to your machine, upload and download speeds are limited only by your disk I/O — no network latency, no egress charges."
      }
    }
  ]
}
  </script>

  <!-- HERO -->
  <section class="site-section site-section--hero">
    <div class="container">
      <div class="max-w-[48rem] reveal">
        <span class="site-eyebrow"><span class="site-eyebrow__pulse"></span>Cloud Storage Emulator</span>
        <h1 class="mt-4">Run Google Cloud Storage locally</h1>
        <p class="mt-6 text-lg leading-8 text-[var(--text-2)] sm:text-xl">
          Test bucket and object operations locally with zero egress costs. Upload, download, list, and delete objects using the standard GCS SDK — bundled with 20+ GCP services in one Docker container.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`${base}docs/`} class="site-button site-button--primary">Start in 60 seconds</a>
          <a href={`${base}services/cloud-storage/`} class="site-button site-button--secondary">Cloud Storage details</a>
          <a href={`${base}gcp-emulator/`} class="site-button site-button--secondary">GCP emulator overview</a>
        </div>
      </div>
      <div class="mt-12 grid gap-4 sm:grid-cols-3 reveal">
        <article class="site-panel site-panel--soft p-5">
          <div class="text-3xl font-semibold tracking-[-0.08em] text-[var(--text)]">$0</div>
          <div class="mt-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-[var(--accent-strong)]">Egress fees</div>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Upload, download, and transfer objects without cloud storage or egress charges.</p>
        </article>
        <article class="site-panel site-panel--soft p-5">
          <div class="text-3xl font-semibold tracking-[-0.08em] text-[var(--text)]">—</div>
          <div class="mt-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-[var(--accent-strong)]">No official emulator</div>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Google doesn't provide a Cloud Storage emulator. LocalCloud fills this critical gap.</p>
        </article>
        <article class="site-panel site-panel--soft p-5">
          <div class="text-3xl font-semibold tracking-[-0.08em] text-[var(--text)]">$0</div>
          <div class="mt-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-[var(--accent-strong)]">Egress costs</div>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Upload, download, and transfer objects with zero cloud storage or egress charges during development and testing.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- CODE EXAMPLE -->
  <section class="site-section">
    <div class="container">
      <div class="reveal">
        <h2>Same SDKs, same code</h2>
        <p class="mt-4 max-w-[44rem] text-lg leading-8 text-[var(--text-2)]">
          Your existing Cloud Storage SDK code runs unchanged against the local emulator. Just set one environment variable.
        </p>
      </div>
      <div class="mt-6 grid gap-6 lg:grid-cols-2 reveal">
        <div class="site-panel overflow-hidden">
          <div class="px-4 pt-3 pb-2"><span class="site-kicker">Python</span></div>
          <pre class="border-0 rounded-none bg-transparent"><code class="block px-4 pb-4 text-[0.78rem] leading-[1.7]">{pythonCode}</code></pre>
        </div>
        <div class="site-panel overflow-hidden">
          <div class="px-4 pt-3 pb-2"><span class="site-kicker">Node.js</span></div>
          <pre class="border-0 rounded-none bg-transparent"><code class="block px-4 pb-4 text-[0.78rem] leading-[1.7]">{nodeCode}</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="site-section">
    <div class="container">
      <div class="reveal">
        <h2>Features</h2>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-3 reveal">
        <article class="site-panel p-5">
          <span class="site-kicker">Bucket CRUD</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Create, list, update, and delete buckets with full metadata support, labels, and lifecycle configuration.</p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">Object operations</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Upload, download, copy, move, and delete objects. Supports streaming reads and writes with range headers.</p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">Multipart uploads</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Upload large files with multipart transfers. Speed limited only by your local disk I/O — no network latency.</p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">Object metadata</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Set and retrieve custom metadata, content-type, cache-control, and other standard GCS object attributes.</p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">Persistence</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Mount a Docker volume and all buckets, objects, and metadata survive container restarts. No data loss on docker stop.</p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">Signed URLs</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Generate signed URLs for temporary object access — useful for testing upload/download workflows that use pre-signed URLs.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="site-section">
    <div class="container container--narrow">
      <div class="reveal">
        <h2>Frequently asked questions</h2>
      </div>
      <div class="mt-6 grid gap-3 reveal">
        {faqItems.map(item => (
          <details class="site-panel p-5 cursor-pointer">
            <summary class="font-semibold text-[var(--text)] text-[1.05rem]">{item.q}</summary>
            <p class="mt-3 text-[var(--text-2)] leading-7">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- BOTTOM CTA -->
  <section class="site-section">
    <div class="container">
      <div class="site-panel p-8 reveal" style="background: linear-gradient(135deg, rgba(31, 39, 50, 0.96), rgba(34, 42, 53, 0.98));">
        <div class="grid gap-6 xl:grid-cols-[1fr,auto] items-center">
          <div>
            <h2 style="color: #e8eaed;">Start using Cloud Storage locally</h2>
            <p class="mt-3 text-lg leading-8" style="color: rgba(246, 239, 228, 0.74);">
              No egress fees. Instant uploads. Localhost speed. Test bucket operations, object metadata, and multipart uploads without cloud storage costs.
            </p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a href={`${base}docs/`} class="site-button site-button--secondary">Read the docs</a>
            <a href={`${base}gcp-emulator/`} class="site-button site-button--primary">GCP emulator overview</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</LandingLayout>
