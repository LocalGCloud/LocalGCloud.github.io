---
import LandingLayout from '../layouts/LandingLayout.astro';
import Callout from '../components/Callout.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import { docsContract } from '../data/docs-contract';
import { availableServiceCount, publishedServiceCount, services, serviceCategoryOrder, serviceCategoryMeta } from '../data/services';
import {
  createBreadcrumbSchema,
  createSoftwareApplicationSchema,
  productFacts,
} from '../data/productFacts';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';


const categoryGroups = serviceCategoryOrder
  .map(cat => ({
    id: cat,
    title: serviceCategoryMeta[cat].label,
    description: serviceCategoryMeta[cat].description,
    items: services.filter(s => s.category === cat),
  }))
  .filter(g => g.items.length > 0);

const faqItems = [
  {
    q: 'What is a GCP emulator?',
    a: 'A GCP emulator implements bounded local workflows for selected Google Cloud APIs. It is not production Google Cloud, so review each service limitation and validate against real Google Cloud before deployment.',
  },
  {
    q: 'Can I use Google Cloud SDKs?',
    a: 'Use the client libraries listed for each documented service workflow after exporting the actual local endpoints with localcloud env. Compatibility varies by service and client profile.',
  },
  {
    q: 'Which services are included?',
    a: `LocalCloud currently provides ${availableServiceCount} services, with Firestore clearly marked as coming soon. Google Sheets is supported as an integration rather than listed as a LocalCloud service.`,
  },
  {
    q: 'Is LocalCloud free?',
    a: 'Use is governed by the proprietary LocalCloud license. It permits limited non-commercial personal use by an Individual Developer acting personally; review the governing license before use.',
  },
  {
    q: 'Can I use LocalCloud in CI?',
    a: 'The runtime can be containerized, but organization and team-CI use is excluded by the current governing license. Do not infer legal permission from technical tier availability.',
  },
];

const pageUrl = new URL('gcp-emulator/', productFacts.siteUrl).toString();
const structuredData = [
  createSoftwareApplicationSchema(
    pageUrl,
    'LocalCloud runs major Google Cloud services locally in Docker for development, testing, CI, and demos.',
  ),
  createBreadcrumbSchema([
    { name: 'Home', url: productFacts.siteUrl },
    { name: 'GCP Emulator', url: pageUrl },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  },
];
---

<LandingLayout
  title="GCP Emulator — Run Google Cloud Services Locally in Docker"
  description={`Run ${availableServiceCount} Google Cloud services locally with LocalCloud. Install the host CLI, export actual loopback endpoints, and review per-service workflows.`}
  {structuredData}
>
  <!-- HERO -->
  <section class="site-section site-section--hero">
    <div class="container">
      <div class="max-w-[48rem] reveal">
        <span class="site-eyebrow">
          <span class="site-eyebrow__pulse"></span>
          Google Cloud Platform Emulator
        </span>
        <h1 class="mt-4">Run Google Cloud locally in one Docker container</h1>
        <p class="mt-6 text-lg leading-8 text-[var(--text-2)] sm:text-xl">
          LocalCloud provides {availableServiceCount} Google Cloud services, with upcoming additions clearly marked. Use the host CLI to start a loopback-bound instance and export its actual SDK endpoint settings.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`${base}docs/`} class="site-button site-button--primary">Start with the CLI</a>
          <a href={`${base}services/`} class="site-button site-button--secondary">View {publishedServiceCount} reviewed service guides</a>
          <a href={`${base}docs/localcloud-vs-google-emulators/`} class="site-button site-button--secondary">Compare with Google emulators</a>
          <a href={`${base}localstack-for-google-cloud/`} class="site-button site-button--secondary">LocalStack for Google Cloud?</a>
        </div>
      </div>

      <div class="mt-12 grid gap-4 sm:grid-cols-3 reveal">
        <article class="site-panel site-panel--soft p-5">
          <div class="text-3xl font-semibold tracking-[-0.08em] text-[var(--text)]">{availableServiceCount}</div>
          <div class="mt-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-[var(--accent-strong)]">Available services</div>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Databases, messaging, storage, analytics, security, and compute in one container.</p>
        </article>
        <article class="site-panel site-panel--soft p-5">
          <div class="text-3xl font-semibold tracking-[-0.08em] text-[var(--text)]">1</div>
          <div class="mt-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-[var(--accent-strong)]">Managed instance</div>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">One CLI lifecycle with persistent data and dynamically resolved loopback ports.</p>
        </article>
        <article class="site-panel site-panel--soft p-5">
          <div class="text-3xl font-semibold tracking-[-0.08em] text-[var(--text)]">License</div>
          <div class="mt-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-[var(--accent-strong)]">Review before use</div>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">The proprietary license governs use; technical tiers do not grant legal permission.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- THE PROBLEM -->
  <section class="site-section site-section--tight">
    <div class="container">
      <div class="reveal">
        <h2>GCP local development is fragmented</h2>
        <p class="mt-4 max-w-[44rem] text-lg leading-8 text-[var(--text-2)]">
          Individual emulator processes have separate startup, port, and environment contracts. LocalCloud provides one managed lifecycle for bounded workflows across its registry, while each service page records evidence and limitations.
        </p>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 reveal">
        <article class="site-panel site-panel--soft p-5">
          <div class="text-2xl font-semibold tracking-[-0.05em] text-[var(--text)]">Per-service</div>
          <div class="mt-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-[var(--accent-strong)]">Compatibility</div>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Every published workflow needs an evidence state and explicit local-emulation limits.</p>
        </article>
        <article class="site-panel site-panel--soft p-5">
          <div class="text-2xl font-semibold tracking-[-0.05em] text-[var(--text)]">One CLI</div>
          <div class="mt-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-[var(--accent-strong)]">Managed lifecycle</div>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">The CLI selects loopback ports, starts or reuses an instance, and exports its actual endpoint map.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- THE SOLUTION -->
  <section class="site-section">
    <div class="container">
      <div class="reveal">
        <span class="site-eyebrow">
          <span class="site-eyebrow__pulse"></span>
          The Solution
        </span>
        <h2 class="mt-4">One runtime, one console, one handoff</h2>
        <p class="mt-4 max-w-[44rem] text-lg leading-8 text-[var(--text-2)]">
          LocalCloud wraps official, custom, and third-party emulators behind a managed local runtime. The host CLI starts a loopback-bound instance, exports actual environment values, and opens the built-in console.
        </p>
        <p class="mt-4 text-base leading-7 text-[var(--text-2)]">
          Before relying on a local workflow, review the <a href={`${base}compatibility/`} class="font-medium text-[var(--accent-strong)]">documented compatibility and limitations</a> for the services your application uses.
        </p>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-3 reveal">
        <article class="site-panel p-6">
          <span class="site-kicker">01</span>
          <h3 class="mt-3 text-xl">Registry-backed service catalog</h3>
          <p class="mt-2 text-sm leading-7 text-[var(--text-2)]">
            Browse {publishedServiceCount} public service guides: {availableServiceCount} available services and Firestore marked as coming soon.
          </p>
        </article>
        <article class="site-panel p-6">
          <span class="site-kicker">02</span>
          <h3 class="mt-3 text-xl">SDK-shaped local workflows</h3>
          <p class="mt-2 text-sm leading-7 text-[var(--text-2)]">
            Export local endpoint values with <code>localcloud env</code>. Client and operation support varies by service; validate the production path against real Google Cloud.
          </p>
        </article>
        <article class="site-panel p-6">
          <span class="site-kicker">03</span>
          <h3 class="mt-3 text-xl">Built-in web console</h3>
          <p class="mt-2 text-sm leading-7 text-[var(--text-2)]">
            The console URL is returned by the CLI and may use a dynamically remapped loopback port. Use it to inspect service health and bounded local data workflows.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- SERVICE COMPARISON -->
  <section class="site-section">
    <div class="container">
      <div class="reveal">
        <h2>What you can run locally</h2>
        <p class="mt-4 max-w-[44rem] text-lg leading-8 text-[var(--text-2)]">
          Each available service lists its documented local workflows. Planned additions are labeled separately.
        </p>
      </div>

      <div class="mt-6 overflow-x-auto reveal">
        <table class="w-full border-collapse rounded-[1rem] border border-[var(--line)] overflow-hidden">
          <thead>
            <tr>
              <th class="text-left p-3 text-xs font-mono uppercase tracking-wider text-[var(--text-3)] bg-[var(--surface-2)]">Service</th>
              <th class="text-center p-3 text-xs font-mono uppercase tracking-wider text-[var(--text-3)] bg-[var(--surface-2)]">Availability</th>
              <th class="text-center p-3 text-xs font-mono uppercase tracking-wider text-[var(--text-3)] bg-[var(--surface-2)]">LocalCloud</th>
            </tr>
          </thead>
          <tbody>
            {services.map((service) => (
              <tr>
                <td class="p-3 font-medium">{service.name}</td>
                <td class="p-3 text-center">{service.catalogState === 'coming-soon' ? 'Coming soon' : 'Available'}</td>
                <td class="p-3 text-center">{service.catalogState === 'coming-soon' ? 'Roadmap addition' : `${service.supported.length} documented workflows`}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- SERVICE CATEGORIES -->
  <section class="site-section">
    <div class="container">
      <div class="grid gap-6 lg:grid-cols-2">
        {categoryGroups.map(group => (
          <div class="site-panel p-6 reveal">
            <span class="site-kicker">{group.title}</span>
            <h3 class="mt-2 text-xl">{group.title} services</h3>
            <p class="mt-2 text-sm text-[var(--text-2)]">{group.description}</p>
            <ul class="site-list mt-4">
              {group.items.map(svc => (
                <li>
                  <a href={`${base}services/${svc.slug}/`} class="text-[var(--text)] hover:text-[var(--accent-strong)]">
                    <strong>{svc.name}</strong>
                  </a>
                  <span class="ml-2 text-xs text-[var(--text-3)]">— {svc.description}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- USE CASES -->
  <section class="site-section">
    <div class="container">
      <div class="reveal">
        <h2>Built for how GCP teams actually work</h2>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-3 reveal">
        <article class="site-panel p-5">
          <span class="site-kicker">Local development</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">
            Run bounded workflows on loopback endpoints. Runtime telemetry and other outbound features exist; review privacy controls before relying on offline operation.
          </p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">CI/CD testing</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">
            Containerized test workflows remain technically possible, but the current governing license excludes organization and team-CI use. Review it before adopting this pattern.
          </p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">BigQuery pipeline testing</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">
            Exercise 10 documented DuckDB-backed BigQuery workflows locally, including datasets, tables, queries, scripting, and API profiles.
          </p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">Developer onboarding</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">
            The CLI can standardize local startup, but organization and onboarding use must comply with the governing proprietary license.
          </p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">Terraform validation</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">
            Use the documented endpoint-only or transparent-network workflow for qualified resources, then validate against real Google Cloud before production.
          </p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">Outbound-aware operation</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">
            Core local workflows may continue after the image is present, but telemetry, update checks, licensing, IAM, and configured scheduler targets can make outbound requests.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- QUICK START COMPARISON -->
  <section class="site-section">
    <div class="container">
      <div class="reveal">
        <h2>The setup difference</h2>
      </div>

      <div class="mt-6 grid gap-6 xl:grid-cols-2 reveal">
        <div class="site-panel p-6">
          <span class="site-kicker">Google's individual emulators</span>
          <pre class="mt-4 border-0 bg-[var(--surface-2)]"><code class="text-[0.8rem] leading-[1.7]"># Pub/Sub
gcloud components install pubsub-emulator
gcloud beta emulators pubsub start --host-port=localhost:24082

# Firestore
gcloud beta emulators firestore start --host-port=localhost:24083

# Spanner
gcloud components install spanner-emulator
gcloud emulators spanner start --host-port=localhost:24085

# These are separate emulator processes.
# This comparison does not claim an exhaustive vendor count.</code></pre>
        </div>

        <div class="site-panel p-6" style="background: linear-gradient(135deg, rgba(25, 31, 41, 0.98), rgba(18, 23, 32, 0.98));">
          <span style="color: rgba(255,255,255,0.7);" class="site-kicker">LocalCloud</span>
          <pre class="mt-4 border-0 bg-transparent"><code class="text-[0.8rem] leading-[1.7]" style="color: #e8eaed;">{docsContract.cli.installCommand}
localcloud doctor
localcloud start
eval "$(localcloud env)"
localcloud console

# Use the URLs and endpoint values returned by the CLI.</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="site-section">
    <div class="container container--narrow">
      <div class="reveal">
        <h2>Frequently asked questions</h2>
      </div>
      <div class="mt-6 grid gap-3 reveal">
        {faqItems.map(item => (
          <details class="site-panel p-5 cursor-pointer">
            <summary class="font-semibold text-[var(--text)] text-[1.05rem]">{item.q}</summary>
            <p class="mt-3 text-[var(--text-2)] leading-7">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- BOTTOM CTA -->
  <section class="site-section">
    <div class="container">
      <div class="site-panel p-8 reveal" style="background: linear-gradient(135deg, rgba(31, 39, 50, 0.96), rgba(34, 42, 53, 0.98));">
        <div class="grid gap-6 xl:grid-cols-[1fr,auto] items-center">
          <div>
            <h2 style="color: #e8eaed;">Start developing against GCP locally</h2>
            <p class="mt-3 text-lg leading-8" style="color: rgba(246, 239, 228, 0.74);">
              Use the CLI to start bounded local workflows, then review service evidence and the governing proprietary license.
            </p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a href={`${base}docs/`} class="site-button site-button--secondary">Read the docs</a>
            <a href={`${base}services/`} class="site-button site-button--primary">Explore services</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</LandingLayout>
