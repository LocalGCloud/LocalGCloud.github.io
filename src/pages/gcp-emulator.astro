---
import LandingLayout from '../layouts/LandingLayout.astro';
import Callout from '../components/Callout.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import { docsContract } from '../data/docs-contract';
import { cliQuickStart } from '../utils/quickstart.mjs';
import { auxiliaryServiceCount, availableServiceCount, primaryServiceCount, publishedServiceCount, services, serviceCatalogGroups } from '../data/services';
import {
  createBreadcrumbSchema,
  createWebPageSchema,
  productFacts,
} from '../data/productFacts';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
const unsupportedServiceCount = publishedServiceCount - availableServiceCount;
const isUnsupportedService = (service: (typeof services)[number]) =>
  service.marketingStatus === 'unsupported' || service.catalogState === 'coming-soon';
const unsupportedNames = services.filter(isUnsupportedService).map((service) => service.name);
const unsupportedServiceNames = unsupportedNames.length > 1 ? `${unsupportedNames.slice(0, -1).join(', ')} and ${unsupportedNames.at(-1)}` : unsupportedNames.join('');

const faqItems = [
  {
    q: 'What is a GCP emulator?',
    a: "A GCP emulator is a local program that answers calls to selected Google Cloud APIs, so your code can run against them on your machine. It isn't production Google Cloud: check each service's limits and validate against real Google Cloud before you deploy.",
  },
  {
    q: 'Can I use Google Cloud SDKs?',
    a: 'Use the client libraries listed for each documented service workflow after exporting the actual local endpoints with localcloud env. Compatibility varies by service and client profile.',
  },
  {
    q: 'Which services are included?',
    a: `LocalCloud runs ${availableServiceCount} services locally. Its catalog lists ${publishedServiceCount}: ${primaryServiceCount} Google Cloud services and ${auxiliaryServiceCount} auxiliary API (Google Sheets). ${unsupportedServiceNames} are unsupported. Firestore is opt-in. Google Sheets is a read-only values API for BigQuery external tables and fixture seeding.`,
  },
  {
    q: 'Is LocalCloud free?',
    a: 'Yes. Individuals and organizations, including for-profit companies, can use LocalCloud free of charge for non-production development, testing, CI, evaluation, and internal pilots under the proprietary Public Preview License.',
  },
  {
    q: 'Can I use LocalCloud in CI?',
    a: 'Yes. The Public Preview License permits non-production internal CI for individuals and organizations, including for-profit companies. Exact runner networking and service-container behavior must still be tested.',
  },
];

const pageUrl = new URL('gcp-emulator/', productFacts.siteUrl).toString();
const title = 'GCP Emulator — Run Google Cloud Services Locally in Docker';
const description = `Run ${availableServiceCount} services locally in one Docker container with LocalCloud. Install the CLI, export localhost SDK endpoints, and check each service's workflows.`;
const structuredData = [
  createWebPageSchema({ url: pageUrl, name: title, description }),
  createBreadcrumbSchema([
    { name: 'Home', url: productFacts.siteUrl },
    { name: 'GCP Emulator', url: pageUrl },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  },
];
---

<LandingLayout
  {title}
  {description}
  {structuredData}
>
  {/* HERO */}
  <section class="site-section site-section--hero">
    <div class="container">
      <div class="max-w-[48rem]">
        <span class="site-eyebrow">
          <span class="site-eyebrow__pulse"></span>
          GCP emulator
        </span>
        <h1 class="mt-4">Run Google Cloud locally in one Docker container</h1>
        <p class="mt-6 text-lg leading-8 text-[var(--text-2)] sm:text-xl">
          LocalCloud runs {availableServiceCount} services locally. The CLI starts a runtime that listens only on localhost and exports the SDK endpoint settings your code needs.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a href={`${base}docs/`} class="site-button site-button--primary">Start with the CLI</a>
          <a href={`${base}services/`} class="inline-flex min-h-11 items-center text-base font-semibold text-[var(--accent-strong)] hover:underline">Browse the service catalog →</a>
        </div>
      </div>

      <div class="mt-12 grid gap-4 sm:grid-cols-3 reveal">
        <article class="site-panel site-panel--soft p-5">
          <div class="text-3xl font-semibold tracking-[-0.08em] text-[var(--text)]">{availableServiceCount}</div>
          <div class="mt-2 font-mono text-xs uppercase tracking-[0.14em] text-[var(--accent-strong)]">Local services</div>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Databases, messaging, storage, analytics, security, and compute in one container.</p>
        </article>
        <article class="site-panel site-panel--soft p-5">
          <div class="text-3xl font-semibold tracking-[-0.08em] text-[var(--text)]">1</div>
          <div class="mt-2 font-mono text-xs uppercase tracking-[0.14em] text-[var(--accent-strong)]">Persistent runtime</div>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">One CLI lifecycle with persistent data on localhost-only ports.</p>
        </article>
        <article class="site-panel site-panel--soft p-5">
          <div class="text-3xl font-semibold tracking-[-0.08em] text-[var(--text)]">Free</div>
          <div class="mt-2 font-mono text-xs uppercase tracking-[0.14em] text-[var(--accent-strong)]">During public preview</div>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Non-production use for individuals and organizations, Pro-tier services included; see the <a href={`${base}license/`}>license</a> for terms.</p>
        </article>
      </div>
    </div>
  </section>

  {/* THE PROBLEM */}
  <section class="site-section site-section--tight">
    <div class="container">
      <div class="reveal">
        <h2>GCP local development is fragmented</h2>
        <p class="mt-4 max-w-[44rem] text-lg leading-8 text-[var(--text-2)]">
          Individual emulator processes have separate startup, port, and environment contracts. LocalCloud provides one managed lifecycle for every local service, and each service page lists its workflows and limits.
        </p>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 reveal">
        <article class="site-panel site-panel--soft p-5">
          <div class="text-2xl font-semibold tracking-[-0.05em] text-[var(--text)]">Per-service</div>
          <div class="mt-2 font-mono text-xs uppercase tracking-[0.14em] text-[var(--accent-strong)]">Compatibility</div>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Every published workflow includes a support level and explicit local-emulation limits.</p>
        </article>
        <article class="site-panel site-panel--soft p-5">
          <div class="text-2xl font-semibold tracking-[-0.05em] text-[var(--text)]">One CLI</div>
          <div class="mt-2 font-mono text-xs uppercase tracking-[0.14em] text-[var(--accent-strong)]">Managed lifecycle</div>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">The CLI selects durable storage and localhost ports, starts or reuses a compatible runtime, and exports its endpoint map.</p>
        </article>
      </div>
    </div>
  </section>

  {/* THE SOLUTION */}
  <section class="site-section">
    <div class="container">
      <div class="reveal">
        <span class="site-eyebrow">
          <span class="site-eyebrow__pulse"></span>
          The Solution
        </span>
        <h2 class="mt-4">One runtime, one console, one handoff</h2>
        <p class="mt-4 max-w-[44rem] text-lg leading-8 text-[var(--text-2)]">
          LocalCloud wraps official, custom, and third-party emulators behind a managed local runtime. The host CLI selects its Docker data volume, exports the environment values your code needs, and opens the built-in console.
        </p>
        <p class="mt-4 text-base leading-7 text-[var(--text-2)]">
          Before relying on a local workflow, review the <a href={`${base}compatibility/`} class="font-semibold text-[var(--accent-strong)]">documented compatibility and limitations</a> for the services your application uses.
        </p>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-3 reveal">
        <article class="site-panel p-6">
          <span class="site-kicker">01</span>
          <h3 class="mt-3 text-xl">Service catalog</h3>
          <p class="mt-2 text-sm leading-7 text-[var(--text-2)]">
            Browse {publishedServiceCount} service guides: {availableServiceCount} cover services that run locally, and {unsupportedServiceCount} explain why a service is unsupported. Each guide lists connection details, whether the service starts by default, workflows, and known limitations.
          </p>
        </article>
        <article class="site-panel p-6">
          <span class="site-kicker">02</span>
          <h3 class="mt-3 text-xl">Standard SDK workflows</h3>
          <p class="mt-2 text-sm leading-7 text-[var(--text-2)]">
            Export local endpoint values with <code>localcloud env</code>. Client and operation support varies by service; validate the production path against real Google Cloud.
          </p>
        </article>
        <article class="site-panel p-6">
          <span class="site-kicker">03</span>
          <h3 class="mt-3 text-xl">Built-in web console</h3>
          <p class="mt-2 text-sm leading-7 text-[var(--text-2)]">
            The CLI returns the console URL, including any port it picked because the default was in use. Use the console to inspect service health and local data.
          </p>
        </article>
      </div>
    </div>
  </section>

  {/* SERVICE CATEGORIES: one rendition, linked to each guide, in the shared catalog order */}
  <section class="site-section">
    <div class="container">
      <div class="reveal">
        <h2>What you can run locally</h2>
        <p class="mt-4 max-w-[44rem] text-lg leading-8 text-[var(--text-2)]">
          Each service links to its guide with setup steps and documented local workflows. Services LocalCloud does not run are marked Unsupported. See <a href={`${base}compatibility/`} class="font-semibold text-[var(--accent-strong)]">compatibility</a> for operation-level detail.
        </p>
      </div>

      <div class="mt-8 grid gap-6 lg:grid-cols-2">
        {serviceCatalogGroups.map(group => (
          <div class="site-panel min-w-0 p-6 reveal">
            <span class="site-kicker">{group.title}</span>
            <h3 class="mt-2 text-xl">{group.category === 'auxiliary' ? 'Auxiliary integration APIs' : `${group.title} services`}</h3>
            <p class="mt-2 text-sm text-[var(--text-2)]">{group.description}</p>
            <ul class="site-list mt-4">
              {group.items.map(svc => (
                <li>
                  <a href={`${base}services/${svc.slug}/`} class="text-[var(--text)] hover:text-[var(--accent-strong)]">
                    <strong>{svc.name}</strong>
                  </a>
                  {isUnsupportedService(svc) && <span class="site-chip site-chip--warn ml-2">Unsupported</span>}
                  <span class="ml-2 text-sm text-[var(--text-2)]">— {svc.description}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* USE CASES */}
  <section class="site-section">
    <div class="container">
      <div class="reveal">
        <h2>Built for how GCP teams actually work</h2>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-3 reveal">
        <article class="site-panel p-5">
          <span class="site-kicker">Local development</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">
            Run local workflows on localhost endpoints. Runtime telemetry and other outbound features exist; review privacy controls before relying on offline operation.
          </p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">Internal automation</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">
            The Public Preview License permits individuals and organizations, including for-profit companies, to use LocalCloud in ongoing internal automation and team CI.
          </p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">BigQuery pipeline testing</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">
            Exercise documented DuckDB-backed BigQuery workflows locally, including datasets, tables, queries, scripting, and API profiles.
          </p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">Repeatable team setup</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">
            The CLI can standardize local startup for individual and organization projects within the Public Preview License's non-production boundary.
          </p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">Terraform validation</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">
            Use the documented endpoint-only or transparent-network workflow for the documented resources, then validate against real Google Cloud before production.
          </p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">Offline use</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">
            After the image is downloaded, core local workflows can run offline. Telemetry, update checks, licensing, IAM, and configured scheduler targets can still make outbound requests.
          </p>
        </article>
      </div>
    </div>
  </section>

  {/* QUICK START COMPARISON */}
  <section class="site-section">
    <div class="container">
      <div class="reveal">
        <h2>The setup difference</h2>
      </div>

      <div class="mt-6 grid gap-6 xl:grid-cols-2 reveal">
        <div class="site-panel min-w-0 p-6">
          <span class="site-kicker">Google's individual emulators</span>
          <pre class="mt-4 border-0 bg-[var(--surface-2)]"><code># Pub/Sub
gcloud components install pubsub-emulator
gcloud beta emulators pubsub start --host-port=localhost:5383

# Firestore
gcloud beta emulators firestore start --host-port=localhost:5384

# Spanner
gcloud components install spanner-emulator
gcloud emulators spanner start --host-port=localhost:5386

# These are separate emulator processes.
# This comparison does not claim an exhaustive vendor count.</code></pre>
        </div>

        <div class="site-panel terminal-panel min-w-0 p-6">
          <span class="site-kicker">LocalCloud</span>
          <pre class="mt-4 border-0 bg-transparent"><code>{cliQuickStart(docsContract).script}

# Use the URLs and endpoint values returned by the CLI.</code></pre>
        </div>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-base text-[var(--text-2)] reveal">
        <span>Compare in depth:</span>
        <a href={`${base}docs/localcloud-vs-google-emulators/`} class="inline-flex min-h-11 items-center font-semibold text-[var(--accent-strong)] hover:underline">LocalCloud vs Google emulators</a>
        <a href={`${base}localstack-for-google-cloud/`} class="inline-flex min-h-11 items-center font-semibold text-[var(--accent-strong)] hover:underline">LocalStack for Google Cloud?</a>
      </div>
    </div>
  </section>

  {/* FAQ */}
  <section class="site-section">
    <div class="container container--narrow">
      <div class="reveal">
        <h2>Frequently asked questions</h2>
      </div>
      <div class="mt-6 grid gap-3 reveal">
        {faqItems.map(item => (
          <details class="site-panel p-5 cursor-pointer">
            <summary class="font-semibold text-[var(--text)] text-lg">{item.q}</summary>
            <p class="mt-3 text-[var(--text-2)] leading-7">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* BOTTOM CTA */}
  <section class="site-section">
    <div class="container">
      <div class="site-panel grid items-center gap-6 p-8 xl:grid-cols-[1fr_auto] reveal">
        <div>
          <h2>Start developing against GCP locally</h2>
          <p class="mt-3 max-w-[42rem] text-lg leading-8 text-[var(--text-2)]">
            Use the CLI to start local workflows, then check each service's limits and the proprietary license.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={`${base}services/`} class="site-button site-button--primary">Explore services</a>
          <a href={`${base}docs/`} class="site-button site-button--secondary">Read the docs</a>
        </div>
      </div>
    </div>
  </section>
</LandingLayout>

<style>
  .terminal-panel {
    --terminal-bg: #191f29;
    --terminal-ink: #e8eaed;
    --terminal-muted: rgba(232, 234, 237, 0.72);
    background: var(--terminal-bg);
    border-color: var(--terminal-bg);
  }

  .terminal-panel .site-kicker {
    color: var(--terminal-muted);
  }

  .terminal-panel pre {
    border-color: transparent;
    background: transparent;
  }

  .terminal-panel pre code {
    color: var(--terminal-ink);
  }
</style>
