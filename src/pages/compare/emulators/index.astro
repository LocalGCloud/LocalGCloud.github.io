---
import LandingLayout from '../../../layouts/LandingLayout.astro';
import EmulatorComparisonDetails from '../../../components/EmulatorComparisonDetails.astro';
import { emulatorComparisons } from '../../../data/emulatorComparisons';
import { createBreadcrumbSchema, createWebPageSchema, productFacts } from '../../../data/productFacts';
const base = import.meta.env.BASE_URL;
const title = 'Emulator Feature Comparisons — LocalCloud';
const description = 'Compare LocalCloud services with Google and community emulators. Explore feature tables and filter capabilities that add value to your local tests.';
const url = new URL('compare/emulators/', productFacts.siteUrl).toString();
const structuredData = [createWebPageSchema({ url, name: title, description }), createBreadcrumbSchema([
  { name: 'Home', url: productFacts.siteUrl }, { name: 'Comparisons', url: new URL('compare/', productFacts.siteUrl).toString() }, { name: 'Emulator features', url },
])];
---
<LandingLayout {title} {description} {structuredData}>
  <section class="site-section site-section--hero comparison-intro"><div class="container">
    <a href={`${base}compare/`}>All comparisons</a>
    <h1 class="mt-4 max-w-[48rem]">What LocalCloud really offers</h1>
    <p class="mt-4 max-w-[48rem] text-lg leading-8 text-[var(--text-2)]">Go beyond basic CRUD operations. Choose a service to compare its features.</p>
  </div></section>
  <section class="site-section site-section--tight"><div class="container comparison-workspace" data-comparison-workspace>
    <nav class="comparison-services" aria-label="Compare services">
      <span class="site-micro">Services</span>
      <div class="comparison-service-tabs" data-comparison-tabs role="tablist" aria-label="Services" hidden>
        {emulatorComparisons.map(comparison => <button type="button" role="tab" aria-controls={`comparison-pane-${comparison.id}`} id={`comparison-tab-${comparison.id}`} data-service-tab={comparison.slug}>
          <span>{comparison.name}</span><small>{comparison.hasCompetitor ? `${comparison.exclusive} LocalCloud advantages` : `${comparison.total} features`}</small>
        </button>)}
      </div>
      <noscript><ul>{emulatorComparisons.map(comparison => <li><a href={`${base}${comparison.path.slice(1)}`}>{comparison.name}</a></li>)}</ul></noscript>
    </nav>
    <div class="comparison-content">
      {emulatorComparisons.map((comparison, index) => <div id={`comparison-pane-${comparison.id}`} role="tabpanel" tabindex="0" data-comparison-service={comparison.slug} aria-labelledby={`comparison-tab-${comparison.id}`} hidden={index !== 0}>
        <EmulatorComparisonDetails {comparison} embedded preview={index === 0} />
      </div>)}
    </div>
  </div></section>
</LandingLayout>
