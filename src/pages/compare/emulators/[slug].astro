---
import LandingLayout from '../../../layouts/LandingLayout.astro';
import EmulatorComparisonTable from '../../../components/EmulatorComparisonTable.astro';
import { emulatorComparisons } from '../../../data/emulatorComparisons';
import { createBreadcrumbSchema, createWebPageSchema, productFacts } from '../../../data/productFacts';
export function getStaticPaths() {
  return emulatorComparisons.map(comparison => ({ params: { slug: comparison.slug }, props: { comparison } }));
}
interface Props { comparison: (typeof emulatorComparisons)[number]; }
const { comparison } = Astro.props;
const base = import.meta.env.BASE_URL;
const title = `${comparison.name} Emulator Comparison — LocalCloud`;
const description = `Compare ${comparison.engine} with ${comparison.competitor}. Explore feature support and filter capabilities available only in LocalCloud.`;
const url = new URL(comparison.path.slice(1), productFacts.siteUrl).toString();
const structuredData = [createWebPageSchema({ url, name: title, description }), createBreadcrumbSchema([
  { name: 'Home', url: productFacts.siteUrl }, { name: 'Emulator comparisons', url: new URL('compare/emulators/', productFacts.siteUrl).toString() }, { name: comparison.name, url },
])];
---
<LandingLayout {title} {description} {structuredData}>
  <section class="site-section site-section--hero"><div class="container">
    <nav aria-label="Breadcrumb"><a href={`${base}compare/emulators/`}>Emulator comparisons</a> <span aria-hidden="true">/</span> {comparison.name}</nav>
    <span class="site-kicker mt-5 block">{comparison.engine}</span>
    <h1 class="mt-4 max-w-[48rem]">{comparison.name}: what LocalCloud adds</h1>
    <p class="mt-6 max-w-[48rem] text-lg leading-8 text-[var(--text-2)]">{comparison.summary}</p>
    <div class="mt-6 flex flex-wrap gap-3"><a class="site-button site-button--primary" href="#feature-table-title">Explore features</a><a class="site-button site-button--secondary" href={`${base}services/${comparison.slug}/`}>{comparison.name} service guide</a></div>
  </div></section>
  <section class="site-section site-section--tight"><div class="container">
    <p class="font-medium">{comparison.total.toLocaleString('en-US')} compared rows · {comparison.exclusive} LocalCloud advantages · {comparison.broader} broader behaviors</p>
    <p class="mt-3 text-sm leading-6 text-[var(--text-2)]">Compared with <a href={comparison.baselineUrl}>{comparison.baseline}</a>. {comparison.scope}</p>
  </div></section>
  <EmulatorComparisonTable {comparison} />
  <section class="site-section site-section--tight"><div class="container"><a href={`${base}compare/emulators/`}>Compare another service <span aria-hidden="true">→</span></a></div></section>
</LandingLayout>
