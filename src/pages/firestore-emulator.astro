---
import LandingLayout from '../layouts/LandingLayout.astro';
import ServiceIcon from '../components/ServiceIcon.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

const pythonCode = `import os
from google.cloud import firestore

os.environ["FIRESTORE_EMULATOR_HOST"] = "localhost:24083"

db = firestore.Client(project="local-project")

doc_ref = db.collection("users").document("alice")
doc_ref.set({"name": "Alice", "email": "alice@example.com"})

# Real-time listener
def on_snapshot(snapshot, changes, read_time):
    for doc in snapshot:
        print(f"Received: {doc.to_dict()}")

db.collection("users").on_snapshot(on_snapshot)`;

const nodeCode = `process.env.FIRESTORE_EMULATOR_HOST = 'localhost:24083';

const { Firestore } = require('@google-cloud/firestore');
const db = new Firestore({ projectId: 'local-project' });

await db.collection('users').doc('alice').set({
  name: 'Alice',
  email: 'alice@example.com'
});

// Real-time listener
db.collection('users').onSnapshot(snapshot => {
  snapshot.forEach(doc => {
    console.log(doc.id, '=>', doc.data());
  });
});`;

const faqItems = [
  {
    q: 'Can I run Firestore alongside Pub/Sub and BigQuery locally?',
    a: 'Yes. LocalCloud runs Firestore, Pub/Sub, BigQuery, Spanner, Bigtable, Cloud Storage, and 15+ more GCP services in a single Docker container. Test end-to-end flows where a Firestore document write triggers a Cloud Function that publishes to Pub/Sub — all locally.',
  },
  {
    q: 'Does LocalCloud support Firestore real-time listeners?',
    a: 'Yes. The bundled Google Firestore emulator supports document CRUD, collection queries, batch writes, and real-time snapshot listeners for building reactive applications locally.',
  },
  {
    q: 'Can I seed Firestore with test data?',
    a: 'Yes. LocalCloud supports YAML-based seed data for Firestore collections. Define documents in a seed YAML file and LocalCloud populates your emulator on startup for reproducible test environments.',
  },
];
---

<LandingLayout
  title="Firestore Emulator — Local Google Cloud Firestore in Docker"
  description="Run Google Cloud Firestore locally with LocalCloud's bundled emulator. Test document CRUD, real-time listeners, and collection queries with zero cloud costs — bundled with 20+ GCP services in one Docker container."
>
  <script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Can I run Firestore alongside Pub/Sub and BigQuery locally?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. LocalCloud runs Firestore, Pub/Sub, BigQuery, Spanner, Bigtable, Cloud Storage, and 15+ more GCP services in a single Docker container."
      }
    },
    {
      "@type": "Question",
      "name": "Does LocalCloud support Firestore real-time listeners?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. The bundled Google Firestore emulator supports document CRUD, collection queries, batch writes, and real-time snapshot listeners for building reactive applications locally."
      }
    }
  ]
}
  </script>

  <!-- HERO -->
  <section class="site-section site-section--hero">
    <div class="container">
      <div class="max-w-[48rem] reveal">
        <span class="site-eyebrow"><span class="site-eyebrow__pulse"></span>Firestore Emulator</span>
        <h1 class="mt-4">Run Google Cloud Firestore locally</h1>
        <p class="mt-6 text-lg leading-8 text-[var(--text-2)] sm:text-xl">
          Develop and test Firestore applications locally with real-time listeners, collection queries, and batch writes. 
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`${base}docs/`} class="site-button site-button--primary">Start in 60 seconds</a>
          <a href={`${base}services/firestore/`} class="site-button site-button--secondary">Firestore service details</a>
          <a href={`${base}gcp-emulator/`} class="site-button site-button--secondary">GCP emulator overview</a>
        </div>
      </div>
      <div class="mt-12 grid gap-4 sm:grid-cols-3 reveal">
        <article class="site-panel site-panel--soft p-5">
          <div class="text-3xl font-semibold tracking-[-0.08em] text-[var(--text)]">$0</div>
          <div class="mt-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-[var(--accent-strong)]">Read/write costs</div>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Test document operations and queries without Firestore read/write charges.</p>
        </article>
        <article class="site-panel site-panel--soft p-5">
          <div class="text-3xl font-semibold tracking-[-0.08em] text-[var(--text)]">✅</div>
          <div class="mt-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-[var(--accent-strong)]">Official emulator</div>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Bundles Google's official Firestore emulator alongside 20+ other GCP services in one container.</p>
        </article>
        <article class="site-panel site-panel--soft p-5">
          <div class="text-3xl font-semibold tracking-[-0.08em] text-[var(--text)]">Real-time</div>
          <div class="mt-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-[var(--accent-strong)]">Snapshot listeners</div>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Build reactive applications with real-time document and query snapshot listeners — fully supported locally.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- CODE EXAMPLE -->
  <section class="site-section">
    <div class="container">
      <div class="reveal">
        <h2>Same SDKs, same code</h2>
        <p class="mt-4 max-w-[44rem] text-lg leading-8 text-[var(--text-2)]">
          Your existing Firestore SDK code runs unchanged against the local emulator. Just set one environment variable.
        </p>
      </div>
      <div class="mt-6 grid gap-6 lg:grid-cols-2 reveal">
        <div class="site-panel overflow-hidden">
          <div class="px-4 pt-3 pb-2"><span class="site-kicker">Python</span></div>
          <pre class="border-0 rounded-none bg-transparent"><code class="block px-4 pb-4 text-[0.78rem] leading-[1.7]">{pythonCode}</code></pre>
        </div>
        <div class="site-panel overflow-hidden">
          <div class="px-4 pt-3 pb-2"><span class="site-kicker">Node.js</span></div>
          <pre class="border-0 rounded-none bg-transparent"><code class="block px-4 pb-4 text-[0.78rem] leading-[1.7]">{nodeCode}</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="site-section">
    <div class="container">
      <div class="reveal">
        <h2>Features</h2>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-3 reveal">
        <article class="site-panel p-5">
          <span class="site-kicker">Document CRUD</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Create, read, update, and delete documents in collections and subcollections using the standard Firestore SDK.</p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">Collection queries</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Run queries with where filters, ordering, limits, cursors, and composite indexes against local collections.</p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">Batch writes</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Perform atomic batch writes and transactions across multiple documents locally.</p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">Real-time listeners</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Build reactive UIs with document and query snapshot listeners that fire on local data changes.</p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">Security rules testing</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Test Firestore security rules locally before deploying to production — catch permission issues early.</p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">Seed data</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Define Firestore collections and documents in YAML seed files for reproducible test environments on every container start.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="site-section">
    <div class="container container--narrow">
      <div class="reveal">
        <h2>Frequently asked questions</h2>
      </div>
      <div class="mt-6 grid gap-3 reveal">
        {faqItems.map(item => (
          <details class="site-panel p-5 cursor-pointer">
            <summary class="font-semibold text-[var(--text)] text-[1.05rem]">{item.q}</summary>
            <p class="mt-3 text-[var(--text-2)] leading-7">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- BOTTOM CTA -->
  <section class="site-section">
    <div class="container">
      <div class="site-panel p-8 reveal" style="background: linear-gradient(135deg, rgba(31, 39, 50, 0.96), rgba(34, 42, 53, 0.98));">
        <div class="grid gap-6 xl:grid-cols-[1fr,auto] items-center">
          <div>
            <h2 style="color: #e8eaed;">Start building with Firestore locally</h2>
            <p class="mt-3 text-lg leading-8" style="color: rgba(246, 239, 228, 0.74);">
              Document CRUD. Real-time listeners. Batch writes. Test Firestore collections and queries without read/write charges.
            </p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a href={`${base}docs/`} class="site-button site-button--secondary">Read the docs</a>
            <a href={`${base}gcp-emulator/`} class="site-button site-button--primary">GCP emulator overview</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</LandingLayout>
