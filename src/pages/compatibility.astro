---
import LandingLayout from '../layouts/LandingLayout.astro';
import { docsContract } from '../data/docs-contract';
import { createBreadcrumbSchema, createSoftwareApplicationSchema, productFacts } from '../data/productFacts';
import { serviceCompatibilityEditorial } from '../data/serviceEditorial';
import { publishedServiceCount, services } from '../data/services';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const pageUrl = new URL('compatibility/', productFacts.siteUrl).toString();
const structuredData = [
  createSoftwareApplicationSchema(pageUrl, `Local capabilities and boundaries for ${publishedServiceCount} LocalCloud service guides.`),
  createBreadcrumbSchema([{ name: 'Home', url: productFacts.siteUrl }, { name: 'Compatibility', url: pageUrl }]),
];
---

<LandingLayout title={`LocalCloud Compatibility — ${publishedServiceCount} Services`} description={`Compare local capabilities, API ports, and development boundaries for ${publishedServiceCount} LocalCloud services, including Spanner, BigQuery, and Bigtable.`} {structuredData}>
  <section class="site-section site-section--hero">
    <div class="container"><div class="max-w-[54rem] reveal">
      <span class="site-eyebrow"><span class="site-eyebrow__pulse"></span>Supported services</span>
      <h1 class="mt-4">LocalCloud supported services and boundaries</h1>
      <p class="mt-6 text-lg leading-8 text-[var(--text-2)] sm:text-xl">Build and test Google Cloud applications locally with standard SDKs, real queries, and local execution workflows. Services tagged Planned... are not available locally yet. Select a service for its detailed API guide.</p>
      <div class="mt-8 flex flex-wrap gap-3"><a href={`${base}services/`} class="site-button site-button--primary">Browse all {publishedServiceCount} guides</a><a href={`${base}docs/configuration/`} class="site-button site-button--secondary">Configure services</a></div>
      <p class="mt-5 text-sm text-[var(--text-2)]">Reviewed against upstream documentation on <time datetime={docsContract.reviewedAt}>{docsContract.reviewedAt}</time>.</p>
    </div></div>
  </section>

  <section class="site-section site-section--tight"><div class="container"><aside class="callout callout--warning" role="note"><div class="callout__body"><p class="callout__title">Local development and cloud production boundaries</p><div class="callout__content"><p>{productFacts.productionBoundary} Multi-region infrastructure, physical HSMs, and production SLAs require real Google Cloud. The table highlights local workflows and service-specific boundaries.</p></div></div></aside></div></section>

  <section class="site-section"><div class="container">
    <p class="mb-4 text-sm leading-6 text-[var(--text-2)]">Ports are container defaults. Run <code>localcloud env</code> for the endpoints published by your running instance. Enable resource-intensive services such as Firestore when needed.</p>
    <div class="overflow-x-auto reveal" tabindex="0" role="region" aria-label="LocalCloud service compatibility table">
      <table class="w-full min-w-[60rem] table-fixed text-left text-sm">
        <caption class="sr-only">LocalCloud service capabilities, default API ports, and development boundaries</caption>
        <colgroup><col class="w-[22%]" /><col class="w-[43%]" /><col class="w-[35%]" /></colgroup>
        <thead><tr class="border-b border-[var(--line)]">
          <th scope="col" class="py-3 pr-6">Service</th><th scope="col" class="py-3 pr-6">Local capabilities</th><th scope="col" class="py-3">Boundaries</th>
        </tr></thead>
        <tbody>
          {services.map((service) => {
            const compatibility = serviceCompatibilityEditorial[service.id];
            const unsupported = service.catalogState === 'coming-soon' || service.marketingStatus === 'unsupported';
            return (
              <tr class="border-b border-[var(--line)] align-top">
                <th scope="row" class="py-5 pr-6 font-normal">
                  <div class="flex flex-wrap items-center gap-2">
                    <a class="font-semibold text-[var(--accent-strong)]" href={`${base}services/${service.slug}/`}>{service.name}</a>
                    {unsupported && <span class="site-chip site-chip--warn">Planned...</span>}
                  </div>
                  <div class="mt-2 font-mono text-xs leading-5 text-[var(--text-2)]">{service.catalogState === 'coming-soon' ? 'No local endpoint' : service.endpointLabel}</div>
                  {unsupported && service.catalogState !== 'coming-soon' && <p class="mt-1 text-xs text-[var(--text-2)]">Stub routes only</p>}
                </th>
                {unsupported ? (
                  <td colspan="2" class="py-5 leading-6 text-[var(--text-2)]">
                    <ul class="list-disc space-y-1 pl-4">{compatibility.boundaries.map((item) => <li>{item}</li>)}</ul>
                  </td>
                ) : (
                  <>
                    <td class="py-5 pr-6 leading-6"><ul class="list-disc space-y-1 pl-4 text-[var(--text-2)]">{compatibility.capabilities.map((capability) => <li>{capability.summary}</li>)}</ul></td>
                    <td class="py-5 leading-6"><ul class="list-disc space-y-1 pl-4 text-[var(--text-2)]">{compatibility.boundaries.map((item) => <li>{item}</li>)}</ul></td>
                  </>
                )}
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </div></section>

  <section class="site-section"><div class="container grid gap-4 md:grid-cols-2">
    <article class="site-panel p-6"><span class="site-kicker">Run the workflows you need</span><p class="mt-3 leading-7 text-[var(--text-2)]">Enable services with <code>localcloud start --services &lt;name&gt;</code> or <code>services.enabled</code> in <code>localcloud.yaml</code>. Dataproc and Cloud Run use Docker execution; GKE uses k3d and Docker.</p></article>
    <article class="site-panel p-6"><span class="site-kicker">Validate your application</span><p class="mt-3 leading-7 text-[var(--text-2)]">Use each service guide for detailed operations and setup. Test the queries, authorization rules, and delivery behavior your application relies on, and validate cloud infrastructure guarantees in Google Cloud.</p></article>
  </div></section>
</LandingLayout>
