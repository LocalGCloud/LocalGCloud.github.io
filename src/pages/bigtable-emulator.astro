---
import LandingLayout from '../layouts/LandingLayout.astro';
import ServiceIcon from '../components/ServiceIcon.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

const pythonCode = `import os
from google.cloud import bigtable

os.environ["BIGTABLE_EMULATOR_HOST"] = "localhost:8087"

client = bigtable.Client(
    project="local-project", admin=True)
instance = client.instance("my-instance")

table = instance.table("my-table")
table.create(column_families={
    "cf1": bigtable.column_family.MaxVersionsGCRule(1)
})

# Write a row
row = table.direct_row("row-key-1")
row.set_cell("cf1", "col1", "Hello, LocalCloud!")
row.commit()`;

const goCode = `import (
    "cloud.google.com/go/bigtable"
    "context"
)

ctx := context.Background()
// BIGTABLE_EMULATOR_HOST=localhost:8087 auto-detected
client, _ := bigtable.NewClient(ctx,
    "local-project", "my-instance")

tbl := client.Open("my-table")
mut := bigtable.NewMutation()
mut.Set("cf1", "col1", bigtable.Now(),
    []byte("Hello, LocalCloud!"))

tbl.Apply(ctx, "row-key-1", mut)`;

const faqItems = [
  {
    q: 'Does Google provide an official Bigtable emulator?',
    a: 'Google provides a Bigtable emulator, but it is in-memory only — all data is lost when the emulator stops. LocalCloud extends it with PostgreSQL-backed persistence, a console data browser, change streams, and materialized views, all running alongside 19+ other GCP services in one Docker container.',
  },
  {
    q: 'What Bigtable features does LocalCloud support beyond the default emulator?',
    a: 'LocalCloud\'s Bigtable emulator adds data persistence (survives container restarts via PostgreSQL), change streams for CDC workflows, materialized views, instance/cluster/app profile admin APIs, CheckAndMutate operations, and a web-console data browser. Tables, column families, ReadRows, and MutateRow are fully supported.',
  },
  {
    q: 'Can I persist Bigtable data between restarts?',
    a: 'Yes. Mount a Docker volume to /var/lib/localcloud and all Bigtable tables, column families, and row data persist across container restarts using a PostgreSQL backend. The default Google Bigtable emulator loses all data on stop.',
  },
  {
    q: 'Does LocalCloud support Bigtable change streams?',
    a: 'Yes. LocalCloud\'s Bigtable emulator includes change streams for CDC (change data capture) workflows — enabling event-driven architectures where downstream systems react to Bigtable mutations in near real-time.',
  },
];
---

<LandingLayout
  title="Bigtable Emulator — Local Google Cloud Bigtable in Docker"
  description="Run Google Cloud Bigtable locally with persistence, change streams, and materialized views. Test wide-column NoSQL workloads with zero cloud costs — all in one Docker container alongside 20+ GCP services."
>
  <script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Does Google provide an official Bigtable emulator?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Google provides a Bigtable emulator, but it is in-memory only. LocalCloud extends it with PostgreSQL-backed persistence, change streams, materialized views, and a web console data browser."
      }
    },
    {
      "@type": "Question",
      "name": "What Bigtable features does LocalCloud support beyond the default emulator?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Data persistence via PostgreSQL, change streams for CDC, materialized views, instance/cluster/app profile admin APIs, CheckAndMutate operations, and a web-console data browser."
      }
    },
    {
      "@type": "Question",
      "name": "Can I persist Bigtable data between restarts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Mount a Docker volume to /var/lib/localcloud and all Bigtable tables, column families, and row data persist across container restarts using a PostgreSQL backend."
      }
    }
  ]
}
  </script>

  <!-- HERO -->
  <section class="site-section site-section--hero">
    <div class="container">
      <div class="max-w-[48rem] reveal">
        <span class="site-eyebrow"><span class="site-eyebrow__pulse"></span>Bigtable Emulator</span>
        <h1 class="mt-4">Run Google Cloud Bigtable locally</h1>
        <p class="mt-6 text-lg leading-8 text-[var(--text-2)] sm:text-xl">
          Test wide-column NoSQL workloads locally with persistence, change streams, and materialized views. Bundled with 20+ GCP services in one Docker container.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`${base}docs/`} class="site-button site-button--primary">Start in 60 seconds</a>
          <a href={`${base}services/bigtable/`} class="site-button site-button--secondary">Bigtable service details</a>
          <a href={`${base}gcp-emulator/`} class="site-button site-button--secondary">GCP emulator overview</a>
        </div>
      </div>
      <div class="mt-12 grid gap-4 sm:grid-cols-3 reveal">
        <article class="site-panel site-panel--soft p-5">
          <div class="text-3xl font-semibold tracking-[-0.08em] text-[var(--text)]">8087</div>
          <div class="mt-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-[var(--accent-strong)]">Default port</div>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Standard gRPC endpoint — your Bigtable SDK connects automatically with BIGTABLE_EMULATOR_HOST.</p>
        </article>
        <article class="site-panel site-panel--soft p-5">
          <div class="text-3xl font-semibold tracking-[-0.08em] text-[var(--text)]">💾</div>
          <div class="mt-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-[var(--accent-strong)]">Persists data</div>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">PostgreSQL-backed persistence — all tables and data survive container restarts with mounted volumes.</p>
        </article>
        <article class="site-panel site-panel--soft p-5">
          <div class="text-3xl font-semibold tracking-[-0.08em] text-[var(--text)]">🔄</div>
          <div class="mt-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-[var(--accent-strong)]">Change streams</div>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">CDC workflows supported — react to Bigtable mutations with change streams for event-driven architectures.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- CODE EXAMPLE -->
  <section class="site-section">
    <div class="container">
      <div class="reveal">
        <h2>Same SDKs, same code</h2>
        <p class="mt-4 max-w-[44rem] text-lg leading-8 text-[var(--text-2)]">
          Your existing Bigtable SDK code runs unchanged against the local emulator. Just set one environment variable.
        </p>
      </div>
      <div class="mt-6 grid gap-6 lg:grid-cols-2 reveal">
        <div class="site-panel overflow-hidden">
          <div class="px-4 pt-3 pb-2"><span class="site-kicker">Python</span></div>
          <pre class="border-0 rounded-none bg-transparent"><code class="block px-4 pb-4 text-[0.78rem] leading-[1.7]">{pythonCode}</code></pre>
        </div>
        <div class="site-panel overflow-hidden">
          <div class="px-4 pt-3 pb-2"><span class="site-kicker">Go</span></div>
          <pre class="border-0 rounded-none bg-transparent"><code class="block px-4 pb-4 text-[0.78rem] leading-[1.7]">{goCode}</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="site-section">
    <div class="container">
      <div class="reveal">
        <h2>What's included</h2>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-3 reveal">
        <article class="site-panel p-5">
          <span class="site-kicker">Tables & column families</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Create and manage tables with column families, garbage collection rules, and schema evolution.</p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">ReadRows & MutateRow</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Full ReadRows with filters, row ranges, and limit. Single-row mutations with CheckAndMutate support.</p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">Change streams</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">CDC workflows enabled — capture row-level changes and stream them to downstream systems in near real-time.</p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">Materialized views</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Pre-computed views of Bigtable data for faster reads on common access patterns — supported locally.</p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">Persistence</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">PostgreSQL-backed persistence — all data survives container restarts when using mounted volumes.</p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">Admin APIs</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Instance, cluster, and app profile CRUD APIs for managing Bigtable resources programmatically.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="site-section">
    <div class="container container--narrow">
      <div class="reveal">
        <h2>Frequently asked questions</h2>
      </div>
      <div class="mt-6 grid gap-3 reveal">
        {faqItems.map(item => (
          <details class="site-panel p-5 cursor-pointer">
            <summary class="font-semibold text-[var(--text)] text-[1.05rem]">{item.q}</summary>
            <p class="mt-3 text-[var(--text-2)] leading-7">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- BOTTOM CTA -->
  <section class="site-section">
    <div class="container">
      <div class="site-panel p-8 reveal" style="background: linear-gradient(135deg, rgba(31, 39, 50, 0.96), rgba(34, 42, 53, 0.98));">
        <div class="grid gap-6 xl:grid-cols-[1fr,auto] items-center">
          <div>
            <h2 style="color: #e8eaed;">Start testing Bigtable locally</h2>
            <p class="mt-3 text-lg leading-8" style="color: rgba(246, 239, 228, 0.74);">
              Persistence, change streams, and materialized views — bundled with 20+ GCP services in one container. Free for individual developers.
            </p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a href={`${base}docs/`} class="site-button site-button--secondary">Read the docs</a>
            <a href={`${base}gcp-emulator/`} class="site-button site-button--primary">GCP emulator overview</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</LandingLayout>
