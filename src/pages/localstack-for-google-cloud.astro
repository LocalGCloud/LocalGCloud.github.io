---
import LandingLayout from '../layouts/LandingLayout.astro';
import Callout from '../components/Callout.astro';
import {
  createBreadcrumbSchema,
  createWebPageSchema,
  productFacts,
} from '../data/productFacts';
import { alternativesReviewedAt, alternativesReviewedLabel } from '../data/alternatives';
import { availableServiceCount } from '../data/services';
import { relatedAnchor } from '../data/relatedPages';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const pageUrl = new URL('localstack-for-google-cloud/', productFacts.siteUrl).toString();

const faqs = [
  {
    question: 'Is there a LocalStack-style option for Google Cloud?',
    answer:
      'Yes. LocalCloud is a local Google Cloud runtime for non-production development, testing, CI, evaluation, and internal pilots permitted by its proprietary Public Preview License. It runs major GCP services in Docker so applications can use local endpoints instead of real cloud services.',
  },
  {
    question: 'Does LocalStack support Google Cloud?',
    answer: `Not as of ${alternativesReviewedLabel}. LocalStack's plans cover AWS and a separate Snowflake product. Since March 23, 2026, current LocalStack releases need a LocalStack account and auth token, and its free Hobby plan is for non-commercial use.`,
  },
  {
    question: 'Is LocalCloud affiliated with LocalStack?',
    answer:
      'No. LocalCloud is an independent product focused on Google Cloud workflows. LocalStack is an AWS-focused local cloud development platform.',
  },
  {
    question: 'Does LocalCloud replace Google Cloud in production?',
    answer:
      'No. LocalCloud is for permitted non-production workflows. Validate behavior against real Google Cloud before production deployment.',
  },
  {
    question: 'Can I use my existing Google Cloud SDK code?',
    answer:
      'LocalCloud is designed for standard Google Cloud SDK and API workflows. Configure local emulator endpoints for development, then remove those local settings when validating against real Google Cloud.',
  },
  {
    question: 'When should I use LocalStack instead of LocalCloud?',
    answer:
      'Use LocalStack whenever the code under test calls AWS APIs. LocalCloud does not emulate AWS and is not a substitute for it. LocalStack is also the more established project, with a longer public track record and a wider published integration surface.',
  },
  {
    question: 'Can I use LocalCloud as a local cloud sandbox for AI agents?',
    answer:
      'Yes. LocalCloud gives agent-written Google Cloud code a localhost target with no credentials or billing project by default, so an AI coding agent cannot create real cloud resources by mistake. It closes the dependency boundary; pair it with a code sandbox if you also need to contain arbitrary code execution.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};

const title = 'LocalStack for Google Cloud? Meet LocalCloud';
const description = 'Looking for a LocalStack-style local runtime for Google Cloud? LocalCloud runs Google Cloud services in Docker. Compare services, SDK setup, and license terms.';
const structuredData = [
  createWebPageSchema({ url: pageUrl, name: title, description }),
  createBreadcrumbSchema([
    { name: 'Home', url: productFacts.siteUrl },
    { name: 'LocalStack for Google Cloud', url: pageUrl },
  ]),
  faqSchema,
];
---

<LandingLayout
  {title}
  {description}
  {structuredData}
>
  <section class="site-section site-section--hero">
    <div class="container">
      <div class="max-w-[52rem]">
        <span class="site-eyebrow">
          <span class="site-eyebrow__pulse"></span>
          Local Google Cloud development
        </span>
        <h1 class="mt-4">Looking for LocalStack for Google Cloud?</h1>
        <p class="mt-6 text-lg leading-8 text-[var(--text-2)] sm:text-xl">
          LocalCloud brings an all-in-one local-development pattern to Google Cloud: service guides, generated local SDK endpoints, and a built-in console. Its proprietary Public Preview License is free for individuals and organizations, including for-profit companies, for non-production development and testing workflows.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`${base}docs/`} class="site-button site-button--primary">Start with LocalCloud</a>
          <a href={`${base}gcp-emulator/`} class="site-button site-button--secondary">Explore the GCP emulator</a>
          <a href={`${base}compatibility/`} class="site-button site-button--secondary">Check compatibility</a>
        </div>
      </div>
    </div>
  </section>

  <section class="site-section site-section--tight">
    <div class="container">
      <Callout type="info" title="Independent products, different cloud focus">
        LocalCloud is not affiliated with LocalStack. LocalStack is for AWS workflows; LocalCloud is built for Google Cloud local development.
      </Callout>
    </div>
  </section>

  <section class="site-section">
    <div class="container">
      <div class="max-w-[48rem] reveal">
        <span class="site-kicker">Choose the runtime that matches your cloud</span>
        <h2 class="mt-4">AWS local workflows and GCP local workflows are different jobs</h2>
        <p class="mt-4 text-lg leading-8 text-[var(--text-2)]">
          LocalStack is designed around AWS service emulation. LocalCloud serves a similar category for Google Cloud APIs under a proprietary Public Preview License. Run local GCP services for development and testing, then validate separately against real Google Cloud.
        </p>
      </div>

      <div class="site-panel mt-8 overflow-x-auto reveal" tabindex="0" role="region" aria-label="LocalStack and LocalCloud comparison">
        <p class="px-4 pt-4 text-sm text-[var(--text-2)] md:hidden">Swipe horizontally to compare all columns.</p>
        <table class="min-w-[42rem] w-full text-left text-sm">
          <thead class="border-b border-[var(--border)] text-[var(--text-2)]">
            <tr>
              <th scope="col" class="p-4 font-semibold">Question</th>
              <th scope="col" class="p-4 font-semibold">LocalStack</th>
              <th scope="col" class="p-4 font-semibold">LocalCloud</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-[var(--border)]">
              <th scope="row" class="p-4 text-left font-semibold text-[var(--text)]">Primary cloud</th>
              <td class="p-4 text-[var(--text-2)]">AWS workflows</td>
              <td class="p-4 text-[var(--text-2)]">Google Cloud workflows</td>
            </tr>
            <tr class="border-b border-[var(--border)]">
              <th scope="row" class="p-4 text-left font-semibold text-[var(--text)]">Google Cloud services</th>
              <td class="p-4 text-[var(--text-2)]">None; LocalStack covers AWS and Snowflake</td>
              <td class="p-4 text-[var(--text-2)]">{availableServiceCount} in one Docker container</td>
            </tr>
            <tr class="border-b border-[var(--border)]">
              <th scope="row" class="p-4 text-left font-semibold text-[var(--text)]">Sign-up and plans</th>
              <td class="p-4 text-[var(--text-2)]">Account and auth token required for current releases since March 23, 2026; free Hobby plan for non-commercial use, paid plans for commercial use</td>
              <td class="p-4 text-[var(--text-2)]">No account or license key; free during the public preview, and free for open-source projects after it</td>
            </tr>
            <tr class="border-b border-[var(--border)]">
              <th scope="row" class="p-4 text-left font-semibold text-[var(--text)]">Local development goal</th>
              <td class="p-4 text-[var(--text-2)]">Develop and test AWS-connected applications locally</td>
              <td class="p-4 text-[var(--text-2)]">Develop and test GCP-connected applications locally</td>
            </tr>
            <tr class="border-b border-[var(--border)]">
              <th scope="row" class="p-4 text-left font-semibold text-[var(--text)]">LocalCloud fit</th>
              <td class="p-4 text-[var(--text-2)]">Not a substitute for AWS emulation</td>
              <td class="p-4 text-[var(--text-2)]">GCP services, local endpoints, console, and permitted non-production workflows</td>
            </tr>
            <tr>
              <th scope="row" class="p-4 text-left font-semibold text-[var(--text)]">Production validation</th>
              <td class="p-4 text-[var(--text-2)]">Validate against AWS before production</td>
              <td class="p-4 text-[var(--text-2)]">Validate against Google Cloud before production</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-sm leading-6 text-[var(--text-2)]">
        LocalStack facts reviewed <time datetime={alternativesReviewedAt}>{alternativesReviewedLabel}</time> from <a href="https://www.localstack.cloud/pricing">LocalStack pricing</a> and <a href="https://blog.localstack.cloud/localstack-single-image-next-steps/">LocalStack's single-image announcement</a>. See the <a href={`${base}compare/`}>full comparison</a>, including Google's own emulators.
      </p>
    </div>
  </section>

  <section class="site-section site-section--tight">
    <div class="container">
      <div class="max-w-[48rem] reveal">
        <span class="site-kicker">Straight answer</span>
        <h2 class="mt-4">When LocalStack is the better choice</h2>
        <p class="mt-4 leading-8 text-[var(--text-2)]">
          If your application calls AWS APIs, use LocalStack. LocalCloud cannot serve S3, DynamoDB, Lambda, or SQS calls, and no amount of configuration will change that. LocalStack is also the older and more widely deployed project. LocalCloud is the right pick only when the code under test targets Google Cloud &mdash; BigQuery, Pub/Sub, Spanner, Bigtable, or Cloud Storage.
        </p>
        <p class="mt-4 leading-8 text-[var(--text-2)]">
          Teams building on both clouds commonly run both. The two runtimes bind different local ports and set different SDK environment variables, so they coexist in one development environment.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`${base}compare/localstack/`} class="site-button site-button--secondary">{relatedAnchor('/compare/localstack/')}</a>
          <a href={`${base}local-cloud-for-ai-agents/`} class="site-button site-button--secondary">Local cloud for AI agents</a>
          <a href={`${base}compare/`} class="site-button site-button--secondary">All comparisons</a>
        </div>
      </div>
    </div>
  </section>

  <section class="site-section">
    <div class="container grid gap-4 md:grid-cols-3">
      <article class="site-panel p-6 reveal">
        <span class="site-kicker">01</span>
        <h2 class="mt-3 text-2xl">Run major GCP services locally</h2>
        <p class="mt-3 leading-7 text-[var(--text-2)]">
          Start one Docker runtime, inspect its local services in the console, and work without a shared cloud development project for every iteration.
        </p>
        <a href={`${base}services/`} class="mt-5 inline-flex min-h-11 items-center text-sm font-semibold text-[var(--accent-strong)] hover:underline">Browse the service catalog</a>
      </article>
      <article class="site-panel p-6 reveal">
        <span class="site-kicker">02</span>
        <h2 class="mt-3 text-2xl">Keep your Google Cloud SDK code</h2>
        <p class="mt-3 leading-7 text-[var(--text-2)]">
          Point local development and test clients at emulator endpoints, then remove the local configuration when exercising real Google Cloud.
        </p>
        <a href={`${base}docs/sdk-examples/`} class="mt-5 inline-flex min-h-11 items-center text-sm font-semibold text-[var(--accent-strong)] hover:underline">See SDK examples</a>
      </article>
      <article class="site-panel p-6 reveal">
        <span class="site-kicker">03</span>
        <h2 class="mt-3 text-2xl">Know the runtime boundary</h2>
        <p class="mt-3 leading-7 text-[var(--text-2)]">
          Service behavior varies. Review supported capabilities and documented gaps before deciding which tests can stay local.
        </p>
        <a href={`${base}compatibility/`} class="mt-5 inline-flex min-h-11 items-center text-sm font-semibold text-[var(--accent-strong)] hover:underline">Review compatibility</a>
      </article>
    </div>
  </section>

  <section class="site-section">
    <div class="container container--narrow">
      <div class="reveal">
        <span class="site-kicker">Frequently asked questions</span>
        <h2 class="mt-4">Local GCP, without the cloud detour</h2>
      </div>
      <div class="mt-6 grid gap-3 reveal">
        {faqs.map((faq) => (
          <details class="site-panel cursor-pointer p-5">
            <summary class="text-lg font-semibold text-[var(--text)]">{faq.question}</summary>
            <p class="mt-3 leading-7 text-[var(--text-2)]">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="site-section">
    <div class="container">
      <div class="site-panel grid items-center gap-6 p-8 xl:grid-cols-[1fr_auto] reveal">
        <div>
          <span class="site-kicker">Ready to test locally?</span>
          <h2 class="mt-3">Start with the GCP services your application already uses.</h2>
          <p class="mt-3 max-w-[42rem] leading-7 text-[var(--text-2)]">{productFacts.availabilityStatement} Review the licensing documentation and compatibility details before adopting it for a team workflow.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={`${base}docs/`} class="site-button site-button--primary">Open the quick start</a>
          <a href={`${base}docs/licensing/`} class="site-button site-button--secondary">Read licensing</a>
        </div>
      </div>
    </div>
  </section>
</LandingLayout>
