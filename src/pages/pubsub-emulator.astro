---
import LandingLayout from '../layouts/LandingLayout.astro';
import CopyButton from '../components/CopyButton.astro';
import Callout from '../components/Callout.astro';
import ServiceIcon from '../components/ServiceIcon.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

const pythonCode = `import os
from google.cloud import pubsub_v1

os.environ["PUBSUB_EMULATOR_HOST"] = "localhost:8085"

publisher = pubsub_v1.PublisherClient()
topic_path = publisher.topic_path("local-project", "my-topic")
publisher.create_topic(name=topic_path)

future = publisher.publish(topic_path, b"Hello, LocalCloud!")
print(future.result())`;

const nodeCode = `process.env.PUBSUB_EMULATOR_HOST = 'localhost:8085';

const { PubSub } = require('@google-cloud/pubsub');
const pubsub = new PubSub({ projectId: 'local-project' });

async function main() {
  const [topic] = await pubsub.createTopic('my-topic');
  const messageId = await topic.publish(
    Buffer.from('Hello, LocalCloud!')
  );
  console.log('Published: ' + messageId);
}
main();`;

const faqItems = [
  {
    q: 'Does Google provide an official Pub/Sub emulator?',
    a: 'Yes — Google provides an official Pub/Sub emulator. However, it runs as a standalone process that you must manage separately from other emulators. LocalCloud bundles it alongside 20+ other GCP services in one container, adds persistence, and includes web-console operations for topic and subscription management.',
  },
  {
    q: 'How do I connect to the Pub/Sub emulator in Docker?',
    a: 'Set PUBSUB_EMULATOR_HOST=localhost:8085 and your GCP Pub/Sub SDK automatically connects to the local emulator. In CI/CD, LocalCloud runs as a service container — your test code uses the same SDK with zero changes.',
  },
  {
    q: 'Can I run Pub/Sub alongside BigQuery and Firestore locally?',
    a: 'Yes. LocalCloud runs Pub/Sub, BigQuery, Firestore, Spanner, Bigtable, Cloud Storage, and 15+ more GCP services in a single Docker container. Test end-to-end flows where Pub/Sub messages trigger Cloud Run services that write to BigQuery — all locally.',
  },
  {
    q: 'Does LocalCloud persist Pub/Sub topics and subscriptions?',
    a: 'Yes — unlike the default Google Pub/Sub emulator which loses all data on restart, LocalCloud persists topic and subscription state. Mount a volume to /var/lib/localcloud and your Pub/Sub state survives container restarts.',
  },
  {
    q: 'Can I use LocalCloud Pub/Sub in CI/CD pipelines?',
    a: 'Yes. Add LocalCloud as a service container in your CI pipeline (GitHub Actions, GitLab CI, Jenkins), set PUBSUB_EMULATOR_HOST, and test message publishing, subscription, and acknowledgment with zero GCP costs per pipeline run.',
  },
];
---

<LandingLayout
  title="Pub/Sub Emulator — Local Google Cloud Pub/Sub in Docker"
  description="Run Google Cloud Pub/Sub locally with LocalCloud's bundled emulator. Publish and subscribe to messages, test event-driven architectures, and run CI/CD pipelines with zero cloud costs — all in one Docker container."
>
  <script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Does Google provide an official Pub/Sub emulator?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes — Google provides an official Pub/Sub emulator. However, it runs as a standalone process. LocalCloud bundles it alongside 20+ other GCP services in one container, adds persistence, and includes web-console operations."
      }
    },
    {
      "@type": "Question",
      "name": "How do I connect to the Pub/Sub emulator in Docker?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Set PUBSUB_EMULATOR_HOST=localhost:8085 and your GCP Pub/Sub SDK automatically connects to the local emulator. In CI/CD, LocalCloud runs as a service container with zero code changes."
      }
    },
    {
      "@type": "Question",
      "name": "Can I run Pub/Sub alongside BigQuery and Firestore locally?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. LocalCloud runs Pub/Sub, BigQuery, Firestore, Spanner, Bigtable, Cloud Storage, and 15+ more GCP services in a single Docker container. Test end-to-end flows locally."
      }
    }
  ]
}
  </script>

  <!-- HERO -->
  <section class="site-section site-section--hero">
    <div class="container">
      <div class="max-w-[48rem] reveal">
        <span class="site-eyebrow"><span class="site-eyebrow__pulse"></span>Pub/Sub Emulator</span>
        <h1 class="mt-4">Run Google Cloud Pub/Sub locally</h1>
        <p class="mt-6 text-lg leading-8 text-[var(--text-2)] sm:text-xl">
          Publish, subscribe, and test event-driven architectures locally with LocalCloud's Pub/Sub emulator. Bundled with 20+ GCP services in one Docker container — zero cloud costs.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`${base}docs/`} class="site-button site-button--primary">Start in 60 seconds</a>
          <a href={`${base}services/pubsub/`} class="site-button site-button--secondary">Pub/Sub service details</a>
          <a href={`${base}gcp-emulator/`} class="site-button site-button--secondary">GCP emulator overview</a>
        </div>
      </div>
      <div class="mt-12 grid gap-4 sm:grid-cols-3 reveal">
        <article class="site-panel site-panel--soft p-5">
          <div class="text-3xl font-semibold tracking-[-0.08em] text-[var(--text)]">8085</div>
          <div class="mt-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-[var(--accent-strong)]">Default port</div>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Standard gRPC endpoint — your Pub/Sub SDK connects automatically with one environment variable.</p>
        </article>
        <article class="site-panel site-panel--soft p-5">
          <div class="text-3xl font-semibold tracking-[-0.08em] text-[var(--text)]">✅</div>
          <div class="mt-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-[var(--accent-strong)]">Official + extended</div>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Bundles Google's official emulator with added persistence and web console management.</p>
        </article>
        <article class="site-panel site-panel--soft p-5">
          <div class="text-3xl font-semibold tracking-[-0.08em] text-[var(--text)]">$0</div>
          <div class="mt-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-[var(--accent-strong)]">Per message</div>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Publish and consume unlimited messages locally — no GCP Pub/Sub charges during development or CI.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- QUICK START -->
  <section class="site-section">
    <div class="container">
      <div class="reveal">
        <h2>Publish your first message in 2 minutes</h2>
      </div>
      <div class="mt-6 grid gap-6 lg:grid-cols-2 reveal">
        <div class="site-panel overflow-hidden">
          <div class="px-4 pt-3 pb-2"><span class="site-kicker">Python</span></div>
          <pre class="border-0 rounded-none bg-transparent"><code class="block px-4 pb-4 text-[0.78rem] leading-[1.7]">{pythonCode}</code></pre>
        </div>
        <div class="site-panel overflow-hidden">
          <div class="px-4 pt-3 pb-2"><span class="site-kicker">Node.js</span></div>
          <pre class="border-0 rounded-none bg-transparent"><code class="block px-4 pb-4 text-[0.78rem] leading-[1.7]">{nodeCode}</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="site-section">
    <div class="container">
      <div class="reveal">
        <h2>What's included</h2>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-3 reveal">
        <article class="site-panel p-5">
          <span class="site-kicker">Topic & subscription CRUD</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Create, list, update, and delete topics and subscriptions. Push and pull subscriptions supported with full message lifecycle.</p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">Message publishing</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Publish messages with attributes, ordering keys, and batching — using the standard Pub/Sub client libraries in Python, Go, Java, and Node.js.</p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">Persistence</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Unlike the default Google emulator, LocalCloud persists topic and subscription state across container restarts via mounted volumes.</p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">Web console</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Create topics, publish test messages, and inspect subscriptions from the built-in web console at localhost:8080.</p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">Dead letter topics</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Configure dead letter queues for subscriptions and test retry and failure handling locally.</p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">CI/CD ready</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Add as a service container in GitHub Actions, GitLab CI, or Jenkins. Zero GCP costs per pipeline execution.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="site-section">
    <div class="container container--narrow">
      <div class="reveal">
        <h2>Frequently asked questions</h2>
      </div>
      <div class="mt-6 grid gap-3 reveal">
        {faqItems.map(item => (
          <details class="site-panel p-5 cursor-pointer">
            <summary class="font-semibold text-[var(--text)] text-[1.05rem]">{item.q}</summary>
            <p class="mt-3 text-[var(--text-2)] leading-7">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- BOTTOM CTA -->
  <section class="site-section">
    <div class="container">
      <div class="site-panel p-8 reveal" style="background: linear-gradient(135deg, rgba(31, 39, 50, 0.96), rgba(34, 42, 53, 0.98));">
        <div class="grid gap-6 xl:grid-cols-[1fr,auto] items-center">
          <div>
            <h2 style="color: #e8eaed;">Run Pub/Sub locally today</h2>
            <p class="mt-3 text-lg leading-8" style="color: rgba(246, 239, 228, 0.74);">
              Bundle Pub/Sub with 20+ GCP services in one Docker container. Same SDKs, same APIs, zero cloud costs. Free for individual developers.
            </p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a href={`${base}docs/`} class="site-button site-button--secondary">Read the docs</a>
            <a href={`${base}gcp-emulator/`} class="site-button site-button--primary">GCP emulator overview</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</LandingLayout>
