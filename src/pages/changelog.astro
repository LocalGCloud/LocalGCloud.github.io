---
import LandingLayout from '../layouts/LandingLayout.astro';
import { createBreadcrumbSchema, productFacts } from '../data/productFacts';
import { cliReleases, latestCliRelease, type CliRelease } from '../data/trust';

// Generated from the committed src/data/releases.json (node scripts/sync-releases.mjs).
const pageUrl = new URL(productFacts.changelogPath, productFacts.siteUrl).toString();
const formatDate = (date: string) =>
  new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }).format(new Date(`${date}T00:00:00Z`));
const listNames = (names: string[]) =>
  names.length < 3 ? names.join(' and ') : `${names.slice(0, -1).join(', ')}, and ${names.at(-1)}`;
// What a release ships, read from its asset names by scripts/sync-releases.mjs.
const shippedSentence = (release: CliRelease) => {
  const checks = release.checksums ? `, with SHA-256 checksums${release.sigstore ? ' and Sigstore bundles' : ''}` : '';
  const formula = release.homebrewFormula ? ', plus a Homebrew formula' : '';
  return `Archives for ${listNames(release.platforms)}${checks}${formula}.`;
};
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${pageUrl}#webpage`,
    url: pageUrl,
    name: 'LocalCloud changelog',
    dateModified: latestCliRelease.publishedAt,
    publisher: { '@id': new URL('#org', productFacts.siteUrl).toString() },
  },
  createBreadcrumbSchema([
    { name: 'Home', url: productFacts.siteUrl },
    { name: 'Changelog', url: pageUrl },
  ]),
];
---

<LandingLayout
  title="LocalCloud Changelog: CLI Releases"
  description={`Every LocalCloud CLI release with its date and downloads, newest first. The latest is ${latestCliRelease.version}, released ${formatDate(latestCliRelease.publishedAt)}.`}
  {structuredData}
>
  <section class="site-section site-section--hero">
    <div class="container container--narrow">
      <span class="site-eyebrow"><span class="site-eyebrow__pulse"></span>Changelog</span>
      <h1 class="mt-4">LocalCloud changelog</h1>
      <p class="mt-5 text-lg leading-8 text-[var(--text-2)]">
        CLI releases, newest first. Downloads and checksums for every release are on GitHub. To check a release before you install it, follow the steps on the <a href={productFacts.securityPath}>security page</a>.
      </p>
    </div>
  </section>

  <section class="site-section site-section--tight">
    <div class="container container--narrow">
      <ol class="changelog">
        {cliReleases.map((release) => (
          <li class="changelog__entry site-panel" id={release.tag}>
            <div class="changelog__head">
              <h2>{release.title}</h2>
              <time datetime={release.publishedAt}>{formatDate(release.publishedAt)}</time>
            </div>
            <ul class="site-list">
              {release.platforms.length > 0 && <li>{shippedSentence(release)}</li>}
              {release.summary && <li>{release.summary}</li>}
            </ul>
          </li>
        ))}
      </ol>
      <p class="mt-6 text-sm leading-7 text-[var(--text-2)]">
        All releases are listed on <a href={productFacts.cliReleasesUrl}>GitHub</a>. Install or upgrade with the commands in the <a href="/docs/">quick start</a>.
      </p>
    </div>
  </section>
</LandingLayout>

<style>
  .changelog {
    display: grid;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .changelog__entry {
    padding: 1.1rem 1.25rem;
  }

  .changelog__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }

  .changelog__head h2 {
    font-size: var(--fs-title);
    line-height: 1.3;
  }

  .changelog__head time {
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: var(--fs-small);
  }

  .changelog__entry .site-list {
    margin-top: 0.6rem;
  }

</style>
