---
import AgenticContentPage from '../../components/AgenticContentPage.astro';
import { glossaryPages } from '../../data/agenticContent';
import type { AgenticContentPage as Page } from '../../data/agenticContent';

export function getStaticPaths() {
  return glossaryPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

interface Props { page: Page; }
const { page } = Astro.props;
---

<AgenticContentPage {page} />
