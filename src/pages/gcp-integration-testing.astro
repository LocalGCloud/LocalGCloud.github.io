---
import LandingLayout from '../layouts/LandingLayout.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

const githubActionsYaml = `name: GCP Integration Tests
on: [push, pull_request]
jobs:
  test:
    runs-on: ubuntu-latest
    services:
      localcloud:
        image: jaysen2apache/localcloud
        ports:
          - 8080:8080
          - 8085:8085
          - 9050:9050
        options: --memory 4g

    steps:
      - uses: actions/checkout@v4

      - name: Wait for LocalCloud
        run: |
          for i in $(seq 1 30); do
            curl -sf http://localhost:8080/_localcloud/health && break
            sleep 2
          done

      - name: Run integration tests
        env:
          BIGQUERY_EMULATOR_HOST: http://localhost:9050
          PUBSUB_EMULATOR_HOST: localhost:8085
        run: pytest tests/integration/`;

const gitlabCiYaml = `integration-tests:
  image: python:3.12
  services:
    - name: jaysen2apache/localcloud
      alias: localcloud
  variables:
    BIGQUERY_EMULATOR_HOST: http://localcloud:9050
    PUBSUB_EMULATOR_HOST: localcloud:8085
  before_script:
    - pip install -r requirements.txt
    - |
      for i in $(seq 1 30); do
        curl -sf http://localcloud:8080/_localcloud/health && break
        sleep 2
      done
  script:
    - pytest tests/integration/`;

const jenkinsfile = `pipeline {
  agent { docker { image 'python:3.12' } }
  stages {
    stage('Integration Tests') {
      steps {
        docker.image('jaysen2apache/localcloud')
          .withRun('--memory 4g -p 9050:9050 -p 8085:8085') { c ->
            docker.image('appropriate/curl')
              .inside("--link \${c.id}:localcloud") {
                sh """
                  for i in \$(seq 1 30); do
                    curl -sf http://localcloud:8080/_localcloud/health && break
                    sleep 2
                  done
                """
              }
            withEnv([
              'BIGQUERY_EMULATOR_HOST=http://localcloud:9050',
              'PUBSUB_EMULATOR_HOST=localcloud:8085'
            ]) {
              sh 'pytest tests/integration/'
            }
          }
      }
    }
  }
}`;

const faqItems = [
  {
    q: 'How much do GCP-integrated CI/CD pipelines cost?',
    a: 'A typical CI pipeline that runs BigQuery queries, publishes to Pub/Sub, and reads from Cloud Storage can cost $5-50 per run. With 200+ pipeline executions per day across pull requests, merges, and scheduled runs, teams easily spend $3K-10K+ per month on CI GCP costs alone.',
  },
  {
    q: 'Does LocalCloud support GitHub Actions, GitLab CI, and Jenkins?',
    a: 'Yes. LocalCloud runs as a standard Docker service container — it works with any CI platform that supports Docker. Configure it in your workflow YAML, wait for the health check to pass, then run your tests with emulator environment variables set. No special plugins or integrations required.',
  },
  {
    q: 'Will my tests behave differently in CI vs local development?',
    a: 'No. Both CI and local development use the same LocalCloud Docker image. The emulator environment is deterministic and isolated per run. Tests that pass locally will pass in CI, and vice versa — eliminating the "works on my machine" problem.',
  },
  {
    q: 'How fast does LocalCloud start in CI?',
    a: 'LocalCloud boots in under 60 seconds on standard CI runners. The health check endpoint at localhost:8080/_localcloud/health returns 200 when all services are ready. Use a retry loop in your CI config to wait for readiness.',
  },
  {
    q: 'Can I run parallel test suites against the same LocalCloud instance?',
    a: 'Yes — each CI job gets its own isolated LocalCloud container. Services are namespaced per container, so parallel test suites don\'t interfere. For higher parallelism, run multiple LocalCloud instances on different ports.',
  },
];
---

<LandingLayout
  title="GCP Integration Testing in CI/CD — Zero Cloud Cost Pipelines"
  description="Replace real GCP in your CI/CD pipeline with LocalCloud. Run BigQuery, Pub/Sub, and Cloud Storage integration tests locally in GitHub Actions, GitLab CI, and Jenkins — zero cloud costs per pipeline run."
>
  <script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much do GCP-integrated CI/CD pipelines cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A typical CI pipeline that runs BigQuery queries, publishes to Pub/Sub, and reads from Cloud Storage can cost $5-50 per run. With 200+ pipeline executions per day, teams easily spend $3K-10K+ per month on CI GCP costs alone."
      }
    },
    {
      "@type": "Question",
      "name": "Does LocalCloud support GitHub Actions, GitLab CI, and Jenkins?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. LocalCloud runs as a standard Docker service container — it works with any CI platform that supports Docker. Configure it in your workflow YAML, wait for the health check to pass, then run your tests with emulator environment variables set."
      }
    },
    {
      "@type": "Question",
      "name": "Will my tests behave differently in CI vs local development?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Both CI and local development use the same LocalCloud Docker image. The emulator environment is deterministic and isolated per run. Tests that pass locally will pass in CI, and vice versa."
      }
    }
  ]
}
  </script>

  <!-- HERO -->
  <section class="site-section site-section--hero">
    <div class="container">
      <div class="max-w-[48rem] reveal">
        <span class="site-eyebrow"><span class="site-eyebrow__pulse"></span>CI / CD Integration Testing</span>
        <h1 class="mt-4">Replace real GCP in your CI pipeline</h1>
        <p class="mt-6 text-lg leading-8 text-[var(--text-2)] sm:text-xl">
          Run BigQuery, Pub/Sub, Cloud Storage, and 20+ GCP services as a CI service container. Every pull request gets its own isolated GCP environment — with zero cloud costs per pipeline execution.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`${base}docs/`} class="site-button site-button--primary">Start in 60 seconds</a>
          <a href={`${base}gcp-emulator/`} class="site-button site-button--secondary">GCP emulator overview</a>
        </div>
      </div>
      <div class="mt-12 grid gap-4 sm:grid-cols-3 reveal">
        <article class="site-panel site-panel--soft p-5">
          <div class="text-3xl font-semibold tracking-[-0.08em] text-[var(--text)]">$0</div>
          <div class="mt-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-[var(--accent-strong)]">Per CI run</div>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">No BigQuery query costs, no Pub/Sub message fees, no Cloud Storage egress — all local.</p>
        </article>
        <article class="site-panel site-panel--soft p-5">
          <div class="text-3xl font-semibold tracking-[-0.08em] text-[var(--text)]">&lt; 60s</div>
          <div class="mt-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-[var(--accent-strong)]">Startup time</div>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">LocalCloud boots in under a minute on standard CI runners — health check endpoint confirms readiness.</p>
        </article>
        <article class="site-panel site-panel--soft p-5">
          <div class="text-3xl font-semibold tracking-[-0.08em] text-[var(--text)]">All</div>
          <div class="mt-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-[var(--accent-strong)]">CI platforms</div>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">GitHub Actions, GitLab CI, Jenkins, CircleCI, Bitbucket Pipelines — any platform with Docker support.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- CI CONFIG EXAMPLES -->
  <section class="site-section">
    <div class="container">
      <div class="reveal">
        <h2>CI platform examples</h2>
        <p class="mt-4 max-w-[44rem] text-lg leading-8 text-[var(--text-2)]">
          LocalCloud works as a service container in any CI platform that supports Docker. Below are working examples for the most common platforms.
        </p>
      </div>

      <div class="mt-8 space-y-6 reveal">
        <div class="site-panel p-6">
          <span class="site-kicker">GitHub Actions</span>
          <pre class="mt-4 border-0 bg-[var(--surface-2)]"><code class="text-[0.82rem] leading-[1.75]">{githubActionsYaml}</code></pre>
        </div>

        <div class="site-panel p-6">
          <span class="site-kicker">GitLab CI</span>
          <pre class="mt-4 border-0 bg-[var(--surface-2)]"><code class="text-[0.82rem] leading-[1.75]">{gitlabCiYaml}</code></pre>
        </div>

        <div class="site-panel p-6">
          <span class="site-kicker">Jenkins (Docker Pipeline)</span>
          <pre class="mt-4 border-0 bg-[var(--surface-2)]"><code class="text-[0.82rem] leading-[1.75]">{jenkinsfile}</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- BENEFITS -->
  <section class="site-section">
    <div class="container">
      <div class="reveal">
        <h2>Why replace real GCP in CI with local emulation</h2>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4 reveal">
        <article class="site-panel p-5">
          <span class="site-kicker">Zero cost</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Eliminate GCP costs from your CI pipeline entirely. No BigQuery query charges, no Pub/Sub message fees, no Cloud Storage egress — every pipeline run costs $0 in cloud resources.</p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">Deterministic</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Every CI run starts from a clean, isolated GCP environment. No test pollution from previous runs, no shared state, no flaky tests caused by cloud-side changes.</p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">Faster feedback</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Sub-millisecond latency for local services vs 50-200ms network round-trips to GCP. Tests run faster, CI pipelines finish sooner.</p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">No credentials</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">No GCP service accounts, no IAM roles, no credentials to rotate. Your CI config has zero secrets related to GCP access.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="site-section">
    <div class="container container--narrow">
      <div class="reveal">
        <h2>Frequently asked questions</h2>
      </div>
      <div class="mt-6 grid gap-3 reveal">
        {faqItems.map(item => (
          <details class="site-panel p-5 cursor-pointer">
            <summary class="font-semibold text-[var(--text)] text-[1.05rem]">{item.q}</summary>
            <p class="mt-3 text-[var(--text-2)] leading-7">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- BOTTOM CTA -->
  <section class="site-section">
    <div class="container">
      <div class="site-panel p-8 reveal" style="background: linear-gradient(135deg, rgba(31, 39, 50, 0.96), rgba(34, 42, 53, 0.98));">
        <div class="grid gap-6 xl:grid-cols-[1fr,auto] items-center">
          <div>
            <h2 style="color: #e8eaed;">Add LocalCloud to your CI pipeline</h2>
            <p class="mt-3 text-lg leading-8" style="color: rgba(246, 239, 228, 0.74);">
              One Docker service container. 20+ GCP services. Zero cloud costs per pipeline execution. Free for individual developers.
            </p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a href={`${base}docs/`} class="site-button site-button--secondary">Read the docs</a>
            <a href={`${base}reduce-gcp-dev-costs/`} class="site-button site-button--primary">See cost savings</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</LandingLayout>
