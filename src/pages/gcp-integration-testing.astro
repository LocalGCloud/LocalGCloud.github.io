---
import LandingLayout from '../layouts/LandingLayout.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

const githubActionsYaml = `name: GCP Integration Tests
on: [push, pull_request]
jobs:
  test:
    runs-on: ubuntu-latest
    services:
      localcloud:
        image: agentcloud/localcloud:latest
        ports:
          - 5380:5380
          - 5383:5383
          - 5388:5388
        options: --memory 4g

    steps:
      - uses: actions/checkout@v4

      - name: Wait for LocalCloud
        run: |
          for i in $(seq 1 30); do
            if curl -fsS http://localhost:5380/health; then exit 0; fi
            sleep 2
          done
          docker logs localcloud
          exit 1

      - name: Run integration tests
        env:
          BIGQUERY_EMULATOR_HOST: http://localhost:5388
          PUBSUB_EMULATOR_HOST: localhost:5383
        run: pytest tests/integration/`;

const gitlabCiYaml = `integration-tests:
  image: python:3.12
  services:
    - name: agentcloud/localcloud:latest
      alias: localcloud
  variables:
    BIGQUERY_EMULATOR_HOST: http://localcloud:5388
    PUBSUB_EMULATOR_HOST: localcloud:5383
  before_script:
    - pip install -r requirements.txt
    - |
      for i in $(seq 1 30); do
        if curl -fsS http://localcloud:5380/health; then exit 0; fi
        sleep 2
      done
      exit 1
  script:
    - pytest tests/integration/`;

const jenkinsfile = `pipeline {
  agent { docker { image 'python:3.12' } }
  stages {
    stage('Integration Tests') {
      steps {
        docker.image('agentcloud/localcloud:latest')
          .withRun('--memory 4g -p 5388:5388 -p 5383:5383') { c ->
            docker.image('appropriate/curl')
              .inside("--link \${c.id}:localcloud") {
                sh """
                  for i in \$(seq 1 30); do
                    if curl -fsS http://localcloud:5380/health; then exit 0; fi
                    sleep 2
                  done
                  exit 1
                """
              }
            withEnv([
              'BIGQUERY_EMULATOR_HOST=http://localcloud:5388',
              'PUBSUB_EMULATOR_HOST=localcloud:5383'
            ]) {
              sh 'pytest tests/integration/'
            }
          }
      }
    }
  }
}`;

const faqItems = [
  {
    q: 'How much do GCP-integrated CI/CD pipelines cost?',
    a: 'Cost depends on your Google Cloud usage, pricing, regions, and billing agreements. This site has no maintained dataset supporting a typical per-run or monthly savings figure. Use authorized billing data for estimates.',
  },
  {
    q: 'Does LocalCloud support GitHub Actions, GitLab CI, and Jenkins?',
    a: 'Yes. This page has templates for all three. The Public Preview License permits non-production internal CI for individuals and organizations, including for-profit companies. Test runner networking and service-container behavior on your runner.',
  },
  {
    q: 'Will my tests behave differently in CI vs local development?',
    a: 'They can differ because of image identity, runner resources, networking, ports, concurrency, and retained state. Pin an image digest, isolate state, and validate production behavior separately.',
  },
  {
    q: 'How fast does LocalCloud start in CI?',
    a: 'No maintained cross-runner startup benchmark is available. Poll http://localhost:5380/health with a job timeout and inspect logs on failure.',
  },
  {
    q: 'Can I run parallel test suites against the same LocalCloud runtime?',
    a: 'Use one isolated data volume and project per job. Parallel clients can still contend for service state, resources, and ports; namespace fixtures and verify concurrency behavior rather than assuming isolation guarantees.',
  },
];
---

<LandingLayout
  title="GCP Integration Testing in CI — LocalCloud"
  description="Run Google Cloud integration tests in CI against local LocalCloud endpoints, with health gates, pinned images, and a separate production validation step."
>
  <script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much do GCP-integrated CI/CD pipelines cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Cost depends on actual Google Cloud usage and pricing. This site has no maintained dataset supporting a typical per-run or monthly savings figure."
      }
    },
    {
      "@type": "Question",
      "name": "Does LocalCloud support GitHub Actions, GitLab CI, and Jenkins?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. This page has templates for all three. The Public Preview License permits individuals and organizations, including for-profit companies, to run LocalCloud in ongoing internal CI. Test runner behavior on your runner."
      }
    },
    {
      "@type": "Question",
      "name": "Will my tests behave differently in CI vs local development?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Local and CI behavior can differ because of image identity, resources, networking, concurrency, ports, and retained state. Validate production behavior separately."
      }
    }
  ]
}
  </script>

  <!-- HERO -->
  <section class="site-section site-section--hero">
    <div class="container">
      <div class="max-w-[48rem] reveal">
        <span class="site-eyebrow"><span class="site-eyebrow__pulse"></span>Internal automation</span>
        <h1 class="mt-4">Run LocalCloud in team CI</h1>
        <p class="mt-6 text-lg leading-8 text-[var(--text-2)] sm:text-xl">
          Run Google Cloud integration tests in CI against local endpoints. Keep the job isolated, pin the image, and validate against real Google Cloud separately. The Public Preview License permits ongoing internal CI for individuals and organizations, including for-profit companies.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`${base}docs/`} class="site-button site-button--primary">Review local setup</a>
          <a href={`${base}gcp-emulator/`} class="site-button site-button--secondary">GCP emulator overview</a>
        </div>
      </div>
      <div class="mt-12 grid gap-4 sm:grid-cols-3 reveal">
        <article class="site-panel site-panel--soft p-5">
          <div class="text-xl font-semibold text-[var(--text)]">Supported operations only</div>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Select only operations supported by the current compatibility contract.</p>
        </article>
        <article class="site-panel site-panel--soft p-5">
          <div class="text-xl font-semibold text-[var(--text)]">Wait for health</div>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Do not run tests unless the health gate succeeds; retain logs when startup fails.</p>
        </article>
        <article class="site-panel site-panel--soft p-5">
          <div class="text-xl font-semibold text-[var(--text)]">Test on your runner</div>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Treat these as templates until exercised with a pinned image on the selected CI runner.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- CI CONFIG EXAMPLES -->
  <section class="site-section">
    <div class="container">
      <div class="reveal">
        <h2>Technical examples for internal automation</h2>
        <p class="mt-4 max-w-[44rem] text-lg leading-8 text-[var(--text-2)]">
          Use these templates only within the governing Public Preview License. Exercise networking, health, image identity, and cleanup on the exact runner.
        </p>
      </div>

      <div class="mt-8 space-y-6 reveal">
        <div class="site-panel p-6">
          <span class="site-kicker">GitHub Actions</span>
          <pre class="mt-4 border-0 bg-[var(--surface-2)]"><code>{githubActionsYaml}</code></pre>
        </div>

        <div class="site-panel p-6">
          <span class="site-kicker">GitLab CI</span>
          <pre class="mt-4 border-0 bg-[var(--surface-2)]"><code>{gitlabCiYaml}</code></pre>
        </div>

        <div class="site-panel p-6">
          <span class="site-kicker">Jenkins (Docker Pipeline)</span>
          <pre class="mt-4 border-0 bg-[var(--surface-2)]"><code>{jenkinsfile}</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- BENEFITS -->
  <section class="site-section">
    <div class="container">
      <div class="reveal">
        <h2>What local emulation can add</h2>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4 reveal">
        <article class="site-panel p-5">
          <span class="site-kicker">Local isolation</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Exercise documented operations without routing the local test step to a real Google Cloud project.</p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">Controlled state</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Use one data volume, project, and fixture namespace per job. Explicitly reset or seed state and do not assume emulator concurrency or isolation matches Google Cloud.</p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">Earlier feedback</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">Catch endpoint, request-shape, and fixture errors before the guarded real-Google-Cloud release step.</p>
        </article>
        <article class="site-panel p-5">
          <span class="site-kicker">Credential boundary</span>
          <p class="mt-3 text-sm leading-7 text-[var(--text-2)]">The bounded local job should not need production GCP credentials. Stop if an SDK tries to reach Google Cloud; keep release credentials in a separate guarded job.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="site-section">
    <div class="container container--narrow">
      <div class="reveal">
        <h2>Frequently asked questions</h2>
      </div>
      <div class="mt-6 grid gap-3 reveal">
        {faqItems.map(item => (
          <details class="site-panel p-5 cursor-pointer">
            <summary class="font-semibold text-[var(--text)] text-lg">{item.q}</summary>
            <p class="mt-3 text-[var(--text-2)] leading-7">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- BOTTOM CTA -->
  <section class="site-section">
    <div class="container">
      <div class="site-panel grid items-center gap-6 p-8 xl:grid-cols-[1fr_auto] reveal">
        <div>
          <h2>Review the license before automating LocalCloud</h2>
          <p class="mt-3 max-w-[42rem] text-lg leading-8 text-[var(--text-2)]">
            The Public Preview License permits organization and team CI for non-production development and testing. Keep LocalCloud isolated and validate production behavior separately.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={`${base}compatibility/`} class="site-button site-button--primary">Review compatibility</a>
          <a href={`${base}docs/`} class="site-button site-button--secondary">Read the docs</a>
        </div>
      </div>
    </div>
  </section>
</LandingLayout>
