---
import LandingLayout from '../layouts/LandingLayout.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import { docsContract } from '../data/docs-contract';
import { availableServiceCount, publishedServiceCount } from '../data/services';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

const quickStartCmd = `${docsContract.cli.installCommand}
localcloud doctor
localcloud start
eval "$(localcloud env)"
localcloud console`;

const services = [
  { name: 'BigQuery', port: '24087 / 24088', availability: '10 documented workflows', env: 'BIGQUERY_EMULATOR_HOST' },
  { name: 'Cloud Storage', port: '24081', availability: '2 documented workflows', env: 'STORAGE_EMULATOR_HOST' },
  { name: 'Firestore', port: '24083', availability: '2 documented workflows', env: 'FIRESTORE_EMULATOR_HOST' },
  { name: 'Pub/Sub', port: '24082', availability: '4 documented workflows', env: 'PUBSUB_EMULATOR_HOST' },
  { name: 'Spanner', port: '24085 / 24086', availability: '5 documented workflows', env: 'SPANNER_EMULATOR_HOST' },
  { name: 'Bigtable', port: '24084', availability: '13 documented workflows', env: 'BIGTABLE_EMULATOR_HOST' },
];

const faqItems = [
  {
    q: 'Why run Google Cloud services locally?',
    a: 'Local emulation can provide a controlled inner loop without sending each supported request to Google Cloud. It does not reproduce production latency, quotas, IAM, or every API behavior.',
  },
  {
    q: 'Do I need to change my application code?',
    a: 'Many bounded workflows use standard Google Cloud clients after localcloud env sets emulator endpoints. Compatibility varies by service and client; never fall back to real Google Cloud silently.',
  },
  {
    q: 'Can I run this in CI/CD pipelines?',
    a: 'Yes. The Public Preview License permits non-production internal CI for individuals and organizations, including for-profit companies. Review the license and test the exact runner before use.',
  },
  {
    q: 'How is LocalCloud licensed?',
    a: 'The proprietary Public Preview License permits individuals and organizations, including for-profit companies, to use LocalCloud free of charge for non-production development, testing, CI, evaluation, and internal pilots. Technical Community or Pro tiers do not expand that legal permission.',
  },
];
---

<LandingLayout
  title="How to Run Google Cloud Services Locally — Complete Guide"
  description={`Install the LocalCloud CLI, start a loopback-bound runtime, and configure local workflows across ${availableServiceCount} available services.`}
>
  <script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Run Google Cloud Services Locally",
  "description": "Complete guide to running BigQuery, Cloud Storage, Pub/Sub, Spanner, Bigtable, and other GCP services locally using LocalCloud emulator",
  "step": [
    {
      "@type": "HowToStep",
      "name": "Install Docker",
      "text": "Install Docker Desktop for Mac/Windows or Docker Engine for Linux"
    },
    {
      "@type": "HowToStep",
      "name": "Install LocalCloud CLI",
      "text": "Run the LocalCloud install script or use the Homebrew tap."
    },
    {
      "@type": "HowToStep",
      "name": "Diagnose Docker",
      "text": "Run localcloud doctor and resolve any Docker issue it reports."
    },
    {
      "@type": "HowToStep",
      "name": "Start LocalCloud",
      "text": "Run localcloud start and use the URL and endpoint settings returned by the CLI."
    },
    {
      "@type": "HowToStep",
      "name": "Configure environment variables",
      "text": "Run eval \"$(localcloud env)\" in the shell that starts your application."
    }
  ]
}
  </script>

  <script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Why run Google Cloud services locally?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Local emulation provides a controlled inner loop for supported workflows. It does not reproduce production latency, quotas, IAM, or every API behavior."
      }
    },
    {
      "@type": "Question",
      "name": "Does Google provide official local emulators?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "LocalCloud combines official, third-party, and custom components. External emulator counts are omitted because they were not validated from authorized local evidence."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need to change my application code?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Use localcloud env to configure supported client workflows, then validate behavior against real Google Cloud before production."
      }
    }
  ]
}
  </script>

  <!-- HERO -->
  <section class="site-section site-section--hero">
    <div class="container">
      <div class="max-w-[48rem] reveal">
        <span class="site-eyebrow"><span class="site-eyebrow__pulse"></span>Complete Guide</span>
        <h1 class="mt-4">How to run Google Cloud services locally</h1>
        <p class="mt-6 text-lg leading-8 text-[var(--text-2)] sm:text-xl">
          Install the host CLI, start a loopback-bound runtime, and inspect bounded service workflows and limitations.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#quick-start" class="site-button site-button--primary">Quick start</a>
          <a href={`${base}docs/`} class="site-button site-button--secondary">Full documentation</a>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY RUN LOCALLY -->
  <section class="site-section">
    <div class="container">
      <div class="reveal">
        <h2>Why run Google Cloud services locally?</h2>
        <p class="mt-4 max-w-[44rem] text-lg leading-8 text-[var(--text-2)]">
          Local emulation provides a controlled inner loop for supported workflows. It does not reproduce production latency, IAM, quotas, or every Google Cloud behavior.
        </p>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4 reveal">
        <article class="site-panel site-panel--soft p-5">
          <div class="font-semibold text-[var(--text)]">Local request path</div>
          <p class="mt-2 text-sm leading-7 text-[var(--text-2)]">Supported requests target loopback endpoints. Review the governing license before use and stop rather than falling back to real Google Cloud.</p>
        </article>
        <article class="site-panel site-panel--soft p-5">
          <div class="font-semibold text-[var(--text)]">Local feedback loop</div>
          <p class="mt-2 text-sm leading-7 text-[var(--text-2)]">Local behavior depends on host resources and is not a production performance benchmark.</p>
        </article>
        <article class="site-panel site-panel--soft p-5">
          <div class="font-semibold text-[var(--text)]">Outbound-aware operation</div>
          <p class="mt-2 text-sm leading-7 text-[var(--text-2)]">Core workflows can continue after the image is present, but telemetry and other configured features can make outbound requests.</p>
        </article>
        <article class="site-panel site-panel--soft p-5">
          <div class="font-semibold text-[var(--text)]">Managed lifecycle</div>
          <p class="mt-2 text-sm leading-7 text-[var(--text-2)]">The CLI selects a Docker data volume, manages a loopback-bound runtime, and exports its actual endpoints. Organization use must comply with the proprietary license.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- QUICK START -->
  <section class="site-section" id="quick-start">
    <div class="container">
      <div class="reveal">
        <h2>Quick start with the LocalCloud CLI</h2>
        <p class="mt-4 max-w-[44rem] text-lg leading-8 text-[var(--text-2)]">
          Install the host CLI, diagnose Docker, start a persistent local runtime, and use its dynamically resolved endpoint settings.
        </p>
      </div>
      <div class="mt-8 site-panel p-6 reveal">
        <pre class="overflow-x-auto text-sm"><code>{quickStartCmd}</code></pre>
      </div>
      <div class="mt-6 reveal">
        <p class="text-[var(--text-2)] leading-7">
        </p>
      </div>
    </div>
  </section>

  <!-- SERVICES TABLE -->
  <section class="site-section">
    <div class="container">
      <div class="reveal">
        <h2>What Google Cloud services can run locally?</h2>
        <p class="mt-4 max-w-[44rem] text-lg leading-8 text-[var(--text-2)]">
          LocalCloud exposes {availableServiceCount} available services in one managed container. Review each service guide for exact workflows, default enablement, and limitations.
        </p>
      </div>
      <div class="mt-8 overflow-x-auto reveal">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-[var(--border-1)]">
            <tr>
              <th class="py-3 font-semibold text-[var(--text)]">Service</th>
              <th class="py-3 font-semibold text-[var(--text)]">Port</th>
              <th class="py-3 font-semibold text-[var(--text)]">Local support</th>
              <th class="py-3 font-semibold text-[var(--text)]">Environment Variable</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--border-1)]">
            {services.map(svc => (
              <tr>
                <td class="py-3 text-[var(--text)]">{svc.name}</td>
                <td class="py-3 text-[var(--text-2)] font-mono text-xs">{svc.port}</td>
                <td class="py-3 text-[var(--accent-strong)]">{svc.availability}</td>
                <td class="py-3 text-[var(--text-2)] font-mono text-xs">{svc.env}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="mt-6 reveal">
        <p class="text-sm text-[var(--text-2)] leading-7">
          Browse <a href={`${base}services/`} class="underline">all {publishedServiceCount} service guides</a>. Firestore is available but disabled by default; Google Sheets is an available read-only facade with limited A1-range behavior.
        </p>
      </div>
    </div>
  </section>

  <!-- STEP-BY-STEP SETUP -->
  <section class="site-section site-section--tight">
    <div class="container">
      <div class="reveal">
        <h2>Step-by-step setup guide</h2>
      </div>
      <div class="mt-8 grid gap-6 reveal">
        <article class="site-panel p-6">
          <div class="flex items-start gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[var(--accent-soft)] font-semibold text-[var(--accent-strong)]">1</div>
            <div class="flex-1">
              <h3 class="text-lg font-semibold text-[var(--text)]">Install Docker</h3>
              <p class="mt-2 text-[var(--text-2)] leading-7">Install Docker Desktop (Mac/Windows) or Docker Engine (Linux). LocalCloud requires Docker to run the emulator container.</p>
              <div class="mt-3">
                <a href="https://docs.docker.com/get-docker/" target="_blank" rel="noopener" class="text-sm text-[var(--accent-strong)] underline">Install Docker →</a>
              </div>
            </div>
          </div>
        </article>

        <article class="site-panel p-6">
          <div class="flex items-start gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[var(--accent-soft)] font-semibold text-[var(--accent-strong)]">2</div>
            <div class="flex-1">
              <h3 class="text-lg font-semibold text-[var(--text)]">Install the CLI</h3>
              <p class="mt-2 text-[var(--text-2)] leading-7">Use the checksum-verifying installer on a supported macOS or Linux host:</p>
              <pre class="mt-3 overflow-x-auto rounded bg-[var(--panel-1)] p-3 text-xs"><code>{docsContract.cli.installCommand}</code></pre>
            </div>
          </div>
        </article>

        <article class="site-panel p-6">
          <div class="flex items-start gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[var(--accent-soft)] font-semibold text-[var(--accent-strong)]">3</div>
            <div class="flex-1">
              <h3 class="text-lg font-semibold text-[var(--text)]">Diagnose and start</h3>
              <p class="mt-2 text-[var(--text-2)] leading-7">The CLI keeps Docker under your control and starts a loopback-bound persistent runtime:</p>
              <pre class="mt-3 overflow-x-auto rounded bg-[var(--panel-1)] p-3 text-xs"><code>localcloud doctor
localcloud start</code></pre>
              <p class="mt-3 text-sm text-[var(--text-2)] leading-7">Use the URL and endpoint map in the output. If canonical ports are occupied, the CLI assigns dynamic host ports.</p>
            </div>
          </div>
        </article>

        <article class="site-panel p-6">
          <div class="flex items-start gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[var(--accent-soft)] font-semibold text-[var(--accent-strong)]">4</div>
            <div class="flex-1">
              <h3 class="text-lg font-semibold text-[var(--text)]">Configure and inspect</h3>
              <p class="mt-2 text-[var(--text-2)] leading-7">Export the actual local endpoints into the shell that starts your application, then open the selected console URL:</p>
              <pre class="mt-3 overflow-x-auto rounded bg-[var(--panel-1)] p-3 text-xs"><code>eval "$(localcloud env)"
localcloud console
localcloud status</code></pre>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- SERVICE-SPECIFIC GUIDES -->
  <section class="site-section">
    <div class="container">
      <div class="reveal">
        <h2>Service-specific setup guides</h2>
        <p class="mt-4 max-w-[44rem] text-lg leading-8 text-[var(--text-2)]">
          Each GCP service has unique configuration and SDK patterns. Follow these guides for service-specific setup instructions.
        </p>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-3 reveal">
        <a href={`${base}bigquery-emulator/`} class="site-panel site-panel--soft p-5 hover:border-[var(--accent-strong)] transition-colors">
          <div class="font-semibold text-[var(--text)]">BigQuery</div>
          <p class="mt-2 text-sm leading-7 text-[var(--text-2)]">Develop 10 documented DuckDB-backed dataset, table, query, scripting, and API workflows.</p>
        </a>
        <a href={`${base}cloud-storage-emulator/`} class="site-panel site-panel--soft p-5 hover:border-[var(--accent-strong)] transition-colors">
          <div class="font-semibold text-[var(--text)]">Cloud Storage</div>
          <p class="mt-2 text-sm leading-7 text-[var(--text-2)]">Use verified bounded bucket and object workflows backed by the LocalCloud volume.</p>
        </a>
        <a href={`${base}firestore-emulator/`} class="site-panel site-panel--soft p-5 hover:border-[var(--accent-strong)] transition-colors">
          <div class="font-semibold text-[var(--text)]">Firestore</div>
          <p class="mt-2 text-sm leading-7 text-[var(--text-2)]">Firestore document CRUD and query workflows are available on port 24083. Enable Firestore explicitly before use and review its query, index, seed, and persistence limits.</p>
        </a>
        <a href={`${base}pubsub-emulator/`} class="site-panel site-panel--soft p-5 hover:border-[var(--accent-strong)] transition-colors">
          <div class="font-semibold text-[var(--text)]">Pub/Sub</div>
          <p class="mt-2 text-sm leading-7 text-[var(--text-2)]">Use partial topic, subscription, publish, pull, and acknowledgement workflows; state is volatile across restart.</p>
        </a>
        <a href={`${base}spanner-emulator/`} class="site-panel site-panel--soft p-5 hover:border-[var(--accent-strong)] transition-colors">
          <div class="font-semibold text-[var(--text)]">Spanner</div>
          <p class="mt-2 text-sm leading-7 text-[var(--text-2)]">Use 5 documented Spanner data and administration workflows over gRPC and REST.</p>
        </a>
        <a href={`${base}bigtable-emulator/`} class="site-panel site-panel--soft p-5 hover:border-[var(--accent-strong)] transition-colors">
          <div class="font-semibold text-[var(--text)]">Bigtable</div>
          <p class="mt-2 text-sm leading-7 text-[var(--text-2)]">Use 13 documented Bigtable data, administration, persistence, and query workflows.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- PERSONAL AUTOMATION -->
  <section class="site-section site-section--tight">
    <div class="container">
      <div class="reveal">
        <h2>Automating an internal development project</h2>
        <p class="mt-4 max-w-[44rem] text-lg leading-8 text-[var(--text-2)]">
          The Public Preview License permits individuals and organizations, including for-profit companies, to use containerized automation for ongoing internal development, testing, and CI.
        </p>
      </div>
      <div class="mt-8 site-panel p-6 reveal">
        <h3 class="text-lg font-semibold text-[var(--text)]">Keep automation inside the preview boundary</h3>
        <p class="mt-4 text-sm leading-7 text-[var(--text-2)]">For permitted internal automation, pin the image, wait on <code>/readiness</code>, export values from the running LocalCloud runtime, and stop rather than falling back to real Google Cloud. Customer-facing production use remains outside the preview grant.</p>
      </div>
      <div class="mt-6 reveal">
        <p class="text-sm text-[var(--text-2)] leading-7">
          See the <a href={`${base}gcp-integration-testing/`} class="underline">automation eligibility and integration guide</a> before using a hosted runner.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="site-section">
    <div class="container container--narrow">
      <div class="reveal">
        <h2>Frequently asked questions</h2>
      </div>
      <div class="mt-6 grid gap-3 reveal">
        {faqItems.map(item => (
          <details class="site-panel p-5 cursor-pointer">
            <summary class="font-semibold text-[var(--text)] text-[1.05rem]">{item.q}</summary>
            <p class="mt-3 text-[var(--text-2)] leading-7">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- BOTTOM CTA -->
  <section class="site-section">
    <div class="container">
      <div class="site-panel p-8 reveal" style="background: linear-gradient(135deg, rgba(31, 39, 50, 0.96), rgba(34, 42, 53, 0.98));">
        <div class="grid gap-6 xl:grid-cols-[1fr,auto] items-center">
          <div>
            <h2 style="color: #e8eaed;">Start running GCP services locally</h2>
            <p class="mt-3 text-lg leading-8" style="color: rgba(246, 239, 228, 0.74);">
              One data-volume runtime, {availableServiceCount} available services, and explicit service boundaries.
            </p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a href={`${base}docs/`} class="site-button site-button--secondary">Read the docs</a>
            <a href={`${base}services/`} class="site-button site-button--primary">Review service evidence</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</LandingLayout>
