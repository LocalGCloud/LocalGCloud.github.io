---
import LandingLayout from '../layouts/LandingLayout.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import { docsContract } from '../data/docs-contract';
import { cliQuickStart } from '../utils/quickstart.mjs';
import { availableServiceCount, publishedServiceCount, getServiceSignalLabel, services as catalogServices } from '../data/services';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

const quickStart = cliQuickStart(docsContract);
const startCommands = quickStart.steps.slice(0, quickStart.steps.indexOf(quickStart.readiness) + 1).join('\n');
const spannerWorkflowCount = catalogServices.find((service) => service.id === 'spanner')?.supported.length ?? 0;

const services = catalogServices
  .filter((service) => ['bigquery', 'gcs', 'firestore', 'pubsub', 'spanner', 'bigtable'].includes(service.id))
  .map((service) => ({
    name: service.name,
    port: service.status === 'unsupported' ? 'Unsupported' : service.port,
    availability: getServiceSignalLabel(service),
    env: service.status === 'unsupported' ? 'No supported integration' : service.envVar,
  }));

const faqItems = [
  {
    q: 'Do I need to change my application code?',
    a: 'It depends on the client. Many workflows use standard Google Cloud clients once localcloud env sets the emulator endpoints; compatibility varies by service and client. If a client tries to reach real Google Cloud, stop and fix the configuration.',
  },
  {
    q: 'Can I run this in CI/CD pipelines?',
    a: 'Yes. The Public Preview License permits non-production internal CI for individuals and organizations, including for-profit companies. Review the license and test the exact runner before use.',
  },
  {
    q: 'How is LocalCloud licensed?',
    a: 'The proprietary Public Preview License permits individuals and organizations, including for-profit companies, to use LocalCloud free of charge for non-production development, testing, CI, evaluation, and internal pilots. Pro-tier services are included free during the preview.',
  },
];
---

<LandingLayout
  title="How to Run Google Cloud Services Locally — Complete Guide"
  description={`Install the LocalCloud CLI, start a localhost-only runtime, and connect your code to ${availableServiceCount} local Google Cloud services.`}
>
  <script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Run Google Cloud Services Locally",
  "description": "Complete guide to running BigQuery, Cloud Storage, Pub/Sub, Spanner, Bigtable, and other GCP services locally using LocalCloud emulator",
  "step": [
    {
      "@type": "HowToStep",
      "name": "Install Docker",
      "text": "Install Docker Desktop for Mac/Windows or Docker Engine for Linux"
    },
    {
      "@type": "HowToStep",
      "name": "Install LocalCloud CLI",
      "text": "Run the LocalCloud install script or use the Homebrew tap."
    },
    {
      "@type": "HowToStep",
      "name": "Diagnose Docker",
      "text": "Run localcloud doctor and resolve any Docker issue it reports."
    },
    {
      "@type": "HowToStep",
      "name": "Start LocalCloud",
      "text": "Run localcloud start and use the URL and endpoint settings returned by the CLI."
    },
    {
      "@type": "HowToStep",
      "name": "Configure environment variables",
      "text": "Run eval \"$(localcloud env)\" in the shell that starts your application."
    }
  ]
}
  </script>

  <script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Does Google provide official local emulators?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, for some services. LocalCloud combines official, third-party, and custom emulators behind one CLI."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need to change my application code?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "It depends on the client. Many workflows use standard Google Cloud clients once localcloud env sets the emulator endpoints; compatibility varies by service and client. If a client tries to reach real Google Cloud, stop and fix the configuration."
      }
    }
  ]
}
  </script>

  <!-- HERO -->
  <section class="site-section site-section--hero">
    <div class="container">
      <div class="max-w-[48rem] reveal">
        <span class="site-eyebrow"><span class="site-eyebrow__pulse"></span>Complete Guide</span>
        <h1 class="mt-4">How to run Google Cloud services locally</h1>
        <p class="mt-6 text-lg leading-8 text-[var(--text-2)] sm:text-xl">
          Install the CLI, start a runtime that listens only on localhost, and check what each service supports.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#quick-start" class="site-button site-button--primary">Quick start</a>
          <a href={`${base}docs/`} class="site-button site-button--secondary">Full documentation</a>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY RUN LOCALLY -->
  <section class="site-section">
    <div class="container">
      <div class="reveal">
        <h2>Why run Google Cloud services locally?</h2>
        <p class="mt-4 max-w-[44rem] text-lg leading-8 text-[var(--text-2)]">
          Local emulation provides a controlled inner loop for supported workflows. It does not reproduce production latency, IAM, quotas, or every Google Cloud behavior.
        </p>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4 reveal">
        <article class="site-panel site-panel--soft p-5">
          <div class="font-semibold text-[var(--text)]">Local request path</div>
          <p class="mt-2 text-sm leading-7 text-[var(--text-2)]">Supported requests target localhost endpoints. Review the governing license before use and stop rather than falling back to real Google Cloud.</p>
        </article>
        <article class="site-panel site-panel--soft p-5">
          <div class="font-semibold text-[var(--text)]">Local feedback loop</div>
          <p class="mt-2 text-sm leading-7 text-[var(--text-2)]">Local behavior depends on host resources and is not a production performance benchmark.</p>
        </article>
        <article class="site-panel site-panel--soft p-5">
          <div class="font-semibold text-[var(--text)]">Offline use</div>
          <p class="mt-2 text-sm leading-7 text-[var(--text-2)]">After the image is downloaded, core local workflows can run offline. Telemetry and other configured features can still make outbound requests.</p>
        </article>
        <article class="site-panel site-panel--soft p-5">
          <div class="font-semibold text-[var(--text)]">Managed lifecycle</div>
          <p class="mt-2 text-sm leading-7 text-[var(--text-2)]">The CLI selects a Docker data volume, manages a runtime that listens only on localhost, and exports its endpoints. Organization use must comply with the proprietary license.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- SERVICES TABLE -->
  <section class="site-section">
    <div class="container">
      <div class="reveal">
        <h2>What Google Cloud services can run locally?</h2>
        <p class="mt-4 max-w-[44rem] text-lg leading-8 text-[var(--text-2)]">
          LocalCloud runs {availableServiceCount} local services in one managed container. Each service guide lists its workflows, whether it starts by default, and its limits.
        </p>
      </div>
      <div class="mt-8 overflow-x-auto reveal" tabindex="0" role="region" aria-label="Local ports and environment variables by service">
        <table class="w-full min-w-[40rem] text-left text-sm">
          <thead class="border-b border-[var(--line)]">
            <tr>
              <th scope="col" class="py-3 pr-4 font-semibold text-[var(--text)]">Service</th>
              <th scope="col" class="py-3 pr-4 font-semibold text-[var(--text)]">Port</th>
              <th scope="col" class="py-3 pr-4 font-semibold text-[var(--text)]">Local support</th>
              <th scope="col" class="py-3 font-semibold text-[var(--text)]">Environment variable</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--line)]">
            {services.map(svc => (
              <tr>
                <td class="py-3 pr-4 text-[var(--text)]">{svc.name}</td>
                <td class="py-3 pr-4 text-[var(--text-2)] font-mono text-xs">{svc.port}</td>
                <td class="py-3 pr-4 text-[var(--text)]">{svc.availability}</td>
                <td class="py-3 text-[var(--text-2)] font-mono text-xs">{svc.env}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="mt-6 reveal">
        <p class="text-sm text-[var(--text-2)] leading-7">
          Browse <a href={`${base}services/`} class="underline">all {publishedServiceCount} service guides</a>. Firestore is opt-in; Google Sheets is a read-only values API for exact A1 ranges.
        </p>
      </div>
    </div>
  </section>

  <!-- STEP-BY-STEP SETUP -->
  <section class="site-section site-section--tight" id="quick-start">
    <div class="container">
      <div class="reveal">
        <h2>Step-by-step setup guide</h2>
      </div>
      <div class="mt-8 grid gap-6 reveal">
        <article class="site-panel p-6">
          <div class="flex items-start gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[var(--accent-soft)] font-semibold text-[var(--accent-strong)]">1</div>
            <div class="min-w-0 flex-1">
              <h3 class="text-lg font-semibold text-[var(--text)]">Install Docker</h3>
              <p class="mt-2 text-[var(--text-2)] leading-7">Install Docker Desktop (Mac/Windows) or Docker Engine (Linux). LocalCloud requires Docker to run the emulator container.</p>
              <div class="mt-3">
                <a href="https://docs.docker.com/get-docker/" target="_blank" rel="noopener" class="text-sm text-[var(--accent-strong)] underline">Install Docker →</a>
              </div>
            </div>
          </div>
        </article>

        <article class="site-panel p-6">
          <div class="flex items-start gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[var(--accent-soft)] font-semibold text-[var(--accent-strong)]">2</div>
            <div class="min-w-0 flex-1">
              <h3 class="text-lg font-semibold text-[var(--text)]">Install the CLI</h3>
              <p class="mt-2 text-[var(--text-2)] leading-7">Use the checksum-verifying installer on a supported macOS or Linux host:</p>
              <pre class="mt-3 overflow-x-auto rounded-xl border-0 bg-[var(--surface-2)] p-3 text-xs"><code>{docsContract.cli.installCommand}</code></pre>
            </div>
          </div>
        </article>

        <article class="site-panel p-6">
          <div class="flex items-start gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[var(--accent-soft)] font-semibold text-[var(--accent-strong)]">3</div>
            <div class="min-w-0 flex-1">
              <h3 class="text-lg font-semibold text-[var(--text)]">Diagnose and start</h3>
              <p class="mt-2 text-[var(--text-2)] leading-7">The CLI keeps Docker under your control and starts a persistent runtime that listens only on localhost, then the readiness check confirms it is up:</p>
              <pre class="mt-3 overflow-x-auto rounded-xl border-0 bg-[var(--surface-2)] p-3 text-xs"><code>{startCommands}</code></pre>
              <p class="mt-3 text-sm text-[var(--text-2)] leading-7">Use the URL and endpoint map in the output. If a default port is already in use, the CLI picks another one; use the endpoint values it returns.</p>
            </div>
          </div>
        </article>

        <article class="site-panel p-6">
          <div class="flex items-start gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[var(--accent-soft)] font-semibold text-[var(--accent-strong)]">4</div>
            <div class="min-w-0 flex-1">
              <h3 class="text-lg font-semibold text-[var(--text)]">Configure and inspect</h3>
              <p class="mt-2 text-[var(--text-2)] leading-7">Export the local endpoints into the shell that starts your application, then open the console:</p>
              <pre class="mt-3 overflow-x-auto rounded-xl border-0 bg-[var(--surface-2)] p-3 text-xs"><code>eval "$(localcloud env)"
localcloud console
localcloud status</code></pre>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- SERVICE-SPECIFIC GUIDES -->
  <section class="site-section">
    <div class="container">
      <div class="reveal">
        <h2>Service-specific setup guides</h2>
        <p class="mt-4 max-w-[44rem] text-lg leading-8 text-[var(--text-2)]">
          Each GCP service has unique configuration and SDK patterns. Follow these guides for service-specific setup instructions.
        </p>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-3 reveal">
        <a href={`${base}bigquery-emulator/`} class="site-panel site-panel--soft p-5 hover:border-[var(--accent-strong)] transition-colors">
          <div class="font-semibold text-[var(--text)]">BigQuery</div>
          <p class="mt-2 text-sm leading-7 text-[var(--text-2)]">Develop documented DuckDB-backed dataset, table, query, scripting, and API workflows.</p>
        </a>
        <a href={`${base}cloud-storage-emulator/`} class="site-panel site-panel--soft p-5 hover:border-[var(--accent-strong)] transition-colors">
          <div class="font-semibold text-[var(--text)]">Cloud Storage</div>
          <p class="mt-2 text-sm leading-7 text-[var(--text-2)]">Run bucket and object workflows backed by the LocalCloud volume.</p>
        </a>
        <a href={`${base}firestore-emulator/`} class="site-panel site-panel--soft p-5 hover:border-[var(--accent-strong)] transition-colors">
          <div class="font-semibold text-[var(--text)]">Firestore</div>
          <p class="mt-2 text-sm leading-7 text-[var(--text-2)]">Firestore runs documented local document and query workflows and is opt-in. Validate transactions, listeners, security rules, and recovery with the exact image you run.</p>
        </a>
        <a href={`${base}pubsub-emulator/`} class="site-panel site-panel--soft p-5 hover:border-[var(--accent-strong)] transition-colors">
          <div class="font-semibold text-[var(--text)]">Pub/Sub</div>
          <p class="mt-2 text-sm leading-7 text-[var(--text-2)]">Use documented topic, subscription, publish, pull, and acknowledgement workflows; state is stored in PostgreSQL under the mounted data volume.</p>
        </a>
        <a href={`${base}spanner-emulator/`} class="site-panel site-panel--soft p-5 hover:border-[var(--accent-strong)] transition-colors">
          <div class="font-semibold text-[var(--text)]">Spanner</div>
          <p class="mt-2 text-sm leading-7 text-[var(--text-2)]">Use {spannerWorkflowCount} documented Spanner data and administration workflows over gRPC and REST.</p>
        </a>
        <a href={`${base}bigtable-emulator/`} class="site-panel site-panel--soft p-5 hover:border-[var(--accent-strong)] transition-colors">
          <div class="font-semibold text-[var(--text)]">Bigtable</div>
          <p class="mt-2 text-sm leading-7 text-[var(--text-2)]">Use documented Bigtable data, administration, persistence, and query workflows.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- PERSONAL AUTOMATION -->
  <section class="site-section site-section--tight">
    <div class="container">
      <div class="reveal">
        <h2>Automating an internal development project</h2>
        <p class="mt-4 max-w-[44rem] text-lg leading-8 text-[var(--text-2)]">
          The Public Preview License permits individuals and organizations, including for-profit companies, to use containerized automation for ongoing internal development, testing, and CI.
        </p>
      </div>
      <div class="mt-8 site-panel p-6 reveal">
        <h3 class="text-lg font-semibold text-[var(--text)]">Keep automation inside the preview boundary</h3>
        <p class="mt-4 text-sm leading-7 text-[var(--text-2)]">For permitted internal automation, pin the image, wait on <code>/readiness</code>, export values from the running LocalCloud runtime, and stop rather than falling back to real Google Cloud. Customer-facing production use remains outside the preview grant.</p>
      </div>
      <div class="mt-6 reveal">
        <p class="text-sm text-[var(--text-2)] leading-7">
          See the <a href={`${base}gcp-integration-testing/`} class="underline">automation eligibility and integration guide</a> before using a hosted runner.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="site-section">
    <div class="container container--narrow">
      <div class="reveal">
        <h2>Frequently asked questions</h2>
      </div>
      <div class="mt-6 grid gap-3 reveal">
        {faqItems.map(item => (
          <details class="site-panel p-5 cursor-pointer">
            <summary class="font-semibold text-[var(--text)] text-lg">{item.q}</summary>
            <p class="mt-3 text-[var(--text-2)] leading-7">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- BOTTOM CTA -->
  <section class="site-section">
    <div class="container">
      <div class="site-panel grid items-center gap-6 p-8 xl:grid-cols-[1fr_auto] reveal">
        <div>
          <h2>Start running GCP services locally</h2>
          <p class="mt-3 max-w-[42rem] text-lg leading-8 text-[var(--text-2)]">
            One persistent runtime, {availableServiceCount} local services, and documented limits for each.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={`${base}services/`} class="site-button site-button--primary">Browse services</a>
          <a href={`${base}docs/`} class="site-button site-button--secondary">Read the docs</a>
        </div>
      </div>
    </div>
  </section>
</LandingLayout>
