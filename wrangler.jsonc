{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "localcloud-site",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-03",
  "workers_dev": true,
  "vars": { "POSTHOG_PROJECT_KEY": "phc_o9nQDAQjEgsPcamE8pCnhv7ekA8CmA2VQXechLju9LA9" },
  "routes": [
    { "pattern": "local.cloud", "custom_domain": true },
    { "pattern": "www.local.cloud", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/_astro/*", "!/pagefind/*", "!/icons/*", "!/illustrations/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
