# Cloudflare Workers static asset responses. HTML keeps the platform's revalidation policy.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: frame-ancestors 'none'

# Only content-addressed assets can safely be immutable across deployments.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# These paths are mutable; keep their cache lifetime bounded.
/brand/*
  Cache-Control: public, max-age=604800
/icons/*
  Cache-Control: public, max-age=604800
/illustrations/*
  Cache-Control: public, max-age=604800
