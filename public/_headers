# Revalidate mutable files. The Worker adds no-transform to HTML only, so Cloudflare
# can compress every other text file while CSP-protected HTML stays byte-exact.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: frame-ancestors 'none'
  Cache-Control: public, max-age=0, must-revalidate

# Only content-addressed assets can safely be immutable across deployments.
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/_astro/*.js
  X-Robots-Tag: noindex
/_astro/*.mjs
  X-Robots-Tag: noindex
/_astro/*.css
  X-Robots-Tag: noindex
/_astro/*.json
  X-Robots-Tag: noindex

/_desktop/*
  X-Robots-Tag: noindex

# These paths are mutable; keep their cache lifetime bounded.
# /brand/icons/ is an HTML page, so only image files get the longer lifetime.
/brand/*.svg
  ! Cache-Control
  Cache-Control: public, max-age=604800
/brand/*.png
  ! Cache-Control
  Cache-Control: public, max-age=604800
/icons/*
  ! Cache-Control
  Cache-Control: public, max-age=604800
/illustrations/*
  ! Cache-Control
  Cache-Control: public, max-age=604800

# Static builds drop endpoint headers; declare UTF-8 for text and Markdown assets.
/*.txt
  Content-Type: text/plain; charset=utf-8
/*.md
  Content-Type: text/markdown; charset=utf-8

# The template downloads under its conventional name.
/ai/agent-template.md
  Content-Disposition: attachment; filename="AGENTS.md"
