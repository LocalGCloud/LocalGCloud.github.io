# Preserve revalidation and prevent duplicate edge injection of the manually loaded beacon.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: frame-ancestors 'none'
  Cache-Control: public, max-age=0, must-revalidate, no-transform

# Only content-addressed assets can safely be immutable across deployments.
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# These paths are mutable; keep their cache lifetime bounded.
/brand/*
  ! Cache-Control
  Cache-Control: public, max-age=604800
/icons/*
  ! Cache-Control
  Cache-Control: public, max-age=604800
/illustrations/*
  ! Cache-Control
  Cache-Control: public, max-age=604800
