# Cloudflare uses /ingest; static uses direct PostHog US unless overridden.
SITE_DEPLOYMENT_TARGET=cloudflare
# Optional: HTTPS proxy URL or a path provided by your server, e.g. /ingest.
# PUBLIC_POSTHOG_HOST=https://e.local.cloud

# Public Web Analytics site identifier. Cloudflare defaults to the local.cloud
# token; static builds disable this beacon unless a token is supplied.
# Set an empty value to disable it, or replace it for another site.
# PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
