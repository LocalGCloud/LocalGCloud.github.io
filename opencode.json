{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "agentation": {
      "command": [
        "npx",
        "-y",
        "agentation-mcp",
        "server"
      ],
      "enabled": true,
      "environment": {},
      "type": "local"
    },
    "gortex": {
      "command": [
        "gortex",
        "mcp"
      ],
      "enabled": true,
      "environment": {
        "GORTEX_INDEX_WORKERS": "8"
      },
      "type": "local"
    },
    "trail": {
      "type": "local",
      "command": [
        "trail",
        "mcp"
      ],
      "enabled": true
    }
  }
}
