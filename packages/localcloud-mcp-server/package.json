{
  "name": "@localcloud/localcloud-mcp-server",
  "version": "0.1.0",
  "description": "MCP stdio server for safely running and inspecting LocalCloud, the local Google Cloud emulator.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://local.cloud/",
  "repository": {
    "type": "git",
    "url": "https://github.com/LocalGCloud/LocalGCloud.github.io.git",
    "directory": "packages/localcloud-mcp-server"
  },
  "bugs": {
    "url": "https://github.com/LocalGCloud/LocalGCloud.github.io/issues"
  },
  "bin": {
    "localcloud-mcp-server": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "assets/",
    "docker-catalog/",
    "docs/",
    "mcpb/",
    "README.md",
    "SECURITY.md",
    "PRIVACY.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "server.json",
    "server-card.json",
    "smithery.yaml"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "localcloud",
    "google-cloud",
    "gcp",
    "emulator",
    "docker",
    "agentic-ci"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "mcpName": "io.localcloud/server",
  "mcp": {
    "server": "server.json",
    "transport": "stdio"
  }
}
