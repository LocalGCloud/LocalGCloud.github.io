{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-07-09/server.schema.json",
  "name": "io.localcloud/server",
  "description": "Stdio MCP server for safely running and inspecting LocalCloud, the local Google Cloud emulator.",
  "status": "draft",
  "repository": {
    "url": "https://github.com/LocalGCloud/LocalGCloud.github.io",
    "source": "github",
    "directory": "packages/localcloud-mcp-server"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@localcloud/localcloud-mcp-server",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx -y @localcloud/localcloud-mcp-server"
    }
  ],
  "remotes": [],
  "license": "Apache-2.0",
  "icon": "https://local.cloud/brand/localcloud-mark.svg",
  "homepage": "https://local.cloud/",
  "documentation": "https://local.cloud/docs/",
  "privacyPolicy": "https://github.com/LocalGCloud/LocalGCloud.github.io/tree/main/packages/localcloud-mcp-server/PRIVACY.md",
  "securityPolicy": "https://github.com/LocalGCloud/LocalGCloud.github.io/tree/main/packages/localcloud-mcp-server/SECURITY.md",
  "tools": [
    "localcloud-runtime",
    "localcloud-services",
    "localcloud-diagnostics",
    "localcloud-logs",
    "localcloud-state",
    "localcloud-docs",
    "localcloud-gcp-client"
  ],
  "prompts": [
    "gcp-sandbox-tester",
    "write-localcloud-integration-test",
    "terraform-local-gcp-validation",
    "debug-localcloud-sdk-routing"
  ],
  "metadata": {
    "categories": ["developer-tools", "testing", "cloud", "docker"],
    "noDefaultGcpCredentialsRequired": true,
    "stdoutPolicy": "MCP protocol messages only; logs to stderr."
  }
}
